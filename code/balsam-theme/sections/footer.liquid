<footer class="site-footer" role="contentinfo">
  <div class="footer__main container">
    <div class="footer__brand">
      {%- if settings.footer_logo -%}
        <img
          src="{{ settings.footer_logo | image_url: width: 200 }}"
          alt="{{ settings.footer_logo.alt | default: shop.name }}"
          width="120"
          height="auto"
          loading="lazy"
        >
      {%- elsif settings.logo -%}
        <img
          src="{{ settings.logo | image_url: width: 200 }}"
          alt="{{ settings.logo.alt | default: shop.name }}"
          width="120"
          height="auto"
          loading="lazy"
        >
      {%- else -%}
        <span class="footer__brand-name">{{ shop.name }}</span>
      {%- endif -%}

      {%- if settings.footer_tagline != blank -%}
        <div class="footer__tagline">{{ settings.footer_tagline }}</div>
      {%- endif -%}

      <div class="footer__social">
        {%- if settings.footer_instagram_url != blank -%}
          <a href="{{ settings.footer_instagram_url }}" class="footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if settings.footer_facebook_url != blank -%}
          <a href="{{ settings.footer_facebook_url }}" class="footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if settings.footer_tiktok_url != blank -%}
          <a href="{{ settings.footer_tiktok_url }}" class="footer__social-link" aria-label="TikTok" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <nav class="footer__nav" aria-label="Footer navigation">
      {%- if linklists[settings.footer_menu].links.size > 0 -%}
        <div class="footer__nav-group">
          <h3 class="footer__nav-heading">{{ linklists[settings.footer_menu].title }}</h3>
          <ul class="footer__nav-list" role="list">
            {%- for link in linklists[settings.footer_menu].links -%}
              <li><a href="{{ link.url }}" class="footer__nav-link">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </nav>
  </div>

  <div class="footer__bottom container">
    <p class="footer__copyright">
      {{ 'footer.copyright' | t: year: 'now' | date: '%Y', shop: shop.name }}
    </p>

    {%- if linklists[settings.footer_legal_menu].links.size > 0 -%}
      <ul class="footer__legal-list" role="list">
        {%- for link in linklists[settings.footer_legal_menu].links -%}
          <li><a href="{{ link.url }}" class="footer__legal-link">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "limit": 1,
  "settings": [],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}

<style>
  .site-footer {
    background-color: var(--fg);
    color: var(--surface);
    margin-top: auto;
  }

  .footer__main {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-12);
    padding-block: var(--space-12);
  }

  .footer__brand-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
  }

  .footer__tagline {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
    line-height: var(--leading-body);
  }

  .footer__social {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-sm);
    transition: color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard);
  }

  .footer__social-link:hover {
    color: var(--surface);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .footer__nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .footer__nav-heading {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: var(--space-4);
  }

  .footer__nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__nav-link {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .footer__nav-link:hover {
    color: var(--surface);
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer__copyright {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.45);
  }

  .footer__legal-list {
    display: flex;
    gap: var(--space-6);
    list-style: none;
  }

  .footer__legal-link {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.45);
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .footer__legal-link:hover {
    color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 767px) {
    .footer__main {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      padding-block: var(--space-8);
    }

    .footer__nav {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }

    .footer__bottom {
      flex-direction: column;
      gap: var(--space-4);
      text-align: center;
    }

    .footer__legal-list {
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-4);
    }
  }
</style>
