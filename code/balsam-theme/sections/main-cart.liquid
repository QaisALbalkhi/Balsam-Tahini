{%- comment -%}
  Anyone who lands directly on this page (an old bookmark, an
  externally-shared link, a search result) gets bounced to the
  homepage with the cart drawer opened instead — the drawer is the
  theme's actual cart UI now; this full page is only kept as a
  no-JS fallback so /cart still works if JS fails to load.
{%- endcomment -%}
<script>
  sessionStorage.setItem('balsam_open_cart_on_load', '1');
  window.location.replace('{{ routes.root_url }}');
</script>

<section class="main-cart section">
  <div class="container">
    <h1 class="section-title">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      {%- form 'cart', cart, id: 'cart-form' -%}
        <div class="cart-layout">

          <!-- Line items -->
          <div class="cart-items">
            {%- for item in cart.items -%}
              <div class="cart-item" data-line="{{ forloop.index }}">
                <a href="{{ item.url }}" class="cart-item__image-link">
                  {%- if item.image -%}
                    <img
                      src="{{ item.image | image_url: width: 160 }}"
                      alt="{{ item.image.alt | default: item.title | escape }}"
                      width="80"
                      height="80"
                      loading="lazy"
                      class="cart-item__image"
                    >
                  {%- else -%}
                    <div class="cart-item__image-placeholder"></div>
                  {%- endif -%}
                </a>

                <div class="cart-item__details">
                  <a href="{{ item.url }}" class="cart-item__name">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="cart-item__variant">{{ item.variant.title }}</p>
                  {%- endunless -%}
                  {%- if item.selling_plan_allocation -%}
                    <p class="cart-item__plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                  {%- endif -%}
                </div>

                <div class="cart-item__qty">
                  {%- render 'quantity-stepper',
                    quantity: item.quantity,
                    name: 'updates[]',
                    id: 'updates_' | append: item.key
                  -%}
                </div>

                <div class="cart-item__price">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <s class="cart-item__compare">{{ item.original_line_price | money }}</s>
                  {%- endif -%}
                  <span class="cart-item__total">{{ item.final_line_price | money }}</span>
                </div>

                <a
                  href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                  class="cart-item__remove"
                  aria-label="{{ 'cart.remove' | t }}"
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </a>
              </div>
            {%- endfor -%}
          </div>

          <!-- Order summary -->
          <div class="cart-summary">
            <h2 class="cart-summary__heading subheading">Order Summary</h2>

            <div class="cart-summary__rows">
              <div class="cart-summary__row">
                <span>Subtotal</span>
                <span>{{ cart.total_price | money }}</span>
              </div>

              {%- if cart.total_discounts > 0 -%}
                <div class="cart-summary__row cart-summary__row--discount">
                  <span>Discounts</span>
                  <span>-{{ cart.total_discounts | money }}</span>
                </div>
              {%- endif -%}

              <div class="cart-summary__row cart-summary__row--muted">
                <span>Shipping</span>
                <span>{{ 'cart.taxes_note' | t }}</span>
              </div>
            </div>

            <hr class="divider">

            <div class="cart-summary__total">
              <span class="cart-summary__total-label">Total</span>
              <span class="cart-summary__total-amount">{{ cart.total_price | money }}</span>
            </div>

            <p class="cart-summary__note">{{ 'cart.taxes_note' | t }}</p>

            <button type="submit" name="checkout" class="btn btn-primary btn--full cart-summary__checkout">
              {{ 'cart.checkout' | t }}
            </button>

            <a href="{{ routes.all_products_collection_url }}" class="cart-summary__continue">
              ← {{ 'cart.continue_shopping' | t }}
            </a>
          </div>

        </div>
      {%- endform -%}
    {%- else -%}
      <div class="cart-empty">
        <p class="cart-empty__text">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">
          {{ 'cart.continue_shopping' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [],
  "presets": [
    {
      "name": "Cart"
    }
  ]
}
{% endschema %}

<style>
  .main-cart .section-title {
    margin-bottom: var(--space-8);
  }

  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--space-12);
    align-items: start;
  }

  /* Line items */
  .cart-item {
    display: grid;
    grid-template-columns: 80px 1fr auto auto auto;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .cart-item__image {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .cart-item__image-placeholder {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-sm);
    background-color: var(--border-soft);
  }

  .cart-item__name {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--fg);
  }

  .cart-item__name:hover {
    color: var(--accent);
  }

  .cart-item__variant,
  .cart-item__plan {
    font-size: var(--text-xs);
    color: var(--muted);
    margin-top: var(--space-1);
  }

  .cart-item__compare {
    display: block;
    font-size: var(--text-xs);
    color: var(--muted);
    text-decoration: line-through;
  }

  .cart-item__total {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--fg);
  }

  .cart-item__remove {
    color: var(--muted);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    transition: color var(--motion-fast) var(--ease-standard), background-color var(--motion-fast) var(--ease-standard);
  }

  .cart-item__remove:hover {
    color: var(--danger);
    background-color: var(--border-soft);
  }

  /* Summary */
  .cart-summary {
    background-color: var(--surface-warm);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: sticky;
    top: calc(72px + var(--space-4));
  }

  .cart-summary__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .cart-summary__row--discount {
    color: var(--success);
  }

  .cart-summary__row--muted {
    color: var(--muted);
    font-weight: 400;
    font-size: var(--text-xs);
  }

  .cart-summary__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .cart-summary__total-label {
    font-size: var(--text-base);
    font-weight: 700;
  }

  .cart-summary__total-amount {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .cart-summary__note {
    font-size: var(--text-xs);
    color: var(--muted);
    text-align: center;
  }

  .cart-summary__continue {
    display: block;
    text-align: center;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    margin-top: var(--space-2);
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .cart-summary__continue:hover {
    color: var(--accent-hover);
  }

  /* Empty */
  .cart-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-12);
    text-align: center;
  }

  .cart-empty__text {
    font-size: var(--text-lg);
    color: var(--muted);
  }

  @media (max-width: 767px) {
    .cart-layout {
      grid-template-columns: 1fr;
    }

    .cart-item {
      grid-template-columns: 64px 1fr auto;
      grid-template-rows: auto auto;
    }

    .cart-item__details {
      grid-column: 2 / -1;
    }

    .cart-item__qty {
      grid-column: 2;
    }

    .cart-item__price {
      grid-column: 3;
    }

    .cart-item__remove {
      grid-column: 1;
      grid-row: 2;
    }
  }
</style>
