{%- comment -%}
  /collections/all is Shopify's built-in route, not a real collection record,
  so there is no admin setting for its default sort -- it always comes back
  alphabetical. Send visitors who arrive without an explicit sort to the
  best-selling order instead. location.replace keeps this out of the history
  stack, so Back still leaves the page rather than bouncing through it.
{%- endcomment -%}
{%- if collection.handle == 'all' -%}
  <script>
    (function () {
      try {
        var u = new URL(window.location.href);
        if (!u.searchParams.has('sort_by')) {
          u.searchParams.set('sort_by', 'best-selling');
          window.location.replace(u.toString());
        }
      } catch (e) {}
    })();
  </script>
{%- endif -%}

<section class="main-collection section">
  <div class="container">

    <div class="collection-header">
      <div class="collection-header__bar">
        <h1 class="collection-header__title">{{ collection.title }}</h1>
        <div class="collection-header__actions">
          {%- if section.settings.show_filters -%}
            <button class="filter-toggle-btn" id="filter-toggle-btn" type="button" aria-expanded="false" aria-controls="cfs" aria-label="Filter">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M3 6h18M7 12h10M11 18h2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <span class="filter-toggle-btn__label">Filter</span>
              <span class="filter-toggle-btn__badge" id="filter-active-count" hidden>0</span>
            </button>
          {%- endif -%}
          <div class="sort-control">
            <svg class="sort-control__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 6h12M3 12h8M3 18h4M17 4v16m0 0l-3-3m3 3l3-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <label for="sort-by" class="visually-hidden">Sort by</label>
            <select id="sort-by" name="sort_by" class="sort-select">
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </div>
        </div>
      </div>

      {%- if collection.description != blank -%}
        <p class="collection-header__desc">{{ collection.description }}</p>
      {%- endif -%}

      <p class="collection-toolbar__count" id="products-count">
        {{ 'collections.products_count' | t: count: collection.products_count }}
      </p>

      <div class="coll-search">
        <svg class="coll-search__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
          <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input class="coll-search__input" id="coll-search-input" type="search"
          placeholder="Search {{ collection.title | downcase }}…" autocomplete="off" spellcheck="false">
        <button class="coll-search__clear" id="coll-search-clear" type="button" aria-label="Clear" hidden>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- ── Body: sidebar + grid ── -->
    <div class="collection-body" id="collection-body">

      {%- if section.settings.show_filters -%}
        <!-- Filter sidebar -->
        <aside class="cfs" id="cfs" aria-label="Filters" hidden>
          <div class="cfs__inner">

            <div class="cfs__logo">
              <img src="{{ 'balsam-logo.png' | asset_url }}" alt="{{ shop.name }}" width="180" height="90" loading="lazy">
            </div>

            <div class="cfs__hdr">
              <span class="cfs__title">Filters</span>
              <button class="cfs__clear" id="clear-all-filters" type="button">Clear all</button>
            </div>

            <form id="collection-filter-form" action="/collections/all" method="get">

              <!-- Collections group -->
              <div class="cfs-group">
                <button class="cfs-group__toggle" type="button" aria-expanded="true" data-filter-toggle>
                  <span>Collections</span>
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <div class="cfs-group__body" data-filter-body>
                  {%- assign main_collections = 'all,tahini,pistachio-spreads,halawas,pure-butters,honey,oils' | split: ',' -%}
                  {%- assign coll_labels = 'All Products,Tahini,Pistachio Spreads,Halawas,Pure Butters,Honey,Oils' | split: ',' -%}
                  <ul class="cfs-check-list" role="list">
                    {%- for coll_handle in main_collections -%}
                      {%- assign cl = coll_labels[forloop.index0] -%}
                      {%- assign is_active = false -%}
                      {%- if coll_handle == 'all' and collection.handle == 'all' -%}{%- assign is_active = true -%}
                      {%- elsif coll_handle == collection.handle -%}{%- assign is_active = true -%}
                      {%- endif -%}
                      <li>
                        <label class="cfs-checkbox">
                          {%- if coll_handle == 'all' -%}
                            <input type="checkbox" class="cfs-checkbox__input visually-hidden"
                              {% if is_active %}checked{% endif %}
                              data-coll-all>
                          {%- else -%}
                            <input type="checkbox" class="cfs-checkbox__input visually-hidden"
                              {% if is_active %}checked{% endif %}
                              data-filter-input
                              name="filter.p.collection"
                              value="{{ coll_handle }}">
                          {%- endif -%}
                          <span class="cfs-cb"></span>
                          <span class="cfs-checkbox__label">{{ cl }}</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>

              <!-- Dynamic filter groups -->
              {%- for filter in collection.filters -%}
                {%- assign filter_key = filter.label | downcase -%}
                {%- if filter.type == 'list' and filter_key != 'size' -%}
                  <div class="cfs-group">
                    <button class="cfs-group__toggle" type="button" aria-expanded="true" data-filter-toggle>
                      <span>{{ filter.label }}</span>
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <div class="cfs-group__body" data-filter-body>
                      <ul class="cfs-check-list" role="list">
                        {%- for fv in filter.values -%}
                          <li>
                            <label class="cfs-checkbox">
                              <input type="checkbox" class="cfs-checkbox__input visually-hidden"
                                name="{{ fv.param_name }}" value="{{ fv.value }}"
                                {% if fv.active %}checked{% endif %} data-filter-input>
                              <span class="cfs-cb"></span>
                              <span class="cfs-checkbox__label">
                                {{ fv.label }}
                                <span class="cfs-checkbox__count">({{ fv.count }})</span>
                              </span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>

                {%- endif -%}
              {%- endfor -%}

              <!-- Size group: toggle chips, filled in by the script below -->
              <div class="cfs-group" id="size-filter" hidden>
                <button class="cfs-group__toggle" type="button" aria-expanded="true" data-filter-toggle>
                  <span>Size</span>
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <div class="cfs-group__body" data-filter-body>
                  <div class="cfs-chip-list" id="size-chip-list" role="group" aria-label="Size"></div>
                </div>
              </div>

            </form>
          </div><!-- /.cfs__inner -->
        </aside>
      {%- endif -%}

      <!-- Products area -->
      <div class="collection-products-area">
        <div id="collection-grid-wrap" class="collection-grid-wrap">
          {%- if collection.products.size > 0 -%}
            {%- comment -%} The pager has to sit inside the paginate block: `paginate` does not exist after endpaginate. {%- endcomment -%}
            {%- paginate collection.products by settings.collection_products_per_page -%}
              <div class="product-grid" id="product-grid">
                {%- for product in collection.products -%}
                  {% render 'product-card', product: product %}
                {%- endfor -%}
              </div>
              <p class="coll-no-results" id="coll-no-results" hidden>No products match your search.</p>
              {%- if paginate.pages > 1 -%}
                <nav class="pagination" aria-label="Pagination">
                  {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="pagination__btn btn btn-ghost btn--sm">← Previous</a>{%- endif -%}
                  <span class="pagination__info">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
                  {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="pagination__btn btn btn-ghost btn--sm">Next →</a>{%- endif -%}
                </nav>
              {%- endif -%}
            {%- endpaginate -%}
          {%- else -%}
            <p class="collection-empty">No products found.</p>
          {%- endif -%}
        </div>
      </div>

    </div><!-- /.collection-body -->
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "checkbox", "id": "show_filters", "default": true, "label": "Show filters" }
  ],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}

<style>
  /* ── Header ── */
  .collection-header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .collection-header__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--fg);
  }
  .collection-header__desc {
    margin-top: var(--space-2);
    font-size: var(--text-base);
    color: var(--muted);
    max-width: 600px;
  }

  /* ── Toolbar ── */
  .collection-header__bar {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-3); flex-wrap: wrap;
  }
  .collection-header__actions { display: flex; align-items: center; gap: var(--space-2); flex-shrink: 0; }
  .collection-toolbar__count { font-size: var(--text-sm); color: var(--muted); margin-top: var(--space-2); }
  .sort-control { position: relative; }
  .sort-control__icon { display: none; }

  /* Filter toggle button */
  .filter-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    background: none;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--fg);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    user-select: none;
  }
  .filter-toggle-btn:hover { border-color: var(--accent); color: var(--accent); background: rgba(27,67,50,0.04); }
  .filter-toggle-btn[aria-expanded="true"] { border-color: var(--accent); color: var(--accent); background: rgba(27,67,50,0.06); }
  .filter-toggle-btn__badge {
    min-width: 18px; height: 18px; padding: 0 5px;
    background: var(--accent); color: #fff;
    border-radius: var(--radius-pill);
    font-size: 0.65rem; font-weight: 700;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .filter-toggle-btn__badge[hidden] { display: none; }

  /* Search bar */
  .coll-search {
    display: flex; align-items: center; gap: 8px; width: 100%; max-width: 420px;
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 7px 12px; margin-top: var(--space-3);
    transition: border-color 0.15s;
  }
  .coll-search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(27,67,50,0.08); }
  .coll-search__icon { flex-shrink: 0; color: var(--muted); }
  .coll-search__input {
    flex: 1; border: none; outline: none; background: transparent;
    font-family: var(--font-body); font-size: var(--text-sm); color: var(--fg); min-width: 0;
  }
  .coll-search__input::placeholder { color: var(--muted); }
  .coll-search__input::-webkit-search-cancel-button { display: none; }
  .coll-search__clear {
    flex-shrink: 0; background: none; border: none; cursor: pointer;
    color: var(--muted); padding: 2px; border-radius: 50%;
    display: flex; align-items: center; transition: color 0.15s, background 0.15s;
  }
  .coll-search__clear:hover { color: var(--fg); background: var(--border-soft); }
  .coll-search__clear[hidden] { display: none; }

  /* Sort */
  .sort-select {
    font-size: var(--text-sm); font-weight: 600; color: var(--fg);
    background: var(--surface); border: 1.5px solid var(--border);
    border-radius: var(--radius-sm); padding: 8px 14px; cursor: pointer;
    transition: border-color 0.15s;
  }
  .sort-select:hover { border-color: var(--accent); }

  /* ── Body layout ── */
  .collection-body {
    display: flex;
    gap: 0;
    align-items: start;
  }

  /* ── Filter sidebar ── */
  .cfs {
    flex-shrink: 0;
    width: 0;
    overflow: hidden;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                margin-right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    margin-right: 0;
  }
  .cfs.is-open {
    width: 258px;
    margin-right: 36px;
  }
  .cfs__inner {
    width: 258px; /* fixed — stays at full width during animation */
    padding-right: var(--space-2);
  }

  .cfs__logo {
    display: flex;
    justify-content: center;
    padding: var(--space-4) 0 var(--space-3);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-soft);
  }
  .cfs__logo img { max-width: 100%; height: auto; }

  .cfs__hdr {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }
  .cfs__title {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .cfs__clear {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }
  .cfs__clear:hover { color: var(--accent); }

  /* Filter groups */
  .cfs-group { border-top: 1px solid var(--border); }
  .cfs-group__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-4) 0;
    background: none;
    border: none;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--fg);
    cursor: pointer;
    text-align: left;
    user-select: none;
  }
  .cfs-group__toggle svg { flex-shrink: 0; transition: transform 0.2s; color: var(--muted); }
  .cfs-group__toggle[aria-expanded="false"] svg { transform: rotate(-90deg); }
  .cfs-group__body { padding-bottom: var(--space-3); }
  .cfs-group__body[hidden] { display: none; }

  /* Shared checkbox box */
  .cfs-cb {
    flex-shrink: 0;
    width: 16px; height: 16px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center;
    transition: border-color 0.15s, background 0.15s;
    position: relative;
  }
  .cfs-cb.is-checked { background: var(--accent); border-color: var(--accent); }

  /* Checkboxes */
  .cfs-check-list { list-style: none; display: flex; flex-direction: column; gap: 1px; }
  .cfs-checkbox {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    font-size: var(--text-sm);
    padding: 5px 0;
  }
  .cfs-checkbox__input:checked ~ .cfs-cb {
    background: var(--accent);
    border-color: var(--accent);
  }
  .cfs-checkbox__input:checked ~ .cfs-cb::after {
    content: '';
    position: absolute;
    left: 3px; top: 1px;
    width: 5px; height: 9px;
    border: 2px solid #fff;
    border-top: none; border-left: none;
    transform: rotate(45deg);
  }
  .cfs-checkbox__label { color: var(--fg); line-height: 1.3; }
  .cfs-checkbox__count { color: var(--muted); font-size: var(--text-xs); margin-left: 2px; }

  /* Size chips */
  .cfs-chip-list { display: flex; flex-wrap: wrap; gap: var(--space-2); padding-top: 2px; }
  .cfs-chip {
    min-width: 52px;
    padding: 9px 14px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .cfs-chip:hover { border-color: var(--accent); }
  .cfs-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cfs-chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .product-card.is-size-hidden { display: none !important; }

  /* ── Products area ── */
  .collection-products-area { flex: 1; min-width: 0; }
  .collection-grid-wrap { transition: opacity 0.2s; }
  .collection-grid-wrap.is-loading { opacity: 0.4; pointer-events: none; }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    transition: grid-template-columns 0.3s ease;
  }
  /* 3-col when sidebar is open */
  .cfs.is-open ~ .collection-products-area .product-grid { grid-template-columns: repeat(3, 1fr); }

  .collection-empty, .coll-no-results {
    font-size: var(--text-base); color: var(--muted);
    padding-block: var(--space-12); text-align: center;
  }
  .coll-no-results[hidden] { display: none; }

  /* Pagination */
  .pagination {
    display: flex; align-items: center; justify-content: center;
    gap: var(--space-4); margin-top: var(--space-12);
  }
  .pagination__info { font-size: var(--text-sm); color: var(--muted); }

  /* ── Responsive ── */
  @media (max-width: 1023px) {
    .product-grid { grid-template-columns: repeat(3, 1fr) !important; }
    .cfs.is-open { width: 220px; margin-right: 24px; }
    .cfs__inner { width: 220px; }
  }
  @media (max-width: 767px) {
    .cfs.is-open { width: 100%; margin-right: 0; margin-bottom: var(--space-6); }
    .cfs__inner { width: 100%; }
    .collection-body { flex-direction: column; }
    .product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: var(--space-4); }
    .filter-toggle-btn { width: 44px; height: 44px; padding: 0; gap: 0; justify-content: center; position: relative; }
    .filter-toggle-btn__label { display: none; }
    .filter-toggle-btn__badge { position: absolute; top: -6px; right: -6px; }
    .sort-control { width: 44px; height: 44px; border: 1.5px solid var(--border);
      border-radius: var(--radius-sm); display: grid; place-items: center; }
    .sort-control__icon { display: block; color: var(--fg); pointer-events: none; }
    .sort-select { position: absolute; inset: 0; width: 100%; height: 100%;
      opacity: 0; border: none; background: transparent; padding: 0; cursor: pointer; }
    .coll-search { max-width: none; }
  }
  @media (max-width: 479px) {
    .product-grid { gap: var(--space-3); }
  }
</style>

<script>
(function () {
  var filterForm   = document.getElementById('collection-filter-form');
  var gridWrap     = document.getElementById('collection-grid-wrap');
  var sortSelect   = document.getElementById('sort-by');
  var clearBtn     = document.getElementById('clear-all-filters');
  var sizeGroup    = document.getElementById('size-filter');
  var sizeList     = document.getElementById('size-chip-list');
  var toggleBtn    = document.getElementById('filter-toggle-btn');
  var cfs          = document.getElementById('cfs');
  var activeBadge  = document.getElementById('filter-active-count');
  var searchInput  = document.getElementById('coll-search-input');
  var searchClear  = document.getElementById('coll-search-clear');
  var noResults    = document.getElementById('coll-no-results');
  var productGrid  = document.getElementById('product-grid');
  var filterDebounce, searchDebounce, loadSeq = 0;
  var selectedSizes = []; /* normalised size keys, e.g. '230g' */

  /* ── Sidebar open / close ── */
  function openSidebar() {
    if (!cfs) return;
    cfs.hidden = false;
    requestAnimationFrame(function () { cfs.classList.add('is-open'); });
    toggleBtn && toggleBtn.setAttribute('aria-expanded', 'true');
  }
  function closeSidebar() {
    if (!cfs) return;
    cfs.classList.remove('is-open');
    var onEnd = function () { cfs.hidden = true; cfs.removeEventListener('transitionend', onEnd); };
    cfs.addEventListener('transitionend', onEnd);
    toggleBtn && toggleBtn.setAttribute('aria-expanded', 'false');
  }
  function toggleSidebar() {
    if (cfs && cfs.classList.contains('is-open')) closeSidebar();
    else openSidebar();
  }

  if (toggleBtn) toggleBtn.addEventListener('click', toggleSidebar);

  /* ── Filter group collapse / expand ── */
  document.querySelectorAll('[data-filter-toggle]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      var body = btn.nextElementSibling;
      if (body) body.hidden = expanded;
    });
  });

  /* ── Badge ── */
  function updateBadge() {
    if (!filterForm || !activeBadge) return;
    var count = filterForm.querySelectorAll('[data-filter-input]:checked').length + selectedSizes.length;
    activeBadge.textContent = count;
    activeBadge.hidden = count === 0;
  }

  if (!filterForm || !gridWrap) return;

  /* ── Build params ── */
  function buildParams() {
    var params = new URLSearchParams();
    var sv = sortSelect ? sortSelect.value : '';
    if (sv) params.set('sort_by', sv);
    filterForm.querySelectorAll('[data-filter-input]:checked').forEach(function (cb) {
      params.append(cb.name, cb.value);
    });
    return params;
  }

  /* ── Size filter ──
     Shopify only filters on a product option once it is switched on in Search &
     Discovery, so sizes are handled here instead. The server still does the
     rest of the filtering; with a size picked, every page of that result is
     gathered into one grid and the cards without that size are hidden. */
  function sizeKey(t) { return String(t).toLowerCase().replace(/\s+/g, ''); }

  function withSizes(url) {
    if (!selectedSizes.length) return url;
    var u = new URL(url, window.location.origin);
    selectedSizes.forEach(function (k) { u.searchParams.append('size', k); });
    return u.pathname + u.search;
  }

  function fetchPageCards(url, page) {
    var u = new URL(url, window.location.origin);
    u.searchParams.set('page', page);
    return fetch(u.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function (r) { return r.text(); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        return { page: page, cards: Array.prototype.slice.call(doc.querySelectorAll('#product-grid .product-card')) };
      })
      .catch(function () { return { page: page, cards: [] }; });
  }

  function cardHasSize(card) {
    var el = card.querySelector('.pc-variants-json');
    if (!el) return false;
    try {
      return JSON.parse(el.textContent).some(function (v) {
        return selectedSizes.indexOf(sizeKey(v.title)) !== -1;
      });
    } catch (e) { return false; }
  }

  function applySizes(url) {
    var grid = document.getElementById('product-grid');
    if (!grid || !selectedSizes.length) return Promise.resolve();

    var info  = gridWrap.querySelector('.pagination__info');
    var pm    = info && /Page\s+(\d+)\s+of\s+(\d+)/.exec(info.textContent);
    var cur   = pm ? parseInt(pm[1], 10) : 1;
    var pages = pm ? parseInt(pm[2], 10) : 1;
    var here  = Array.prototype.slice.call(grid.querySelectorAll('.product-card'));
    var jobs  = [];
    for (var p = 1; p <= pages; p++) { if (p !== cur) jobs.push(fetchPageCards(url, p)); }

    return Promise.all(jobs).then(function (results) {
      var byPage = {};
      byPage[cur] = here;
      results.forEach(function (r) { byPage[r.page] = r.cards; });
      for (var i = 1; i <= pages; i++) {
        (byPage[i] || []).forEach(function (c) { grid.appendChild(c); });
      }

      var shown = 0;
      grid.querySelectorAll('.product-card').forEach(function (c) {
        var ok = cardHasSize(c);
        c.classList.toggle('is-size-hidden', !ok);
        if (ok) shown++;
      });

      var pager = gridWrap.querySelector('.pagination');
      if (pager) pager.style.display = 'none';
      var countEl = document.getElementById('products-count');
      if (countEl) countEl.textContent = countEl.textContent.replace(/\d+/, shown);
      if (shown === 0) {
        var empty = document.createElement('p');
        empty.className = 'coll-no-results';
        empty.textContent = 'No products come in the selected sizes.';
        grid.insertAdjacentElement('afterend', empty);
      }
    });
  }

  function sizeSortValue(k) {
    var m = /^(\d+(?:\.\d+)?)(kg|g|ml|l)$/.exec(k);
    if (!m) return 1e12;
    var n = parseFloat(m[1]);
    if (m[2] === 'g')  return n;
    if (m[2] === 'kg') return n * 1000;
    if (m[2] === 'ml') return 1e6 + n;
    return 1e6 + n * 1000;
  }

  function buildSizeChips() {
    if (!sizeGroup || !sizeList) return;
    fetch('/collections/all/products.json?limit=250')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var seen = {};
        (data.products || []).forEach(function (p) {
          (p.variants || []).forEach(function (v) {
            var k = sizeKey(v.option1 || v.title);
            if (k && k !== 'defaulttitle') seen[k] = true;
          });
        });
        var keys = Object.keys(seen).sort(function (a, b) {
          return (sizeSortValue(a) - sizeSortValue(b)) || (a < b ? -1 : 1);
        });
        if (!keys.length) return;
        keys.forEach(function (k) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'cfs-chip';
          b.dataset.size = k;
          b.textContent = k;
          b.setAttribute('aria-pressed', String(selectedSizes.indexOf(k) !== -1));
          sizeList.appendChild(b);
        });
        sizeGroup.hidden = false;
      })
      .catch(function () { /* no chips, the rest of the filters still work */ });
  }

  if (sizeList) {
    sizeList.addEventListener('click', function (e) {
      var btn = e.target.closest('.cfs-chip');
      if (!btn) return;
      var k = btn.dataset.size;
      var i = selectedSizes.indexOf(k);
      if (i === -1) selectedSizes.push(k); else selectedSizes.splice(i, 1);
      btn.setAttribute('aria-pressed', String(i === -1));
      applyFilters();
    });
  }

  /* ── AJAX load (shared by filters + collection nav) ── */
  function loadUrl(url, pushState) {
    var seq = ++loadSeq;
    gridWrap.classList.add('is-loading');
    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function (r) { return r.text(); })
      .then(function (html) {
        if (seq !== loadSeq) return;
        var doc      = new DOMParser().parseFromString(html, 'text/html');
        var newGrid  = doc.getElementById('collection-grid-wrap');
        var newCount = doc.getElementById('products-count');
        if (newGrid) gridWrap.innerHTML = newGrid.innerHTML;
        productGrid = document.getElementById('product-grid');
        var countEl = document.getElementById('products-count');
        if (newCount && countEl) countEl.textContent = newCount.textContent;
        if (pushState !== false) history.pushState({ url: url }, '', withSizes(url));
        return applySizes(url).then(function () {
          if (seq !== loadSeq) return;
          bindPaginationLinks();
          document.dispatchEvent(new CustomEvent('balsam:grid-updated'));
          updateBadge();
          if (searchInput && searchInput.value.trim()) filterBySearch(searchInput.value.trim());
        });
      })
      .catch(function () { window.location.href = url; })
      .finally(function () { if (seq === loadSeq) gridWrap.classList.remove('is-loading'); });
  }

  function applyFilters() {
    var params = buildParams();
    var url = filterForm.action + (params.toString() ? '?' + params.toString() : '');
    loadUrl(url);
  }

  function scheduleFilter() {
    clearTimeout(filterDebounce);
    filterDebounce = setTimeout(applyFilters, 300);
  }

  filterForm.querySelectorAll('[data-filter-input]').forEach(function (cb) {
    cb.addEventListener('change', applyFilters);
  });
  if (sortSelect) sortSelect.addEventListener('change', applyFilters);

  /* ── "All Products" checkbox — clears collection filters ── */
  var collAllCb = document.querySelector('[data-coll-all]');
  if (collAllCb) {
    collAllCb.addEventListener('change', function () {
      /* uncheck all filter.p.collection inputs and reload /collections/all */
      filterForm.querySelectorAll('[name="filter.p.collection"]').forEach(function (cb) { cb.checked = false; });
      collAllCb.checked = true;
      loadUrl('/collections/all');
    });
  }

  /* When any collection filter is checked, uncheck "All Products" */
  filterForm.querySelectorAll('[name="filter.p.collection"]').forEach(function (cb) {
    cb.addEventListener('change', function () {
      if (collAllCb) collAllCb.checked = false;
    });
  });

  /* ── Clear all ── */
  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      filterForm.querySelectorAll('[data-filter-input]:checked').forEach(function (cb) { cb.checked = false; });
      selectedSizes = [];
      if (sizeList) sizeList.querySelectorAll('.cfs-chip').forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
      /* restore "All Products" checkbox */
      if (collAllCb) collAllCb.checked = true;
      applyFilters();
    });
  }

  /* ── Client-side search ── */
  function filterBySearch(query) {
    if (!productGrid) return;
    var q = query.toLowerCase().trim();
    var cards = productGrid.querySelectorAll('.product-card');
    var visible = 0;
    cards.forEach(function (card) {
      var name = (card.querySelector('.product-card__name') || card).textContent.toLowerCase();
      var show = q === '' || name.indexOf(q) !== -1;
      card.style.display = show ? '' : 'none';
      if (show && !card.classList.contains('is-size-hidden')) visible++;
    });
    if (noResults) noResults.hidden = visible > 0 || q === '';
  }

  if (searchInput) {
    searchInput.addEventListener('input', function () {
      var q = searchInput.value;
      if (searchClear) searchClear.hidden = q.length === 0;
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(function () { filterBySearch(q); }, 180);
    });
  }
  if (searchClear) {
    searchClear.addEventListener('click', function () {
      searchInput.value = ''; searchClear.hidden = true;
      filterBySearch(''); searchInput.focus();
    });
  }

  /* ── Pagination AJAX ── */
  function bindPaginationLinks() {
    gridWrap.querySelectorAll('.pagination a').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        loadUrl(a.href);
        window.scrollTo({ top: gridWrap.getBoundingClientRect().top + window.scrollY - 120, behavior: 'smooth' });
      });
    });
  }

  bindPaginationLinks();

  /* A shared link can carry ?size=230g — pick those up and load the filtered grid */
  selectedSizes = new URLSearchParams(window.location.search).getAll('size').map(sizeKey).filter(Boolean);
  buildSizeChips();
  if (selectedSizes.length) {
    var start = new URL(window.location.href);
    start.searchParams.delete('size');
    start.searchParams.delete('page');
    loadUrl(start.pathname + start.search, false);
  }
  updateBadge();

  window.addEventListener('popstate', function () { window.location.reload(); });
})();
</script>
