{% style %}
  section.main-product {
    padding-top: 20px;
    padding-bottom: var(--space-16, 64px);
  }
  section.main-product .breadcrumb {
    margin-bottom: 12px;
  }
  section.main-product .product-layout {
    display: grid;
    gap: var(--space-10, 40px);
    align-items: start;
  }
  @media (min-width: 768px) {
    section.main-product .product-layout {
      grid-template-columns: min(50%, calc(100vh - 200px)) 1fr;
    }
  }
  @media (max-width: 767px) {
    section.main-product {
      padding-top: 12px;
    }
    section.main-product .product-layout {
      grid-template-columns: 1fr;
      gap: var(--space-6, 24px);
    }
  }
{% endstyle %}

<!-- Variant data for JS -->
<script id="product-variants-json" type="application/json">{{ product.variants | json }}</script>
<script id="product-options-json" type="application/json">{{ product.options | json }}</script>

<section class="main-product section" id="product-{{ product.id }}">
  <div class="container">

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list" role="list">
        <li><a href="{{ routes.root_url }}" class="breadcrumb__link">Home</a></li>
        <li aria-hidden="true" class="breadcrumb__sep">/</li>
        {%- if collection -%}
          <li><a href="{{ collection.url }}" class="breadcrumb__link">{{ collection.title }}</a></li>
          <li aria-hidden="true" class="breadcrumb__sep">/</li>
        {%- endif -%}
        <li aria-current="page" class="breadcrumb__current">{{ product.title }}</li>
      </ol>
    </nav>

    <!-- ── 2-column product layout ── -->
    <div class="product-layout">

      <!-- Left: Media -->
      <div class="product-layout__media">
        <div class="product-media">
          {%- assign featured = product.selected_or_first_available_variant.featured_image | default: product.featured_image -%}
          {%- if featured -%}
            <img
              id="product-featured-image"
              src="{{ featured | image_url: width: 900 }}"
              srcset="{{ featured | image_url: width: 450 }} 450w, {{ featured | image_url: width: 900 }} 900w"
              sizes="(max-width: 767px) 100vw, 50vw"
              alt="{{ featured.alt | default: product.title | escape }}"
              width="900" height="900"
              loading="eager"
              class="product-media__main"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'product-media__placeholder' }}
          {%- endif -%}
          {%- if product.variants.first.sku != blank -%}
            <span class="product-media__batch eyebrow" id="product-sku-badge">Batch {{ product.variants.first.sku }}</span>
          {%- endif -%}
          {%- if product.images.size > 1 -%}
            <button class="product-gallery__arrow product-gallery__arrow--prev" id="gallery-prev" aria-label="Previous image" type="button">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="product-gallery__arrow product-gallery__arrow--next" id="gallery-next" aria-label="Next image" type="button">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-thumbnails" id="product-thumbnails">
            {%- for image in product.images limit: 6 -%}
              <button
                class="product-thumbnail{% if forloop.first %} product-thumbnail--active{% endif %}"
                type="button"
                aria-label="{{ image.alt | default: product.title | escape }}"
                data-image-src="{{ image | image_url: width: 900 }}"
                data-thumb-index="{{ forloop.index0 }}"
              >
                <img src="{{ image | image_url: width: 120 }}" alt="" width="120" height="120" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Benefit bullets -->
        {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
        {%- if benefit_blocks.size > 0 -%}
          <div class="pd-why">
            {%- if section.settings.why_heading != blank -%}
              <h3 class="pd-why__heading">{{ section.settings.why_heading }}</h3>
            {%- endif -%}
            <ul class="pd-why__list" role="list">
              {%- for block in benefit_blocks -%}
                <li class="pd-why__item" {{ block.shopify_attributes }}>
                  <span class="pd-why__icon" aria-hidden="true">
                    {%- case block.settings.icon -%}
                      {%- when 'leaf' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                      {%- when 'thumbs_up' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3H14z"/><path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
                      {%- when 'award' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/><path d="M9 8l2 2 4-4"/></svg>
                      {%- when 'truck' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                      {%- when 'shield' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
                      {%- else -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    {%- endcase -%}
                  </span>
                  <span class="pd-why__text">{{ block.settings.text }}</span>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <!-- Inline Review Carousel -->
        {%- assign inline_reviews = section.blocks | where: 'type', 'inline_review' -%}
        {%- if inline_reviews.size > 0 -%}
          <div class="pd-review-carousel" id="pd-review-carousel-{{ section.id }}">
            <div class="pd-review-carousel__track" id="pd-review-track-{{ section.id }}">
              {%- for block in inline_reviews -%}
                <div class="pd-review-card" {{ block.shopify_attributes }}>
                  <p class="pd-review-card__text">{{ block.settings.text }}</p>
                  <div class="pd-review-card__footer">
                    <div class="pd-review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                      {%- assign r = block.settings.rating | default: 5 -%}
                      {%- for i in (1..5) -%}
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="{% if i <= r %}#FBBC05{% else %}#D1D5DB{% endif %}" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      {%- endfor -%}
                    </div>
                    <span class="pd-review-card__name">{{ block.settings.reviewer_name }}</span>
                  </div>
                </div>
              {%- endfor -%}
            </div>
            {%- if inline_reviews.size > 1 -%}
              <button class="pd-review-carousel__arrow pd-review-carousel__arrow--prev" id="pd-review-prev-{{ section.id }}" aria-label="Previous review" type="button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button class="pd-review-carousel__arrow pd-review-carousel__arrow--next" id="pd-review-next-{{ section.id }}" aria-label="Next review" type="button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}


      </div>

      <!-- Right: Details -->
      <div class="product-layout__details">

        <!-- Sticky title + price header -->
        <div class="pd-sticky-header">
          {%- if settings.show_stock_badge -%}
            {%- render 'status-badge', type: 'in_stock', ships_in: settings.ships_in_text -%}
          {%- endif -%}
          <h1 class="product-name">{{ product.title }}</h1>
        </div>

        <hr class="divider">

        <!-- Description bullets -->
        {%- render 'product-bullets', product: product -%}
        <hr class="divider">

        <!-- Variant selector -->
        {%- unless product.has_only_default_variant -%}
          {%- render 'variant-selector', product: product -%}
        {%- endunless -%}

        <!-- ── Subscribe & Save toggle ── -->
        {%- if product.selling_plan_groups.size > 0 -%}
          <div class="purchase-type" id="purchase-type">
            <label class="purchase-type__opt purchase-type__opt--active" id="pt-onetime-label">
              <input type="radio" name="purchase-type" value="onetime" checked class="visually-hidden" id="pt-onetime">
              <div class="purchase-type__inner">
                <span class="purchase-type__name">One-Time Purchase</span>
                <span class="purchase-type__price" id="pt-onetime-price">{{ product.selected_or_first_available_variant.price | money }}</span>
              </div>
            </label>
            <label class="purchase-type__opt" id="pt-subscribe-label">
              <input type="radio" name="purchase-type" value="subscribe" class="visually-hidden" id="pt-subscribe">
              <div class="purchase-type__inner">
                <div class="purchase-type__name-row">
                  <span class="purchase-type__name">Subscribe &amp; Save</span>
                  <span class="purchase-type__save-badge">SAVE 10%</span>
                </div>
                <span class="purchase-type__price" id="pt-sub-price">
                  {%- assign sub_price = product.selected_or_first_available_variant.price | times: 0.9 | round -%}
                  {{ sub_price | money }}
                </span>
                <select class="purchase-type__freq" id="selling-plan-select">
                  {%- for group in product.selling_plan_groups -%}
                    {%- for plan in group.selling_plans -%}
                      <option value="{{ plan.id }}">{{ plan.name }}</option>
                    {%- endfor -%}
                  {%- endfor -%}
                </select>
              </div>
            </label>
          </div>
        {%- else -%}
          <!-- Subscribe & Save placeholder (no selling plans yet) -->
          <div class="purchase-type purchase-type--static" id="purchase-type">
            <div class="purchase-type__opt purchase-type__opt--active purchase-type__opt--only">
              <div class="purchase-type__inner">
                <span class="purchase-type__name">One-Time Purchase</span>
                <span class="purchase-type__price" id="pt-onetime-price">{{ product.selected_or_first_available_variant.price | money }}</span>
              </div>
            </div>
            <div class="purchase-type__opt purchase-type__opt--coming">
              <div class="purchase-type__inner">
                <div class="purchase-type__name-row">
                  <span class="purchase-type__name">Subscribe &amp; Save</span>
                  <span class="purchase-type__save-badge">COMING SOON</span>
                </div>
                <span class="purchase-type__sub-note">Auto-delivery at a discount</span>
              </div>
            </div>
          </div>
        {%- endif -%}

        <!-- Add to cart form -->
        {%- form 'product', product, class: 'product-form', id: 'product-form' -%}
          <input type="hidden" name="id" id="variant-hidden-id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="selling_plan" id="selling-plan-input" value="" disabled>

          <!-- Quantity — labeled, visually secondary -->
          <div class="product-form__qty-row">
            <span class="product-form__qty-label">Quantity</span>
            {%- render 'quantity-stepper' -%}
          </div>

          <!-- Primary CTA — full width, visually dominant -->
          <button
            type="submit"
            class="product-form__atc{% unless product.selected_or_first_available_variant.available %} product-form__atc--sold-out{% endunless %}"
            id="product-atc-btn"
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            {%- if product.selected_or_first_available_variant.available -%}
              <span class="product-form__atc-label">{{ 'products.add_to_cart' | t }}</span>
              <span class="product-form__atc-sep" aria-hidden="true">—</span>
              <span class="product-form__atc-price" id="atc-btn-price">{{ product.selected_or_first_available_variant.price | money }}</span>
            {%- else -%}
              {{ 'products.sold_out' | t }}
            {%- endif -%}
          </button>

          <!-- Trust strip — immediate reassurance below CTA -->
          <div class="product-form__trust-strip" aria-label="Product guarantees">
            <div class="pf-trust__item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
              <span>Made in Canada</span>
            </div>
            <span class="pf-trust__sep" aria-hidden="true">·</span>
            <div class="pf-trust__item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span>Ships in 24h</span>
            </div>
            <span class="pf-trust__sep" aria-hidden="true">·</span>
            <div class="pf-trust__item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              <span>30-Day Guarantee</span>
            </div>
          </div>
        {%- endform -%}

        <!-- Express payment — de-emphasised, below primary CTA -->
        <div class="pd-payment">
          <div class="pd-payment__divider"><span>or pay with</span></div>
          <div class="pd-payment__icons">
            <svg class="pd-payment__icon" viewBox="0 0 48 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Google Pay"><text x="2" y="15" font-family="Arial" font-size="11" font-weight="700" fill="#5F6368">G</text><text x="10" y="15" font-family="Arial" font-size="11" fill="#5F6368">Pay</text></svg>
            <svg class="pd-payment__icon" viewBox="0 0 48 20" xmlns="http://www.w3.org/2000/svg" aria-label="Apple Pay"><text x="2" y="14" font-family="-apple-system,sans-serif" font-size="10" font-weight="600" fill="#000"> Pay</text></svg>
            <svg class="pd-payment__icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" aria-label="American Express"><rect width="38" height="24" rx="4" fill="#2557D6"/><text x="4" y="16" font-family="Arial" font-size="7" font-weight="800" fill="#fff">AMEX</text></svg>
            <svg class="pd-payment__icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" aria-label="Mastercard"><rect width="38" height="24" rx="4" fill="#252525"/><circle cx="14" cy="12" r="7" fill="#EB001B"/><circle cx="24" cy="12" r="7" fill="#F79E1B"/><path d="M19 7.3a7 7 0 0 1 0 9.4A7 7 0 0 1 19 7.3z" fill="#FF5F00"/></svg>
            <svg class="pd-payment__icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" aria-label="Shop Pay"><rect width="38" height="24" rx="4" fill="#5A31F4"/><text x="4" y="16" font-family="Arial" font-size="7" font-weight="700" fill="#fff">Shop</text></svg>
            <svg class="pd-payment__icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" aria-label="Visa"><rect width="38" height="24" rx="4" fill="#fff" stroke="#E6E6E6"/><text x="6" y="17" font-family="Arial" font-size="12" font-weight="800" fill="#1A1F71">VISA</text></svg>
          </div>
        </div>

        <!-- Tab panel -->
        {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
        {%- if accordion_blocks.size > 0 -%}
          <div class="pd-tabs" id="pd-tabs-{{ section.id }}" role="tablist" aria-label="Product information">
            <div class="pd-tabs__nav">
              {%- for block in accordion_blocks -%}
                <button
                  class="pd-tabs__btn{% if forloop.first %} pd-tabs__btn--active{% endif %}"
                  type="button"
                  role="tab"
                  id="pd-tab-btn-{{ block.id }}"
                  aria-controls="pd-tab-panel-{{ block.id }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  {{ block.shopify_attributes }}
                >{{ block.settings.title }}</button>
              {%- endfor -%}
            </div>
            <div class="pd-tabs__body">
              {%- for block in accordion_blocks -%}
                <div
                  class="pd-tabs__panel"
                  id="pd-tab-panel-{{ block.id }}"
                  role="tabpanel"
                  aria-labelledby="pd-tab-btn-{{ block.id }}"
                  {% unless forloop.first %}hidden{% endunless %}
                >
                  {%- assign tab_title = block.settings.title | downcase | strip -%}
                  {%- if tab_title == 'details' and product.description != blank -%}
                    {{ product.description }}
                  {%- elsif tab_title == 'nutrition' and product.metafields.nutrition.facts != blank -%}
                    {%- render 'nutrition-facts', product: product -%}
                  {%- elsif tab_title contains 'recip' -%}
                    {%- render 'product-recipes', product: product -%}
                  {%- elsif tab_title == 'faq' -%}
                    {%- render 'product-faq', product: product -%}
                  {%- else -%}
                    {{ block.settings.content }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Trust badges -->
        {%- assign product_badges = product.metafields.nutrition.badges.value -%}
        {%- if product_badges == blank -%}
          {%- capture product_badges_csv -%}{%- render 'product-claims', product: product -%}{%- endcapture -%}
          {%- assign product_badges = product_badges_csv | strip | split: ',' -%}
        {%- endif -%}
        {%- assign trust_blocks = section.blocks | where: 'type', 'trust_badge' -%}
        {%- if product_badges != blank -%}
          <div class="pd-trust">
            {%- for badge in product_badges -%}
              <div class="pd-trust__item">
                <div class="pd-trust__icon" aria-hidden="true">
                  {%- render 'badge-icon', badge: badge -%}
                </div>
                <span class="pd-trust__label">{{ badge }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- elsif trust_blocks.size > 0 -%}
          <div class="pd-trust">
            {%- for block in trust_blocks -%}
              <div class="pd-trust__item" {{ block.shopify_attributes }}>
                <div class="pd-trust__icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'shield' -%}
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
                    {%- when 'leaf' -%}
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                    {%- when 'award' -%}
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/><path d="M9 8l2 2 4-4"/></svg>
                    {%- when 'truck' -%}
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    {%- when 'clock' -%}
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {%- when 'flag' -%}
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                    {%- else -%}
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {%- endcase -%}
                </div>
                <span class="pd-trust__label">{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div><!-- /.product-layout__details -->
    </div><!-- /.product-layout -->


  </div>
</section>

<!-- ── Sticky ATC bar ── -->
<div class="sticky-atc" id="sticky-atc" aria-hidden="true">
  <div class="container sticky-atc__inner">
    <div class="sticky-atc__product">
      {%- assign sticky_img = product.selected_or_first_available_variant.featured_image | default: product.featured_image -%}
      {%- if sticky_img -%}
        <img
          id="sticky-atc-img"
          src="{{ sticky_img | image_url: width: 80 }}"
          alt="{{ product.title | escape }}"
          width="40" height="40"
          class="sticky-atc__img"
          loading="lazy"
        >
      {%- endif -%}
      <div class="sticky-atc__info">
        <span class="sticky-atc__title">{{ product.title }}</span>
        <span class="sticky-atc__price" id="sticky-atc-price">{{ product.selected_or_first_available_variant.price | money }}</span>
      </div>
    </div>
    <button class="product-form__atc sticky-atc__btn" id="sticky-atc-btn" type="button">
      {{ 'products.add_to_cart' | t }}
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "why_heading", "label": "\"Why Balsam?\" heading", "default": "Why Balsam?" },
{ "type": "text", "id": "cert_heading", "label": "Certifications heading", "default": "Our Certifications" },
{ "type": "text", "id": "guarantee_text", "label": "Guarantee badge text", "default": "30 Day Satisfaction Guarantee" }
  ],
  "blocks": [
    {
      "type": "certification",
      "name": "Certification badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "certified",
          "options": [
            { "value": "kosher", "label": "Kosher" }, { "value": "halal", "label": "Halal" },
            { "value": "non_gmo", "label": "Non-GMO" }, { "value": "certified", "label": "Certified" }
          ]
        },
        { "type": "text", "id": "label", "label": "Badge label", "default": "Certified" }
      ]
    },
    {
      "type": "desc_bullet",
      "name": "Description bullet",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "✅" },
        { "type": "text", "id": "bold_text", "label": "Bold text (highlight)", "default": "Stone-ground from premium sesame" },
        { "type": "text", "id": "body_text", "label": "Body text (regular)", "default": "for a rich, authentic flavour in every spoonful." }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit bullet",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Leaf" }, { "value": "thumbs_up", "label": "Thumbs up" },
            { "value": "award", "label": "Award" }, { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" }
          ]
        },
        { "type": "text", "id": "text", "label": "Benefit text", "default": "Stone-ground from premium sesame seeds" }
      ]
    },
    {
      "type": "pairs_product",
      "name": "Pairs Well With product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "Product Description" },
        { "type": "richtext", "id": "content", "label": "Tab content" }
      ]
    },
    {
      "type": "inline_review",
      "name": "Gallery review card",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Review text", "default": "Absolutely love this tahini! Rich, smooth, and completely addictive." },
        { "type": "text", "id": "reviewer_name", "label": "Reviewer name", "default": "Sarah M." },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield / Certified" },
            { "value": "leaf", "label": "Leaf / Organic" },
            { "value": "award", "label": "Award" },
            { "value": "truck", "label": "Free Shipping" },
            { "value": "clock", "label": "Quick Support" },
            { "value": "flag", "label": "Flag / Origin" }
          ]
        },
        { "type": "text", "id": "label", "label": "Badge label", "default": "Made in Canada" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "leaf", "text": "Single origin sesame, stone-ground in small batches" } },
        { "type": "benefit", "settings": { "icon": "thumbs_up", "text": "Over 2,000 five-star reviews" } },
        { "type": "benefit", "settings": { "icon": "award", "text": "Guaranteed to wow you or we'll replace it" } },
        { "type": "benefit", "settings": { "icon": "truck", "text": "Free shipping on orders over $40" } }
      ]
    }
  ]
}
{% endschema %}

<style>
  /* ── Breadcrumb ── */
  .breadcrumb { margin-bottom: var(--space-3); }
  .breadcrumb__list { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); list-style: none; font-size: var(--text-xs); color: var(--muted); }
  .breadcrumb__link { color: var(--muted); transition: color var(--motion-fast) var(--ease-standard); }
  .breadcrumb__link:hover { color: var(--fg); }
  .breadcrumb__current { color: var(--fg-2); font-weight: 600; }

  /* ── Layout ── */
  .product-layout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-10); align-items: start; }

  /* ── Media ── */
  .product-layout__media { display: flex; flex-direction: column; position: sticky; top: 20px; align-self: start; }
  .product-media {
    position: relative;
    width: 100%;
    max-width: 60vh;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }
  .product-media__main,
  .product-media__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-media__placeholder { background: var(--border-soft); }
  .product-media__batch { position: absolute; bottom: var(--space-4); left: var(--space-4); background: var(--surface-warm); color: var(--fg); padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); font-size: var(--text-xs); }
  .product-thumbnails { display: flex; gap: var(--space-2); margin-top: var(--space-3); overflow-x: auto; scrollbar-width: none; max-width: 60vh; margin-inline: auto; }
  .product-thumbnails::-webkit-scrollbar { display: none; }
  .product-thumbnail { flex-shrink: 0; width: 72px; height: 72px; border-radius: var(--radius-sm); border: 1.5px solid var(--border); overflow: hidden; cursor: pointer; transition: border-color 0.15s; background: none; padding: 0; }
  .product-thumbnail img { width: 100%; height: 100%; object-fit: cover; }
  .product-thumbnail--active, .product-thumbnail:hover { border-color: var(--accent); }

  /* ── Details ── */
  .product-layout__details { display: flex; flex-direction: column; gap: var(--space-5); }

  /* ── Sticky title + price ── */
  .pd-sticky-header {
    position: sticky;
    top: 0;
    z-index: 9;
    background: var(--bg, #FAFAF8);
    padding-bottom: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .review-strip { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .review-strip__count { font-size: var(--text-sm); font-weight: 600; color: var(--fg-2); }
  .review-strip__verified { padding: var(--space-1) var(--space-2); background: var(--border-soft); border-radius: var(--radius-pill); }

  /* ── Subscribe & Save toggle ── */
  .purchase-type {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .purchase-type__opt {
    display: flex;
    align-items: center;
    padding: 10px var(--space-4);
    cursor: pointer;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
    gap: var(--space-3);
  }
  .purchase-type__opt:last-child { border-bottom: none; }
  .purchase-type__opt::before {
    content: '';
    flex-shrink: 0;
    width: 18px; height: 18px;
    border-radius: 50%;
    border: 2px solid var(--border);
    transition: border-color 0.15s, background 0.15s;
  }
  .purchase-type__opt--active { background: rgba(27,67,50,0.04); }
  .purchase-type__opt--active::before { border-color: var(--accent); background: var(--accent); box-shadow: inset 0 0 0 3px var(--surface); }
  .purchase-type__opt--coming { opacity: 0.55; cursor: default; }
  .purchase-type__opt--only { cursor: default; }
  .purchase-type--static .purchase-type__opt--active::before { background: var(--accent); }
  .purchase-type__inner { flex: 1; }
  .purchase-type__name { font-size: var(--text-sm); font-weight: 600; color: var(--fg); }
  .purchase-type__name-row { display: flex; align-items: center; gap: var(--space-2); }
  .purchase-type__save-badge {
    font-size: 0.65rem; font-weight: 700; letter-spacing: 0.06em;
    padding: 2px 8px; background: var(--accent); color: #fff;
    border-radius: var(--radius-pill); text-transform: uppercase;
  }
  .purchase-type__price { display: block; font-size: var(--text-sm); color: var(--muted); margin-top: 2px; }
  .purchase-type__sub-note { display: block; font-size: var(--text-xs); color: var(--muted); margin-top: 2px; }
  .purchase-type__freq {
    display: block; margin-top: var(--space-2);
    font-size: var(--text-sm); font-weight: 500; color: var(--fg);
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: 4px 10px;
    cursor: pointer;
  }

  /* ── Form: Quantity row ── */
  .product-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .product-form__qty-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0 2px;
  }
  .product-form__qty-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  /* ── Primary ATC button — flat solid, no gradient, no shadow ── */
  .product-form__atc {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 60px;
    padding: 0 var(--space-6);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-family: var(--font-body, 'Open Sans', sans-serif);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent, #1B4332);
    box-shadow: none;
    transition: background 0.18s ease, opacity 0.15s ease;
    position: relative;
  }
  .product-form__atc:hover:not(:disabled) {
    background: #166534;
  }
  .product-form__atc:active:not(:disabled) {
    background: #14532d;
    opacity: 0.92;
  }
  .product-form__atc:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .product-form__atc:disabled {
    opacity: 0.48;
    cursor: not-allowed;
  }
  .product-form__atc-label { font-weight: 800; letter-spacing: 0.08em; }
  .product-form__atc-sep  { opacity: 0.5; font-weight: 400; }
  .product-form__atc-price { font-weight: 800; }

  /* ── Trust strip — right below ATC ── */
  .product-form__atc::after { content: none; }
  .product-form__trust-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding: var(--space-1) 2px;
  }
  .pf-trust__item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--fg-2);
    white-space: nowrap;
  }
  .pf-trust__item svg { color: var(--accent); flex-shrink: 0; }
  .pf-trust__sep { color: var(--border); font-size: 0.8rem; line-height: 1; }

  .btn--disabled { opacity: 0.5; cursor: not-allowed; }

  /* ── Description bullets ── */
  .pd-desc-bullets { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); }
  .pd-desc-bullet { display: flex; align-items: flex-start; gap: 10px; font-size: var(--text-sm); color: var(--fg-2); line-height: 1.5; }
  .pd-desc-bullet__icon { display: flex; flex-shrink: 0; color: var(--accent); margin-top: 1px; }
  .pd-desc-bullet__text strong { color: var(--fg); font-weight: 700; }

  /* ── Why Balsam bullets ── */
  .pd-why { padding-top: var(--space-2); }
  .pd-why__heading { font-family: var(--font-display); font-size: 1.15rem; font-weight: 700; color: var(--fg); margin-bottom: 16px; letter-spacing: var(--tracking-display); }
  .pd-why__list { list-style: none; display: flex; flex-direction: column; gap: 16px; }
  .pd-why__item { display: flex; align-items: center; gap: 14px; }
  .pd-why__icon { flex-shrink: 0; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; color: var(--accent); }
  .pd-why__text { font-size: 0.95rem; color: var(--fg-2); line-height: 1.4; }

/* ── Tab panel — Warm Stone Pill Design ── */
  .pd-tabs {
    border-radius: 20px;
    background: var(--surface-warm, #F5F0E8);
    border: 1px solid rgba(27, 67, 50, 0.10);
    box-shadow:
      0 2px 6px rgba(0,0,0,0.05),
      0 8px 24px rgba(0,0,0,0.06),
      inset 0 1px 0 rgba(255,255,255,0.55);
    overflow: hidden;
  }

  /* Sunken pill tray */
  .pd-tabs__nav {
    display: flex;
    gap: 5px;
    padding: 10px 10px 0;
    background: rgba(0,0,0,0.035);
    border-bottom: none;
  }

  /* Tab buttons */
  .pd-tabs__btn {
    flex: 1;
    padding: 12px 16px;
    border: none;
    border-radius: 12px 12px 0 0;
    background: transparent;
    font-family: var(--font-body, 'Open Sans', sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(34, 41, 47, 0.45);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
    white-space: nowrap;
    position: relative;
  }
  .pd-tabs__btn:last-child { margin-right: 0; }

  .pd-tabs__btn:hover:not(.pd-tabs__btn--active) {
    background: rgba(255, 255, 255, 0.45);
    color: var(--fg, #22292F);
  }

  /* Active tab — merges flush into body below */
  .pd-tabs__btn--active {
    background: #fff;
    color: var(--accent, #1B4332);
    /* shadow only on top + sides, never bottom — bottom is hidden by body overlap */
    box-shadow:
      -3px -3px 8px rgba(0,0,0,0.06),
       3px -3px 8px rgba(0,0,0,0.06);
    margin-bottom: -1px;
    padding-bottom: 13px;
    position: relative;
    z-index: 1;
  }

  /* Content body — border-top hidden under the active tab */
  .pd-tabs__body {
    padding: 24px 24px 28px;
    background: #fff;
    border-top: 1px solid rgba(27, 67, 50, 0.10);
    position: relative;
  }

  .pd-tabs__panel {
    font-size: var(--text-sm);
    color: var(--fg-2, #6B7280);
    line-height: 1.7;
  }
  .pd-tabs__panel p { margin-bottom: var(--space-3); }
  .pd-tabs__panel p:last-child { margin-bottom: 0; }
  .pd-tabs__panel strong { color: var(--fg); font-weight: 700; }

  /* Mobile: tighter padding, full-width readable tabs */
  @media (max-width: 767px) {
    .pd-tabs { border-radius: 16px; }
    .pd-tabs__nav { padding: 8px 8px 0; gap: 3px; }
    .pd-tabs__btn { padding: 11px 10px; font-size: 0.68rem; letter-spacing: 0.07em; }
    .pd-tabs__body { padding: 20px 20px 24px; }
  }

  /* ── Payment icons — de-emphasised express checkout section ── */
  .pd-payment {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
  }
  .pd-payment__divider {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pd-payment__divider::before,
  .pd-payment__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .pd-payment__icons {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    justify-content: center;
  }
  .pd-payment__icon {
    height: 24px;
    width: auto;
    min-width: 40px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: #fff;
    display: block;
    opacity: 0.75;
  }

  /* ── Trust badges ── */
  .pd-trust {
    display: flex; justify-content: center;
    gap: var(--space-6); flex-wrap: wrap;
    padding: var(--space-5) 0 var(--space-2);
    border-top: 1px solid var(--border);
  }
  .pd-trust__item { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
  .pd-trust__icon { color: var(--accent); }
  .pd-trust__label { font-size: 0.72rem; font-weight: 600; color: var(--fg-2); line-height: 1.3; max-width: 80px; }

  /* ── Gallery arrows ── */
  .product-gallery__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 40px; height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    border: 1.5px solid var(--border);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg);
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    transition: background 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .product-gallery__arrow:hover {
    background: #fff;
    box-shadow: 0 4px 16px rgba(0,0,0,0.18);
    transform: translateY(-50%) scale(1.08);
  }
  .product-gallery__arrow--prev { left: var(--space-3); }
  .product-gallery__arrow--next { right: var(--space-3); }

  /* Left column extra spacing for moved blocks */
  .product-layout__media .pd-why { margin-top: var(--space-6); }

  /* ── Description band ── */
  .product-desc-band { margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--border); }
  .product-desc-band__body { max-width: 720px; font-size: var(--text-base); color: var(--fg-2); line-height: var(--leading-body); }
  .product-desc-band__body p { margin-bottom: var(--space-4); }
  .product-desc-band__body p:last-child { margin-bottom: 0; }
  .product-desc-band--split { display: grid; grid-template-columns: 1fr 320px; gap: 56px; align-items: start; }
  .pd-certs { background: #FAFAF8; border: 1px solid #E5E7EB; border-radius: 14px; padding: 28px 22px; }
  .pd-certs__heading { font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: var(--fg); margin-bottom: 22px; }
  .pd-certs__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px 8px; }
  .pd-certs__item { display: flex; flex-direction: column; align-items: center; gap: 9px; text-align: center; }
  .pd-certs__icon-wrap { width: 54px; height: 54px; border: 1.5px solid var(--accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--accent); transition: background 0.2s, color 0.2s; }
  .pd-certs__item:hover .pd-certs__icon-wrap { background: var(--accent); color: #fff; }
  .pd-certs__label { font-size: 0.63rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--fg-2); line-height: 1.3; }


  /* ── Certification badge row ── */
  .pd-cert-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .pd-cert-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px 6px 10px;
    background: var(--fg);
    color: #fff;
    border-radius: var(--radius-pill);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1;
  }
  .pd-cert-badge svg { flex-shrink: 0; }

  /* ── ATC Toast ── */
  .atc-toast {
    position: fixed;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    z-index: 500;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--fg);
    color: #fff;
    padding: 14px 20px;
    border-radius: var(--radius-md);
    box-shadow: 0 8px 32px rgba(0,0,0,0.22);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  .atc-toast.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  .atc-toast[hidden] { display: none; }
  .atc-toast__icon { flex-shrink: 0; color: #4ADE80; }
  .atc-toast__link { color: rgba(255,255,255,0.75); text-decoration: underline; text-underline-offset: 2px; margin-left: var(--space-2); transition: color 0.15s; }
  .atc-toast__link:hover { color: #fff; }
  .atc-toast__close { background: none; border: none; cursor: pointer; color: rgba(255,255,255,0.6); padding: 2px; margin-left: var(--space-1); display: flex; align-items: center; border-radius: 50%; transition: color 0.15s; }
  .atc-toast__close:hover { color: #fff; }

  /* ── Inline Review Carousel ── */
  .pd-review-carousel {
    position: relative;
    margin-top: var(--space-4);
    overflow: hidden;
    border-radius: var(--radius-lg);
  }
  .pd-review-carousel__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .pd-review-carousel__track::-webkit-scrollbar { display: none; }
  .pd-review-card {
    flex: 0 0 100%;
    scroll-snap-align: start;
    background: var(--fg);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-height: 110px;
    box-sizing: border-box;
  }
  .pd-review-card__text {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: rgba(255,255,255,0.92);
    flex: 1;
  }
  .pd-review-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .pd-review-card__stars { display: flex; align-items: center; gap: 2px; }
  .pd-review-card__name {
    font-size: var(--text-xs);
    font-weight: 600;
    color: rgba(255,255,255,0.65);
    white-space: nowrap;
  }
  .pd-review-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.25);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: background 0.15s;
  }
  .pd-review-carousel__arrow:hover { background: rgba(255,255,255,0.28); }
  .pd-review-carousel__arrow--prev { left: 10px; }
  .pd-review-carousel__arrow--next { right: 10px; }

  /* ── Responsive ── */
  @media (max-width: 959px) {
    .product-desc-band--split { grid-template-columns: 1fr; gap: 32px; }
    .pd-certs__grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 767px) {
    .product-layout { grid-template-columns: 1fr; gap: 0; }
    .pd-certs__grid { grid-template-columns: repeat(3, 1fr); }
    .product-media { max-width: 100%; }
    .product-thumbnails { max-width: 100%; margin-inline: auto; }
    /* Image not sticky on mobile */
    .product-layout__media {
      position: static;
    }
    .product-layout__details {
      position: relative;
      z-index: 1;
      padding-top: var(--space-5);
    }
    /* Title + price not sticky on mobile */
    .pd-sticky-header { position: static; background: none; }
    /* Bigger title + price on mobile */
    .product-name { font-size: 2rem; line-height: 1.15; }
    .price-block__regular,
    .price-block__sale { font-size: 2rem; }
  }

  /* ── Sticky ATC bar ── */
  .sticky-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: #fff;
    border-top: 2px solid rgba(27,67,50,0.12);
    box-shadow: 0 -4px 32px rgba(0,0,0,0.13);
    transform: translateY(100%);
    transition: transform 0.28s ease;
    pointer-events: none;
  }
  .sticky-atc.is-visible {
    transform: translateY(0);
    pointer-events: auto;
  }
  .sticky-atc__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 14px var(--container-gutter-desktop, 40px);
  }
  .sticky-atc__product {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: 1;
    min-width: 0;
  }
  .sticky-atc__img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    border: 1px solid var(--border);
  }
  .sticky-atc__info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .sticky-atc__title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sticky-atc__price {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--accent);
  }
  .sticky-atc__btn {
    flex-shrink: 0;
    white-space: nowrap;
    width: auto;
    min-height: 54px;
    padding: 0 32px;
    font-size: 0.82rem;
    border-radius: 10px;
  }
  /* "Added ✓" success state */
  .product-form__atc--added {
    background: #166534 !important;
    pointer-events: none;
  }
  @media (max-width: 767px) {
    .sticky-atc__inner { padding: 12px var(--container-gutter-phone, 20px); gap: var(--space-3); }
    .sticky-atc__img { width: 44px; height: 44px; }
    .sticky-atc__title { font-size: 0.82rem; }
    .sticky-atc__btn { min-height: 50px; padding: 0 20px; }
  }
</style>

<script>
(function () {
  /* ── Variant data ── */
  var variantData  = JSON.parse(document.getElementById('product-variants-json').textContent);
  var productOpts  = JSON.parse(document.getElementById('product-options-json').textContent);
  var productHandle = {{ product.handle | json }};
  var productTitle  = {{ product.title | json }};
  var productUrl    = {{ product.url | json }};

  /* Track unit price so quantity changes can recalculate */
  var currentUnitPrice = {{ product.selected_or_first_available_variant.price | default: 0 }};

  function updateAtcPrice() {
    var qtyInput = document.querySelector('.qty-stepper__input');
    var qty = qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1;
    var total = currentUnitPrice * qty;
    var priceSpan = document.getElementById('atc-btn-price');
    if (priceSpan) priceSpan.textContent = formatMoney(total);
    /* Keep sticky bar price in sync with qty × unit price */
    var stickyPrice = document.getElementById('sticky-atc-price');
    if (stickyPrice) stickyPrice.textContent = formatMoney(total);
  }

  /* Listen for quantity changes */
  document.addEventListener('change', function (e) {
    if (e.target && e.target.classList.contains('qty-stepper__input')) {
      updateAtcPrice();
    }
  });

  function formatMoney(cents) {
    if (!cents && cents !== 0) return '';
    return '$' + (cents / 100).toFixed(2);
  }

  function getSelectedVariant() {
    var selectedOpts = [];
    productOpts.forEach(function (name) {
      var inp = document.querySelector('.variant-selector input[name="options[' + name + ']"]:checked');
      selectedOpts.push(inp ? inp.value : null);
    });
    return variantData.find(function (v) {
      return selectedOpts.every(function (val, i) {
        return val === null || v['option' + (i + 1)] === val;
      });
    });
  }

  function updateVariantUI(variant) {
    if (!variant) return;

    /* Hidden form ID */
    var hiddenId = document.getElementById('variant-hidden-id');
    if (hiddenId) hiddenId.value = variant.id;

    /* Price display */
    var priceWrap = document.getElementById('product-price-display');
    if (priceWrap && variant.price) {
      var html = '';
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        html = '<div class="price">'
          + '<s class="price__compare" style="color:var(--muted);font-size:0.9em;margin-right:8px;">' + formatMoney(variant.compare_at_price) + '</s>'
          + '<span class="price__current" style="font-size:1.35rem;font-weight:700;color:var(--fg);">' + formatMoney(variant.price) + '</span>'
          + '<span class="price__save-badge" style="margin-left:8px;font-size:0.7rem;font-weight:700;letter-spacing:0.05em;background:var(--accent);color:#fff;padding:3px 8px;border-radius:20px;">SAVE ' + Math.round((1 - variant.price / variant.compare_at_price) * 100) + '%</span>'
          + '</div>';
      } else {
        html = '<div class="price"><span class="price__current" style="font-size:1.35rem;font-weight:700;color:var(--fg);">' + formatMoney(variant.price) + '</span></div>';
      }
      priceWrap.innerHTML = html;
    }

    /* Subscribe & Save prices */
    var oneTimePrice = document.getElementById('pt-onetime-price');
    var subPrice = document.getElementById('pt-sub-price');
    if (oneTimePrice) oneTimePrice.textContent = formatMoney(variant.price);
    if (subPrice) subPrice.textContent = formatMoney(Math.round(variant.price * 0.9));

    /* Main image */
    if (variant.featured_image) {
      var mainImg = document.getElementById('product-featured-image');
      if (mainImg) {
        var imgSrc = variant.featured_image.src;
        mainImg.src = imgSrc;
        mainImg.srcset = imgSrc;
        /* Highlight the matching thumbnail */
        var thumbs = document.querySelectorAll('.product-thumbnail');
        thumbs.forEach(function (t) { t.classList.remove('product-thumbnail--active'); });
        var matchThumb = document.querySelector('.product-thumbnail[data-thumb-index="' + (variant.featured_image.position - 1) + '"]');
        if (!matchThumb && thumbs.length > 0) matchThumb = thumbs[0];
        if (matchThumb) matchThumb.classList.add('product-thumbnail--active');
      }
    }

    /* ATC button */
    currentUnitPrice = variant.price || 0;
    var atcBtn = document.getElementById('product-atc-btn');
    if (atcBtn) {
      atcBtn.disabled = !variant.available;
      atcBtn.classList.toggle('btn--disabled', !variant.available);
      if (variant.available) {
        var priceSpan = document.getElementById('atc-btn-price');
        if (priceSpan) {
          updateAtcPrice();
        } else {
          atcBtn.innerHTML = '<span class="product-form__atc-label">Add to Cart</span>'
            + '<span class="product-form__atc-sep" aria-hidden="true">—</span>'
            + '<span class="product-form__atc-price" id="atc-btn-price">' + formatMoney(currentUnitPrice) + '</span>';
        }
      } else {
        atcBtn.textContent = 'Sold Out';
      }
    }

    /* Sync sticky bar price + image */
    if (window.__stickyAtcUpdatePrice) window.__stickyAtcUpdatePrice(formatMoney(variant.price));
    if (window.__stickyAtcUpdateImg && variant.featured_image) window.__stickyAtcUpdateImg(variant.featured_image.src);

    /* Variant card/pill states */
    document.querySelectorAll('.variant-card').forEach(function (card) {
      var inp = card.querySelector('input');
      if (inp) card.classList.toggle('variant-card--selected', inp.checked);
    });
    document.querySelectorAll('.variant-pill').forEach(function (pill) {
      var inp = pill.querySelector('input');
      if (inp) pill.classList.toggle('variant-pill--selected', inp.checked);
    });

    /* URL update */
    var url = new URL(window.location.href);
    url.searchParams.set('variant', variant.id);
    history.replaceState({}, '', url.toString());
  }

  /* Listen for variant option changes */
  document.addEventListener('change', function (e) {
    if (e.target.closest && e.target.closest('.variant-selector')) {
      var v = getSelectedVariant();
      if (v) updateVariantUI(v);
    }
  });

  /* ── Thumbnail click ── */
  document.querySelectorAll('.product-thumbnail').forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      document.querySelectorAll('.product-thumbnail').forEach(function (t) { t.classList.remove('product-thumbnail--active'); });
      thumb.classList.add('product-thumbnail--active');
      var src = thumb.dataset.imageSrc;
      var mainImg = document.getElementById('product-featured-image');
      if (src && mainImg) {
        mainImg.src = src;
        mainImg.srcset = src;
      }
      /* If this image belongs to a variant, switch to that variant (updates price, ATC, URL) */
      var thumbIdx = parseInt(thumb.dataset.thumbIndex, 10);
      var matchedVariant = variantData.find(function (v) {
        return v.featured_image && (v.featured_image.position - 1) === thumbIdx;
      });
      if (matchedVariant) {
        productOpts.forEach(function (name, i) {
          var val = matchedVariant['option' + (i + 1)];
          var inp = document.querySelector('.variant-selector input[name="options[' + name + ']"][value="' + val + '"]');
          if (inp && !inp.checked) inp.checked = true;
        });
        updateVariantUI(matchedVariant);
      }
    });
  });

  /* ── AJAX Add to Cart ── */
  var productForm = document.getElementById('product-form');
  var atcToast    = document.getElementById('atc-toast');
  var atcToastTxt = document.getElementById('atc-toast-text');
  var toastClose  = document.getElementById('atc-toast-close');
  var toastTimer;

  function showToast(title) {
    if (!atcToast) return;
    if (atcToastTxt) atcToastTxt.textContent = '"' + title + '" added to cart';
    atcToast.hidden = false;
    requestAnimationFrame(function () {
      atcToast.classList.add('is-visible');
    });
    clearTimeout(toastTimer);
    toastTimer = setTimeout(hideToast, 4000);
  }

  function hideToast() {
    if (!atcToast) return;
    atcToast.classList.remove('is-visible');
    atcToast.addEventListener('transitionend', function handler() {
      atcToast.hidden = true;
      atcToast.removeEventListener('transitionend', handler);
    });
  }

  if (toastClose) toastClose.addEventListener('click', hideToast);

  function updateHeaderCartCount(count) {
    document.querySelectorAll('[data-cart-count]').forEach(function (el) {
      el.textContent = count;
      el.hidden = count === 0;
    });
  }

  var ADDED_HTML = '<span>Added</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';

  function setAddedState(btn) {
    if (!btn) return;
    btn.disabled = true;
    btn.classList.add('product-form__atc--added');
    btn.innerHTML = ADDED_HTML;
  }
  function resetBtnState(btn, html) {
    if (!btn) return;
    btn.disabled = false;
    btn.classList.remove('product-form__atc--added');
    btn.innerHTML = html;
  }

  if (productForm) {
    productForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var atcBtn    = document.getElementById('product-atc-btn');
      var stickyBtn = document.getElementById('sticky-atc-btn');
      var origMainHTML   = atcBtn    ? atcBtn.innerHTML    : '';
      var origStickyHTML = stickyBtn ? stickyBtn.innerHTML : '';

      if (atcBtn)    { atcBtn.disabled = true;    atcBtn.innerHTML = 'Adding…'; }
      if (stickyBtn) { stickyBtn.disabled = true; stickyBtn.innerHTML = 'Adding…'; }

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: new FormData(productForm)
      })
        .then(function (r) { return r.json(); })
        .then(function (item) {
          showToast(item.title || productTitle);
          setAddedState(atcBtn);
          setAddedState(stickyBtn);
          fetch('/cart.js')
            .then(function (r) { return r.json(); })
            .then(function (cart) { updateHeaderCartCount(cart.item_count); })
            .catch(function () {});
          setTimeout(function () {
            resetBtnState(atcBtn, origMainHTML);
            resetBtnState(stickyBtn, origStickyHTML);
          }, 2500);
        })
        .catch(function () {
          productForm.submit();
        });
    });
  }

  /* ── Subscribe & Save toggle ── */
  var ptOnetime   = document.getElementById('pt-onetime');
  var ptSubscribe = document.getElementById('pt-subscribe');
  var ptOnetimeLabel   = document.getElementById('pt-onetime-label');
  var ptSubscribeLabel = document.getElementById('pt-subscribe-label');
  var sellingPlanInput = document.getElementById('selling-plan-input');
  var sellingPlanSelect = document.getElementById('selling-plan-select');

  function applyPurchaseType() {
    var isSubscribe = ptSubscribe && ptSubscribe.checked;
    if (ptOnetimeLabel)   ptOnetimeLabel.classList.toggle('purchase-type__opt--active', !isSubscribe);
    if (ptSubscribeLabel) ptSubscribeLabel.classList.toggle('purchase-type__opt--active', isSubscribe);
    if (sellingPlanInput) {
      if (isSubscribe && sellingPlanSelect) {
        sellingPlanInput.value = sellingPlanSelect.value;
        sellingPlanInput.disabled = false;
      } else {
        sellingPlanInput.value = '';
        sellingPlanInput.disabled = true;
      }
    }
  }

  if (ptOnetime)   ptOnetime.addEventListener('change', applyPurchaseType);
  if (ptSubscribe) ptSubscribe.addEventListener('change', applyPurchaseType);
  if (sellingPlanSelect) sellingPlanSelect.addEventListener('change', function () {
    if (sellingPlanInput) sellingPlanInput.value = sellingPlanSelect.value;
  });

  /* ── Recently Viewed — track current product ── */
  (function () {
    var KEY = 'balsam-recently-viewed';
    var MAX = 8;
    try {
      var stored = JSON.parse(localStorage.getItem(KEY) || '[]');
      /* Remove current product if already there */
      stored = stored.filter(function (p) { return p.handle !== productHandle; });
      /* Add current to front with full data for proper card rendering */
      var featured = {{ product.featured_image | image_url: width: 600 | json }};
      stored.unshift({
        id: {{ product.id | json }},
        handle: productHandle,
        title: productTitle,
        url: productUrl,
        image: featured,
        price: {{ product.price | json }},
        compare_at: {{ product.compare_at_price | json }},
        description: {{ product.description | strip_html | truncate: 120 | json }},
        variants: [{{ product.selected_or_first_available_variant | json }}]
      });
      if (stored.length > MAX) stored = stored.slice(0, MAX);
      localStorage.setItem(KEY, JSON.stringify(stored));
    } catch(e) {}
  })();

  /* ── Gallery arrows ── */
  (function () {
    var allImages = document.querySelectorAll('.product-thumbnail');
    if (!allImages.length) return;
    var currentIdx = 0;
    var mainImg = document.getElementById('product-featured-image');

    function goToIndex(idx) {
      var count = allImages.length;
      currentIdx = (idx + count) % count;
      var thumb = allImages[currentIdx];
      if (!thumb || !mainImg) return;
      var src = thumb.dataset.imageSrc;
      mainImg.src = src;
      mainImg.srcset = src;
      allImages.forEach(function (t) { t.classList.remove('product-thumbnail--active'); });
      thumb.classList.add('product-thumbnail--active');
    }

    allImages.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        currentIdx = parseInt(thumb.dataset.thumbIndex, 10) || 0;
      });
    });

    var prevBtn = document.getElementById('gallery-prev');
    var nextBtn = document.getElementById('gallery-next');
    if (prevBtn) prevBtn.addEventListener('click', function () { goToIndex(currentIdx - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { goToIndex(currentIdx + 1); });
  })();

  /* ── Inline Review Carousel ── */
  (function () {
    var track = document.getElementById('pd-review-track-{{ section.id }}');
    if (!track) return;
    var prev = document.getElementById('pd-review-prev-{{ section.id }}');
    var next = document.getElementById('pd-review-next-{{ section.id }}');
    var cards = track.querySelectorAll('.pd-review-card');
    if (!cards.length) return;
    var current = 0;

    function goTo(idx) {
      current = (idx + cards.length) % cards.length;
      track.scrollTo({ left: track.clientWidth * current, behavior: 'smooth' });
    }

    if (prev) prev.addEventListener('click', function () { goTo(current - 1); });
    if (next) next.addEventListener('click', function () { goTo(current + 1); });

    /* Touch swipe */
    var touchStartX = 0;
    track.addEventListener('touchstart', function (e) { touchStartX = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', function (e) {
      var diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
    }, { passive: true });

    /* Auto-advance every 5s */
    setInterval(function () { goTo(current + 1); }, 5000);
  })();

  /* ── Tab panel ── */
  document.querySelectorAll('.pd-tabs').forEach(function (tabs) {
    var btns = tabs.querySelectorAll('.pd-tabs__btn');
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        btns.forEach(function (b) {
          b.classList.remove('pd-tabs__btn--active');
          b.setAttribute('aria-selected', 'false');
          var panel = document.getElementById(b.getAttribute('aria-controls'));
          if (panel) panel.hidden = true;
        });
        btn.classList.add('pd-tabs__btn--active');
        btn.setAttribute('aria-selected', 'true');
        var activePanel = document.getElementById(btn.getAttribute('aria-controls'));
        if (activePanel) activePanel.hidden = false;
      });
    });
  });

  /* ── Sticky ATC bar ── */
  (function () {
    var stickyBar   = document.getElementById('sticky-atc');
    var mainAtcBtn  = document.getElementById('product-atc-btn');
    var stickyBtn   = document.getElementById('sticky-atc-btn');
    var stickyPrice = document.getElementById('sticky-atc-price');
    var stickyImg   = document.getElementById('sticky-atc-img');
    if (!stickyBar || !mainAtcBtn) return;

    /* Show/hide bar when main ATC button leaves viewport */
    var observer = new IntersectionObserver(function (entries) {
      var visible = entries[0].isIntersecting;
      stickyBar.classList.toggle('is-visible', !visible);
      stickyBar.setAttribute('aria-hidden', String(visible));
    }, { threshold: 0 });
    observer.observe(mainAtcBtn);

    /* Sticky button submits the product form */
    if (stickyBtn) {
      stickyBtn.addEventListener('click', function () {
        var form = document.getElementById('product-form');
        if (form) form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
      });
    }

    /* Keep sticky price in sync with variant changes */
    window.__stickyAtcUpdatePrice = function (price) {
      if (stickyPrice) stickyPrice.textContent = price;
    };

    /* Keep sticky image in sync with variant image changes */
    window.__stickyAtcUpdateImg = function (src) {
      if (stickyImg && src) { stickyImg.src = src; }
    };
  })();
})();
</script>
