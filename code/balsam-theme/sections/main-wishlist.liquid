<section class="wishlist-page">
  <div class="container">

    <div class="wishlist-page__header">
      <h1 class="wishlist-page__title">My Wishlist</h1>
      <p class="wishlist-page__subtitle" id="wishlist-count-label"></p>
    </div>

    <!-- Empty state -->
    <div class="wishlist-page__empty" id="wishlist-empty" hidden>
      <div class="wishlist-page__empty-inner">
        <svg class="wishlist-page__empty-icon" width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <path d="M32 54S6 39 6 21a12 12 0 0 1 22-6.74A12 12 0 0 1 58 21C58 39 32 54 32 54z"
            stroke="#C8D5CE" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <h2 class="wishlist-page__empty-heading">Your wishlist is empty</h2>
        <p class="wishlist-page__empty-body">Save your favourite products here and come back to them any time.</p>
        <a href="{{ routes.collections_url }}/all" class="btn btn-primary">Shop All Products</a>
      </div>
    </div>

    <!-- Product grid (JS populated) -->
    <div class="wishlist-page__grid" id="wishlist-grid" hidden></div>

    <!-- Clear all -->
    <div class="wishlist-page__actions" id="wishlist-actions" hidden>
      <button class="btn btn-ghost btn--sm" id="wishlist-clear-all" type="button">Clear all</button>
    </div>

  </div>
</section>

<style>
  .wishlist-page {
    padding-block: var(--section-y-desktop);
    min-height: 60vh;
  }

  .wishlist-page__header {
    margin-bottom: var(--space-12);
    text-align: center;
  }

  .wishlist-page__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--fg);
    letter-spacing: var(--tracking-display);
    margin-bottom: var(--space-2);
  }

  .wishlist-page__subtitle {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* Empty state */
  .wishlist-page__empty {
    display: flex;
    justify-content: center;
    padding-block: var(--space-12);
  }

  .wishlist-page__empty-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 380px;
    text-align: center;
  }

  .wishlist-page__empty-icon {
    opacity: 0.5;
  }

  .wishlist-page__empty-heading {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--fg);
  }

  .wishlist-page__empty-body {
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: var(--leading-body);
  }

  /* Grid */
  .wishlist-page__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  /* Actions */
  .wishlist-page__actions {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-soft);
  }

  @media (max-width: 1023px) {
    .wishlist-page__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 767px) {
    .wishlist-page {
      padding-block: var(--section-y-phone);
    }

    .wishlist-page__title {
      font-size: var(--text-2xl);
    }

    .wishlist-page__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }
</style>

<script>
  (function () {
    const WISHLIST_KEY = 'balsam_wishlist';

    function getWishlist() {
      try { return JSON.parse(localStorage.getItem(WISHLIST_KEY) || '[]'); }
      catch { return []; }
    }

    function saveWishlist(list) {
      localStorage.setItem(WISHLIST_KEY, JSON.stringify(list));
    }

    function formatMoney(cents) {
      return '$' + (cents / 100).toFixed(2);
    }

    function renderCard(p) {
      const variant = p.variants[0];
      const price = formatMoney(variant.price);
      const comparePrice = variant.compare_at_price ? formatMoney(variant.compare_at_price) : null;
      const img = p.images[0] || null;
      const savings = comparePrice
        ? Math.round(((variant.compare_at_price - variant.price) / variant.compare_at_price) * 100)
        : null;

      return `
        <article class="product-card" aria-label="${p.title}">
          <a href="/products/${p.handle}" class="product-card__image-link" tabindex="-1" aria-hidden="true">
            <div class="product-card__image-wrap">
              ${img
                ? `<img src="${img}" alt="${p.title}" width="600" height="600" loading="lazy" class="product-card__img">`
                : `<div class="product-card__placeholder"></div>`
              }
              <button
                class="product-card__wishlist product-card__wishlist--active"
                type="button"
                data-remove-handle="${p.handle}"
                aria-label="Remove from wishlist"
                aria-pressed="true"
              >
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <path d="M9 15.5S1.5 11 1.5 5.5A3.5 3.5 0 0 1 8 3.56 3.5 3.5 0 0 1 16.5 5.5C16.5 11 9 15.5 9 15.5z"
                    fill="var(--accent)" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <a href="/products/${p.handle}" class="product-card__hover-atc btn btn-ghost btn--sm">View Product</a>
            </div>
          </a>
          <div class="product-card__body">
            ${savings ? `<span class="badge product-card__badge product-card__badge--sale">Save ${savings}%</span>` : ''}
            <a href="/products/${p.handle}" class="product-card__name">${p.title}</a>
            <div class="price price--card">
              ${comparePrice
                ? `<span class="price__sale">${price}</span><s class="price__compare">${comparePrice}</s>`
                : `<span class="price__regular">${price}</span>`
              }
            </div>
          </div>
        </article>
      `;
    }

    async function render() {
      const grid = document.getElementById('wishlist-grid');
      const empty = document.getElementById('wishlist-empty');
      const actions = document.getElementById('wishlist-actions');
      const countLabel = document.getElementById('wishlist-count-label');
      if (!grid) return;

      const handles = getWishlist();

      if (handles.length === 0) {
        empty.hidden = false;
        return;
      }

      const results = await Promise.all(
        handles.map(h =>
          fetch(`/products/${h}.js`)
            .then(r => r.ok ? r.json() : null)
            .catch(() => null)
        )
      );

      const products = results.filter(Boolean);

      if (products.length === 0) {
        empty.hidden = false;
        return;
      }

      countLabel.textContent = `${products.length} item${products.length !== 1 ? 's' : ''}`;
      grid.innerHTML = products.map(renderCard).join('');
      grid.hidden = false;
      actions.hidden = false;

      grid.querySelectorAll('[data-remove-handle]').forEach(btn => {
        btn.addEventListener('click', () => {
          const handle = btn.dataset.removeHandle;
          saveWishlist(getWishlist().filter(h => h !== handle));
          btn.closest('.product-card').remove();

          const remaining = grid.querySelectorAll('.product-card').length;
          if (remaining === 0) {
            grid.hidden = true;
            actions.hidden = true;
            empty.hidden = false;
            countLabel.textContent = '0 items';
          } else {
            countLabel.textContent = `${remaining} item${remaining !== 1 ? 's' : ''}`;
          }

          // sync header badge
          if (window.balsamWishlistBadgeUpdate) window.balsamWishlistBadgeUpdate();
        });
      });

      document.getElementById('wishlist-clear-all').addEventListener('click', () => {
        saveWishlist([]);
        grid.hidden = true;
        actions.hidden = true;
        empty.hidden = false;
        countLabel.textContent = '0 items';
        if (window.balsamWishlistBadgeUpdate) window.balsamWishlistBadgeUpdate();
      });
    }

    document.addEventListener('DOMContentLoaded', render);
  })();
</script>

{% schema %}
{
  "name": "Wishlist",
  "limit": 1,
  "settings": [],
  "presets": [
    {
      "name": "Wishlist"
    }
  ]
}
{% endschema %}
