{%- comment -%}
  Renders a sticky-image, scroll-linked "how it's made" process for the current
  product, automatically switching between 5 pre-written category stories
  (Tahini, Oils, Honey, Halawa, Pistachio Spread) based on which collection(s)
  the product belongs to. Each story is 5 steps: steps 1-4 pair a process step
  with a "why it's different" USP line, step 5 is a short Balsam brand intro.
{%- endcomment -%}

{%- assign is_halawa = false -%}
{%- assign is_honey = false -%}
{%- assign is_oils = false -%}
{%- assign is_pistachio = false -%}
{%- for c in product.collections -%}
  {%- case c.handle -%}
    {%- when 'halawas' -%}{%- assign is_halawa = true -%}
    {%- when 'honey' -%}{%- assign is_honey = true -%}
    {%- when 'oils' -%}{%- assign is_oils = true -%}
    {%- when 'pistachio-spreads', 'pure-butters' -%}{%- assign is_pistachio = true -%}
  {%- endcase -%}
{%- endfor -%}

{%- assign category = 'tahini' -%}
{%- if is_halawa -%}
  {%- assign category = 'halawa' -%}
{%- elsif is_honey -%}
  {%- assign category = 'honey' -%}
{%- elsif is_oils -%}
  {%- assign category = 'oils' -%}
{%- elsif is_pistachio -%}
  {%- assign category = 'pistachio' -%}
{%- endif -%}

{%- case category -%}
  {%- when 'oils' -%}
    {%- assign pp_eyebrow = 'OUR PROCESS' -%}
    {%- assign pp_heading = 'How Our Oils Are Made' -%}
  {%- when 'honey' -%}
    {%- assign pp_eyebrow = 'OUR PROCESS' -%}
    {%- assign pp_heading = 'How Our Honey Is Made' -%}
  {%- when 'halawa' -%}
    {%- assign pp_eyebrow = 'OUR PROCESS' -%}
    {%- assign pp_heading = 'How Our Halawa Is Made' -%}
  {%- when 'pistachio' -%}
    {%- assign pp_eyebrow = 'OUR PROCESS' -%}
    {%- assign pp_heading = 'How Our Pistachio Spread Is Made' -%}
  {%- else -%}
    {%- assign pp_eyebrow = 'OUR PROCESS' -%}
    {%- assign pp_heading = 'How Our Tahini Is Made' -%}
{%- endcase -%}

<section class="pp-section section{% if section.settings.bg == 'cream' %} section--cream{% endif %}">

  <div class="pp-section__header container">
    <p class="eyebrow pp-eyebrow">{{ pp_eyebrow }}</p>
    <h2 class="pp-section__heading">{{ pp_heading }}</h2>
  </div>

  <div class="pp-section__inner">

    <!-- Left: sticky image stack -->
    <div class="pp-section__media" aria-hidden="true">
      <div class="pp-section__media-sticky">
        {%- case category -%}

          {%- when 'oils' -%}
            {%- assign pp_images = 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/ingredient-sesame-seeds.jpg?v=1782937673|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Pecan-Oil.jpg?v=1742973312|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Pecan-Oil.jpg?v=1742973312|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Pecan-Oil.jpg?v=1742973312|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Pecan-Oil.jpg?v=1742973312' | split: '|' -%}

          {%- when 'honey' -%}
            {%- assign pp_images = 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/ingredient-honey.jpg?v=1782937673|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/IMG_2434_1.jpg?v=1744733063|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/IMG_2434_1.jpg?v=1744733063|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/IMG_2434_1.jpg?v=1744733063|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/IMG_2434_1.jpg?v=1744733063' | split: '|' -%}

          {%- when 'halawa' -%}
            {%- assign pp_images = 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Plain-Halawa-_1.jpg?v=1743874823|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Plain-Halawa-_1.jpg?v=1743874823|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Pistachio-Halawa.jpg?v=1743874186|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Plain-Halawa-_1.jpg?v=1743874823|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Plain-Halawa-_1.jpg?v=1743874823' | split: '|' -%}

          {%- when 'pistachio' -%}
            {%- assign pp_images = 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/ingredient-pistachios.jpg?v=1782937673|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Pistachio-Spread-with-Milk.jpg?v=1743874327|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/IMG_2664.jpg?v=1745863680|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Pistachio-Spread-with-Milk.jpg?v=1743874327|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Pistachio-Spread-with-Milk.jpg?v=1743874327' | split: '|' -%}

          {%- else -%}
            {%- assign pp_images = 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/ingredient-sesame-seeds.jpg?v=1782937673|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Balsam-Tahini-907g.jpg?v=1743874677|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Balsam-Tahini-907g.jpg?v=1743874677|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Balsam-Tahini-907g.jpg?v=1743874677|https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Balsam-Tahini-907g.jpg?v=1743874677' | split: '|' -%}

        {%- endcase -%}

        {%- for img in pp_images -%}
          <div class="pp-section__img-wrap{% if forloop.first %} pp-img--active{% endif %}" data-pp-img="{{ forloop.index0 }}">
            <img
              src="{{ img }}"
              alt="{{ pp_heading | escape }}"
              width="900" height="900"
              loading="lazy"
              class="pp-section__img"
            >
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Right: scrollable steps -->
    <div class="pp-section__steps">
      {%- case category -%}

        {%- when 'oils' -%}
          {%- render 'process-step', num: '01', title: 'Handpicked Seeds & Nuts', body: 'Every oil starts with whole, unrefined seeds and nuts — sesame, black seed, walnut, pistachio, and more.', usp: 'No seed blends, no reused presscake — just the real thing, pressed one variety at a time.' -%}
          {%- render 'process-step', num: '02', title: 'Cold-Pressed Below 50°C', body: 'We mechanically press each batch at low temperature, with no heat and no solvents.', usp: 'Big-brand oils are often chemically extracted with heat — ours never touches either.' -%}
          {%- render 'process-step', num: '03', title: 'Unrefined & Unfiltered', body: 'We leave the natural sediment in — that is where the real flavour and nutrients live.', usp: "Refining strips out aroma and nutrition to make oil shelf-stable and 'neutral.' We keep the character." -%}
          {%- render 'process-step', num: '04', title: 'Bottled in Small Batches', body: 'Every bottle is pressed to order and bottled fresh, never left to oxidize on a shelf.', usp: 'Freshness fades fast once oil is pressed — small batches mean yours never sits around.' -%}
          {%- render 'process-step', num: '05', title: 'This Is Balsam Tahini', body: 'We started with tahini because we could not find one that tasted like home. That same standard — real ingredients, traditional methods, no shortcuts — goes into every oil we press.', is_brand: true -%}

        {%- when 'honey' -%}
          {%- render 'process-step', num: '01', title: 'Raw, Organic Hives', body: 'Our honey comes from organic apiaries, free from antibiotics and pesticide treatments.', usp: 'Most commercial honey comes from hives treated with chemicals we would never put near our own food.' -%}
          {%- render 'process-step', num: '02', title: 'Never Heated, Never Ultra-Filtered', body: 'We keep our honey raw — no pasteurizing, no ultra-filtering.', usp: 'Heat-treating and ultra-filtering — standard in most grocery-aisle honey — strips out the pollen and enzymes that make raw honey worth having.' -%}
          {%- render 'process-step', num: '03', title: 'Blended with Real Roasted Nuts', body: 'Cashews, pistachios, and pine nuts are folded in by hand, batch by batch.', usp: 'No artificial nut flavouring, no reconstituted nut paste — just real roasted nuts, folded through by hand.' -%}
          {%- render 'process-step', num: '04', title: 'No Added Sugar, Ever', body: 'What you taste is honey, full stop.', usp: 'A lot of cheaper honey is cut with corn syrup or glucose to stretch the jar. Ours never is.' -%}
          {%- render 'process-step', num: '05', title: 'This Is Balsam Tahini', body: 'We built this brand on the idea that real, unprocessed food tastes better. Our honey follows the same rule as our tahini — raw, honest, and never cut with anything that does not belong.', is_brand: true -%}

        {%- when 'halawa' -%}
          {%- render 'process-step', num: '01', title: 'Real Tahini Base', body: 'Every batch of halawa starts with our own stone-ground tahini — not a bought-in bulk paste.', usp: 'Most halawa makers buy generic tahini by the drum. We use the same tahini we sell in the jar.' -%}
          {%- render 'process-step', num: '02', title: 'Slow-Cooked Sugar & Rosewater Syrup', body: 'The syrup is cooked by hand to a precise temperature before it is worked into the tahini.', usp: 'Get the temperature wrong and halawa turns grainy or gummy — precision is what gives it that signature flaky melt.' -%}
          {%- render 'process-step', num: '03', title: 'Hand-Folded, Never Machine-Extruded', body: 'We fold each batch by hand in small runs, which is what creates the flaky strands halawa is known for.', usp: 'Mass-produced halawa is machine-extruded and dense — hand-folding is slower, but it is the only way to get real flakiness.' -%}
          {%- render 'process-step', num: '04', title: 'Real Nuts & Honey, No Artificial Flavour', body: 'Our pistachio, hazelnut, and honey varieties are made with the real ingredient folded in.', usp: 'Many supermarket halawas use corn-syrup-based flavour swirls instead of the real thing. We do not.' -%}
          {%- render 'process-step', num: '05', title: 'This Is Balsam Tahini', body: 'Halawa is where our tahini becomes dessert. It carries the same promise as everything else we make: real ingredients, traditional methods, nothing artificial.', is_brand: true -%}

        {%- when 'pistachio' -%}
          {%- render 'process-step', num: '01', title: 'Real Roasted Pistachios', body: 'We start with whole, roasted pistachios — not a diluted pistachio paste.', usp: 'A lot of "pistachio" spreads are cut with cheaper cashews or almonds. Ours is pistachio, full stop.' -%}
          {%- render 'process-step', num: '02', title: 'Stone-Ground Low & Slow', body: 'We grind slowly to a smooth, spreadable texture without overheating the nuts.', usp: 'Overheating cooks off the natural pistachio oils and flavour — low and slow keeps both intact.' -%}
          {%- render 'process-step', num: '03', title: 'Naturally Green, No Food Colouring', body: 'That vibrant green comes from real pistachio skins, not a dye.', usp: 'Many pistachio products add artificial colouring to look more vibrant on the shelf. We let the pistachio speak for itself.' -%}
          {%- render 'process-step', num: '04', title: '6 Clean Ingredients, No Palm Oil', body: 'Just pistachios, a touch of sugar, and natural stabilizers — nothing else.', usp: 'No palm oil, no hydrogenated fat — ingredients most mass-market spreads rely on to stay shelf-stable.' -%}
          {%- render 'process-step', num: '05', title: 'This Is Balsam Tahini', body: 'Pistachio spread is our boldest flavour, but it\'s built on the same standard as our tahini: real ingredients, stone-ground the slow way, nothing hidden in the jar.', is_brand: true -%}

        {%- else -%}
          {%- render 'process-step', num: '01', title: 'Real Humera Sesame Seeds', body: 'We start with whole Ethiopian Humera sesame seeds — prized for their high oil content and rich, nutty flavour.', usp: 'Most mass-market tahini uses cheaper decorticated seed blends. We do not cut corners on the seed.' -%}
          {%- render 'process-step', num: '02', title: 'Slow Stone-Ground, Never Machine-Milled', body: 'Our sesame is ground slowly between traditional stone mills at cool temperatures.', usp: 'High-speed steel mills overheat the paste, cooking out flavour and turning it bitter — ours never does.' -%}
          {%- render 'process-step', num: '03', title: 'Small Batches, Always Fresh', body: 'Every batch is milled in small runs, then jarred and shipped within days.', usp: 'No sitting in a warehouse for months before it reaches your shelf.' -%}
          {%- render 'process-step', num: '04', title: 'Zero Additives, Zero Shortcuts', body: 'Just 100% stone-ground sesame — nothing else goes in the jar.', usp: 'Many competitors add vegetable oil to stretch the batch and mask bitterness. We never do.' -%}
          {%- render 'process-step', num: '05', title: 'This Is Balsam Tahini', body: 'Tahini was on our table every single meal growing up. When we moved to Canada and could not find one that tasted like home, we partnered with traditional stone mills to make our own. That is the tahini in your hands today.', is_brand: true -%}

      {%- endcase -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Process",
  "settings": [
    {
      "type": "select", "id": "bg", "label": "Background", "default": "canvas",
      "options": [
        { "value": "canvas", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ]
    }
  ],
  "presets": [
    { "name": "Product Process" }
  ]
}
{% endschema %}

<style>
  .pp-section { padding: 0; }

  .pp-section__header {
    text-align: center;
    padding: var(--space-16) var(--container-gutter-desktop, 40px) var(--space-10);
  }
  .pp-eyebrow { margin-bottom: var(--space-2); }
  .pp-section__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 700;
    color: var(--fg);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    margin-bottom: 0;
  }

  .pp-section__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }

  .pp-section__media {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }
  .pp-section__media-sticky { position: relative; width: 100%; height: 100%; }

  .pp-section__img-wrap { position: absolute; inset: 0; opacity: 0; transition: opacity 0.6s ease; }
  .pp-section__img-wrap.pp-img--active { opacity: 1; }
  .pp-section__img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .pp-section__steps { padding: 0 var(--container-gutter-desktop, 40px) 120px 64px; }

  .pp-step {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 0;
    border-bottom: 1px solid var(--border);
  }
  .pp-step:last-child { border-bottom: none; }

  .pp-step-num {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-4);
  }
  .pp-step-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 700;
    color: var(--fg);
    line-height: 1.2;
    margin-bottom: var(--space-5);
  }
  .pp-step-body {
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--fg-2);
    max-width: 480px;
    margin-bottom: var(--space-5);
  }

  /* USP callout — the "why it's different" line on steps 1-4 */
  .pp-step-usp {
    max-width: 480px;
    padding: var(--space-4) var(--space-5);
    border-left: 3px solid var(--accent);
    background: var(--surface-warm, #F5F0E8);
    border-radius: 0 var(--radius-md, 8px) var(--radius-md, 8px) 0;
    font-size: var(--text-sm);
    color: var(--fg);
    line-height: 1.6;
  }
  .pp-step-usp strong {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-1);
  }

  /* Step 5 — brand intro, styled like a mission quote */
  .pp-step--brand .pp-step-body {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-style: italic;
    color: var(--fg);
    line-height: 1.6;
    padding-top: var(--space-5);
    border-top: 2px solid var(--accent);
  }

  @media (max-width: 959px) {
    .pp-section__inner { display: block; }
    .pp-section__media { position: sticky; top: 0; height: 56vw; min-height: 260px; max-height: 400px; z-index: 10; }
    .pp-section__steps { padding: 0; position: relative; z-index: 5; background: var(--bg); }
    .section--cream .pp-section__steps { background: var(--surface-warm); }
    .pp-step { min-height: auto; padding: 48px var(--container-gutter-phone, 16px); justify-content: flex-start; }
    .pp-step-body, .pp-step-usp { max-width: 100%; }
  }
</style>

<script>
(function () {
  document.querySelectorAll('.pp-section').forEach(function (section) {
    var steps = Array.prototype.slice.call(section.querySelectorAll('[data-pp-step]'));
    var imgs  = Array.prototype.slice.call(section.querySelectorAll('[data-pp-img]'));
    if (steps.length < 1) return;

    var current = 0;

    function activate(index) {
      if (index === current) return;
      if (imgs[current]) imgs[current].classList.remove('pp-img--active');
      if (imgs[index])   imgs[index].classList.add('pp-img--active');
      current = index;
    }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          activate(parseInt(entry.target.dataset.ppStep, 10));
        }
      });
    }, { rootMargin: '-20% 0px -20% 0px', threshold: 0 });

    steps.forEach(function (step) { observer.observe(step); });
  });
})();
</script>
