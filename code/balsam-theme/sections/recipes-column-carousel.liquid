{% style %}
  .rcc {
    position: relative;
    overflow: hidden;
    background: var(--surface-warm, #F5F0E8);
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .rcc__header {
    text-align: center;
    margin-bottom: var(--space-10);
    position: relative;
    z-index: 2;
  }
  .rcc__header .eyebrow { margin-bottom: var(--space-2); }
  .rcc__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    color: var(--fg);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
  }
  .rcc__title em {
    font-style: italic;
    display: block;
  }

  .rcc__stage { position: relative; }

  .rcc__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-inline: max(var(--container-gutter-desktop, 40px), calc((100vw - 1200px) / 2 + 40px));
    padding-bottom: var(--space-2);
  }
  .rcc__track::-webkit-scrollbar { display: none; }

  .rcc__slide {
    flex: 0 0 320px;
    scroll-snap-align: center;
    transition: opacity 0.35s ease;
    opacity: 0.3;
    cursor: pointer;
  }
  .rcc__slide--active { opacity: 1; }

  .rcc__slide-inner {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
    border-radius: 20px;
    overflow: hidden;
  }

  .rcc__img-wrap {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 20px;
    background: var(--border-soft);
  }
  .rcc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .rcc__slide--active .rcc__img { transform: scale(1.03); }

  .rcc__caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-8) var(--space-5) var(--space-5);
    background: linear-gradient(to top, rgba(0,0,0,0.62) 0%, transparent 100%);
    border-radius: 0 0 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .rcc__caption-tag {
    align-self: flex-start;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent, #1B4332);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
  }
  .rcc__caption-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
  }
  .rcc__caption-cta {
    font-size: var(--text-xs);
    font-weight: 600;
    color: rgba(255,255,255,0.75);
    letter-spacing: 0.04em;
  }

  /* Nav arrows — Graza-style */
  .rcc__nav {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 80px; height: 80px;
    border: 1.5px solid var(--fg);
    border-radius: 10px;
    background: transparent;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--fg);
    transition: background 0.2s, color 0.2s;
  }
  .rcc__nav:hover {
    background: var(--fg);
    color: var(--surface-warm, #F5F0E8);
  }
  .rcc__nav--prev { left: var(--container-gutter-desktop, 40px); }
  .rcc__nav--next { right: var(--container-gutter-desktop, 40px); }

  .rcc__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: var(--space-5);
  }
  .rcc__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--border);
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    padding: 0;
  }
  .rcc__dot--active {
    background: var(--accent);
    transform: scale(1.25);
  }

  @media (min-width: 1024px) {
    .rcc__slide { flex: 0 0 360px; }
    .rcc__nav { display: flex; }
    .rcc__dots { display: none; }
  }
  @media (max-width: 767px) {
    .rcc__track { padding-inline: var(--container-gutter-phone, 16px); }
    .rcc__slide { flex: 0 0 78vw; }
    .rcc__title { font-size: 2rem; }
  }
{% endstyle %}

{%- assign blog_handle = section.settings.blog | default: 'recipes' -%}
{%- assign rcc_blog = blogs[blog_handle] -%}
{%- assign article_limit = section.settings.articles_count | default: 6 -%}

<section class="rcc" id="rcc-{{ section.id }}">

  <div class="container rcc__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="rcc__title">
      {%- if section.settings.heading_italic != blank -%}
        <em>{{ section.settings.heading_italic }}</em>
      {%- endif -%}
      {{ section.settings.heading | default: 'Recipes' }}
    </h2>
  </div>

  <div class="rcc__stage">
    <div class="rcc__track" id="rcc-track-{{ section.id }}">

      {%- if rcc_blog != blank and rcc_blog.articles.size > 0 -%}
        {%- for article in rcc_blog.articles limit: article_limit -%}
          <div
            class="rcc__slide{% if forloop.first %} rcc__slide--active{% endif %}"
            data-index="{{ forloop.index0 }}"
          >
            <a href="{{ article.url }}" class="rcc__slide-inner">
              <div class="rcc__img-wrap">
                {%- if article.image -%}
                  <img
                    src="{{ article.image | image_url: width: 720 }}"
                    srcset="{{ article.image | image_url: width: 360 }} 360w, {{ article.image | image_url: width: 720 }} 720w"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    width="360" height="450"
                    loading="lazy"
                    class="rcc__img"
                  >
                {%- else -%}
                  <div style="width:100%;height:100%;background:var(--surface-warm);"></div>
                {%- endif -%}
              </div>
              <div class="rcc__caption">
                {%- if section.settings.show_tags and article.tags.size > 0 -%}
                  <span class="rcc__caption-tag">{{ article.tags | first }}</span>
                {%- endif -%}
                <span class="rcc__caption-title">{{ article.title }}</span>
                <span class="rcc__caption-cta">{{ section.settings.cta_label | default: 'Read recipe →' }}</span>
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="rcc__slide{% if forloop.first %} rcc__slide--active{% endif %}">
            <div class="rcc__slide-inner">
              <div class="rcc__img-wrap" style="background:var(--border-soft);"></div>
              <div class="rcc__caption">
                <span class="rcc__caption-title">Recipe {{ i }}</span>
                <span class="rcc__caption-cta">Read recipe →</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}

    </div>

    <!-- Nav arrows (desktop) -->
    <button class="rcc__nav rcc__nav--prev" id="rcc-prev-{{ section.id }}" aria-label="Previous" type="button">
      <svg width="19" height="8" viewBox="0 0 19 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M13.5805 8.00004L13.7005 7.84004C13.5538 7.41337 13.3671 6.97337 13.1405 6.52004C12.9005 6.06671 12.6471 5.64004 12.3805 5.24004C12.1005 4.84004 11.8338 4.50671 11.5805 4.24004L18.9805 4.68004V3.32004L11.5805 3.80004C11.8471 3.52004 12.1205 3.18004 12.4005 2.78004C12.6805 2.36671 12.9338 1.93337 13.1605 1.48004C13.3871 1.02671 13.5671 0.600039 13.7005 0.200039L13.5805 0.0400391C12.9938 0.400039 12.2805 0.760039 11.4405 1.12004C10.6005 1.48004 9.70714 1.82004 8.76047 2.14004C7.80047 2.46004 6.84047 2.75337 5.88047 3.02004C4.92047 3.27337 4.0138 3.48671 3.16047 3.66004C2.2938 3.82004 1.54047 3.92004 0.900469 3.96004V4.04004C1.52714 4.08004 2.26713 4.18671 3.12047 4.36004C3.96047 4.52004 4.86047 4.73337 5.82047 5.00004C6.78047 5.25337 7.74047 5.54671 8.70047 5.88004C9.64714 6.20004 10.5471 6.54004 11.4005 6.90004C12.2405 7.26004 12.9671 7.62671 13.5805 8.00004Z" fill="currentColor"/>
      </svg>
    </button>
    <button class="rcc__nav rcc__nav--next" id="rcc-next-{{ section.id }}" aria-label="Next" type="button">
      <svg width="19" height="8" viewBox="0 0 19 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M5.41953 8.00004L5.29953 7.84004C5.4462 7.41337 5.63286 6.97337 5.85953 6.52004C6.09953 6.06671 6.35287 5.64004 6.61953 5.24004C6.89953 4.84004 7.1662 4.50671 7.41953 4.24004L0.0195313 4.68004L0.0195313 3.32004L7.41953 3.80004C7.15287 3.52004 6.87953 3.18004 6.59953 2.78004C6.31953 2.36671 6.0662 1.93337 5.83953 1.48004C5.61286 1.02671 5.43287 0.600039 5.29953 0.200039L5.41953 0.0400391C6.0062 0.400039 6.71953 0.760039 7.55953 1.12004C8.39953 1.48004 9.29286 1.82004 10.2395 2.14004C11.1995 2.46004 12.1595 2.75337 13.1195 3.02004C14.0795 3.27337 14.9862 3.48671 15.8395 3.66004C16.7062 3.82004 17.4595 3.92004 18.0995 3.96004V4.04004C17.4729 4.08004 16.7329 4.18671 15.8795 4.36004C15.0395 4.52004 14.1395 4.73337 13.1795 5.00004C12.2195 5.25337 11.2595 5.54671 10.2995 5.88004C9.35286 6.20004 8.45287 6.54004 7.59953 6.90004C6.75953 7.26004 6.03286 7.62671 5.41953 8.00004Z" fill="currentColor"/>
      </svg>
    </button>

  </div>

  <!-- Pagination dots (mobile) -->
  <div class="rcc__dots" id="rcc-dots-{{ section.id }}" aria-hidden="true"></div>

</section>

<script>
(function () {
  var track  = document.getElementById('rcc-track-{{ section.id }}');
  var prev   = document.getElementById('rcc-prev-{{ section.id }}');
  var next   = document.getElementById('rcc-next-{{ section.id }}');
  var dotsEl = document.getElementById('rcc-dots-{{ section.id }}');
  if (!track) return;

  var slides  = Array.from(track.querySelectorAll('.rcc__slide'));
  var current = 0;

  slides.forEach(function (_, i) {
    var dot = document.createElement('button');
    dot.className = 'rcc__dot' + (i === 0 ? ' rcc__dot--active' : '');
    dot.setAttribute('type', 'button');
    dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
    dot.addEventListener('click', function () { goTo(i); });
    dotsEl.appendChild(dot);
  });

  function updateSlides() {
    var dots = dotsEl.querySelectorAll('.rcc__dot');
    slides.forEach(function (slide, i) {
      slide.classList.toggle('rcc__slide--active', i === current);
    });
    dots.forEach(function (dot, i) {
      dot.classList.toggle('rcc__dot--active', i === current);
    });
  }

  function goTo(idx) {
    current = (idx + slides.length) % slides.length;
    var slide      = slides[current];
    var slideLeft  = slide.offsetLeft;
    var slideWidth = slide.offsetWidth;
    var trackWidth = track.clientWidth;
    track.scrollTo({ left: slideLeft - (trackWidth / 2) + (slideWidth / 2), behavior: 'smooth' });
    updateSlides();
  }

  if (prev) prev.addEventListener('click', function () { goTo(current - 1); });
  if (next) next.addEventListener('click', function () { goTo(current + 1); });

  slides.forEach(function (slide, i) {
    slide.addEventListener('click', function (e) {
      if (i !== current) { e.preventDefault(); goTo(i); }
    });
  });

  var touchX = 0;
  track.addEventListener('touchstart', function (e) { touchX = e.touches[0].clientX; }, { passive: true });
  track.addEventListener('touchend', function (e) {
    var diff = touchX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
  }, { passive: true });

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
        var idx = slides.indexOf(entry.target);
        if (idx !== -1 && idx !== current) { current = idx; updateSlides(); }
      }
    });
  }, { root: track, threshold: 0.5 });

  slides.forEach(function (slide) { io.observe(slide); });

  goTo(0);
})();
</script>

{% schema %}
{
  "name": "Recipes Column Carousel",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Recipes blog" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FROM OUR KITCHEN" },
    { "type": "text", "id": "heading_italic", "label": "Heading italic line", "default": "Make something with" },
    { "type": "text", "id": "heading", "label": "Heading main line", "default": "Our Recipes" },
    { "type": "range", "id": "articles_count", "label": "Number of recipes", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_tags", "label": "Show article tag badge", "default": true },
    { "type": "text", "id": "cta_label", "label": "Slide CTA text", "default": "Read recipe →" }
  ],
  "presets": [
    {
      "name": "Recipes Column Carousel"
    }
  ]
}
{% endschema %}
