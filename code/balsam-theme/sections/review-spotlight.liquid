<section class="review-spotlight section{% if section.settings.bg == 'cream' %} section--cream{% endif %}">
  <div class="container">

    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow rs-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title rs-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="rs-carousel" aria-label="Customer reviews">

        <div class="rs-track" id="rs-track-{{ section.id }}">
          {%- for block in section.blocks -%}
            <div
              class="rs-slide{% if forloop.first %} rs-slide--active{% endif %}"
              role="group"
              aria-label="Review {{ forloop.index }} of {{ section.blocks.size }}"
              {{ block.shopify_attributes }}
              {% unless forloop.first %}hidden{% endunless %}
            >
              {%- assign rating = block.settings.rating | default: 5 -%}
              <div class="rs-slide__stars" aria-label="{{ rating }} out of 5 stars">
                {%- for i in (1..5) -%}
                  {%- if i <= rating -%}★{%- else -%}☆{%- endif -%}
                {%- endfor -%}
              </div>
              <blockquote class="rs-slide__text">"{{ block.settings.text }}"</blockquote>
              <div class="rs-slide__meta">
                <span class="rs-slide__author">{{ block.settings.author }}</span>
                {%- if block.settings.verified -%}
                  <span class="rs-slide__verified">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                    Verified Buyer
                  </span>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 -%}
          <div class="rs-controls">
            <button class="rs-nav-btn" type="button" data-rs-prev aria-label="Previous review">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <div class="rs-dots" aria-hidden="true">
              {%- for block in section.blocks -%}
                <button
                  class="rs-dot{% if forloop.first %} rs-dot--active{% endif %}"
                  type="button"
                  data-rs-index="{{ forloop.index0 }}"
                  aria-label="Go to review {{ forloop.index }}"
                ></button>
              {%- endfor -%}
            </div>
            <button class="rs-nav-btn" type="button" data-rs-next aria-label="Next review">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Review Spotlight",
  "max_blocks": 12,
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "default": "canvas",
      "options": [
        { "value": "canvas", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "WHAT CUSTOMERS SAY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Reviews from Real People" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text", "default": "Absolutely love this tahini — rich, creamy, and the best I've ever tried." },
        { "type": "text", "id": "author", "label": "Reviewer name", "default": "Sarah M." },
        { "type": "checkbox", "id": "verified", "label": "Show verified buyer badge", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Review Spotlight",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "text": "Absolutely love this tahini — rich, creamy, and the best I've ever tried.", "author": "Sarah M.", "verified": true } },
        { "type": "review", "settings": { "rating": 5, "text": "Stone-ground difference is real. Completely different texture than anything from the store.", "author": "Ahmed K.", "verified": true } },
        { "type": "review", "settings": { "rating": 5, "text": "I put it in everything — smoothies, dressings, straight from the jar. Clean ingredients, amazing quality.", "author": "Jennifer L.", "verified": true } }
      ]
    }
  ]
}
{% endschema %}

<style>
  .review-spotlight { padding: var(--space-16) 0; }
  .rs-eyebrow { text-align: center; margin-bottom: var(--space-2); }
  .rs-heading { text-align: center; margin-bottom: var(--space-10); }

  .rs-carousel { max-width: 680px; margin: 0 auto; }

  .rs-slide {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 40px 48px;
    text-align: center;
  }
  .rs-slide[hidden] { display: none; }

  .rs-slide__stars {
    font-size: 1.4rem;
    color: #E8A020;
    letter-spacing: 3px;
    margin-bottom: 20px;
    display: block;
  }
  .rs-slide__text {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--fg-2);
    font-style: italic;
    margin: 0 0 28px;
  }
  .rs-slide__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .rs-slide__author { font-weight: 700; font-size: 0.9rem; color: var(--fg); }
  .rs-slide__verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #fff;
    background: var(--accent);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }

  .rs-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .rs-nav-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--fg-2);
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .rs-nav-btn:hover { border-color: var(--accent); color: var(--accent); background: rgba(27,67,50,0.04); }

  .rs-dots { display: flex; gap: 6px; align-items: center; }
  .rs-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }
  .rs-dot--active { background: var(--accent); transform: scale(1.3); }

  @media (max-width: 599px) {
    .rs-slide { padding: 28px 24px; }
    .rs-slide__text { font-size: 1rem; }
  }
</style>

<script>
(function () {
  var section = document.querySelector('.review-spotlight');
  if (!section) return;

  var slides = Array.prototype.slice.call(section.querySelectorAll('.rs-slide'));
  var dots   = Array.prototype.slice.call(section.querySelectorAll('.rs-dot'));
  var prevBtn = section.querySelector('[data-rs-prev]');
  var nextBtn = section.querySelector('[data-rs-next]');
  if (slides.length < 2) return;

  var current = 0;

  function goTo(index) {
    slides[current].hidden = true;
    slides[current].classList.remove('rs-slide--active');
    if (dots[current]) dots[current].classList.remove('rs-dot--active');
    current = (index + slides.length) % slides.length;
    slides[current].hidden = false;
    slides[current].classList.add('rs-slide--active');
    if (dots[current]) dots[current].classList.add('rs-dot--active');
  }

  if (prevBtn) prevBtn.addEventListener('click', function () { goTo(current - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { goTo(current + 1); });
  dots.forEach(function (dot) {
    dot.addEventListener('click', function () { goTo(parseInt(dot.dataset.rsIndex, 10)); });
  });
})();
</script>
