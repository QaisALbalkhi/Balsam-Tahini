{% style %}
  /* ── Section ── */
  .ss2 {
    background: var(--surface-warm, #F5F0E8);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  /* ── Each row ── */
  .ss2-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 80vh;
    border-bottom: 1px solid var(--border);
  }
  .ss2-row:last-child { border-bottom: none; }

  /* ── Left: image pane ── */
  .ss2-row__img-pane {
    position: relative;
    overflow: hidden;
    background: var(--border-soft);
  }
  .ss2-row__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .ss2-row:hover .ss2-row__img { transform: scale(1.04); }
  .ss2-row__img-placeholder {
    width: 100%;
    height: 100%;
    min-height: 60vh;
    background: linear-gradient(135deg, var(--surface-warm) 0%, var(--border-soft) 100%);
  }

  /* ── Right: text pane ── */
  .ss2-row__text-pane {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-16) var(--space-12);
    gap: var(--space-5);
  }

  /* Eyebrow / step number */
  .ss2-row__eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Heading */
  .ss2-row__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 700;
    color: var(--fg);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    margin: 0;
  }
  .ss2-row__heading em { font-style: italic; }

  /* Oval badge — exactly like Graza */
  .ss2-row__badge {
    display: inline-block;
    border: 1.5px solid var(--fg);
    border-radius: var(--radius-pill);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg);
    padding: 5px 18px;
    align-self: flex-start;
  }

  /* Meta line */
  .ss2-row__meta {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg);
    margin: 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }

  /* Body */
  .ss2-row__body {
    font-size: var(--text-base);
    color: var(--fg-2);
    line-height: 1.75;
    max-width: 480px;
  }
  .ss2-row__body p { margin-bottom: var(--space-3); }
  .ss2-row__body p:last-child { margin-bottom: 0; }
  .ss2-row__body strong { color: var(--fg); font-weight: 700; }

  /* Optional CTA link */
  .ss2-row__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    margin-top: var(--space-2);
    transition: gap 0.18s;
  }
  .ss2-row__cta:hover { gap: 10px; }

  /* ── Section header (above rows) ── */
  .ss2-header {
    text-align: center;
    padding: var(--space-14) var(--container-gutter-desktop, 40px) 0;
  }
  .ss2-header .eyebrow { margin-bottom: var(--space-2); }
  .ss2-header__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    color: var(--fg);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
    margin-bottom: var(--space-12);
  }
  .ss2-header__heading em { font-style: italic; }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .ss2-row {
      grid-template-columns: 1fr;
      min-height: unset;
    }
    .ss2-row__img-pane {
      aspect-ratio: 4 / 3;
      min-height: unset;
    }
    .ss2-row__text-pane {
      padding: var(--space-8) var(--container-gutter-phone, 20px);
      gap: var(--space-4);
    }
    .ss2-row__heading { font-size: 1.9rem; }
    .ss2-row__body { max-width: 100%; }
    .ss2-header {
      padding: var(--space-10) var(--container-gutter-phone, 20px) 0;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .ss2-row__text-pane { padding: var(--space-10) var(--space-8); }
  }
{% endstyle %}

<section class="ss2" id="ss2-{{ section.id }}">

  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="ss2-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ss2-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'row' -%}
      <div class="ss2-row" {{ block.shopify_attributes }}>

        <!-- Image — left -->
        <div class="ss2-row__img-pane">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
              sizes="(max-width: 767px) 100vw, 50vw"
              alt="{{ block.settings.heading | strip_html | escape }}"
              width="900" height="675"
              loading="lazy"
              class="ss2-row__img"
            >
          {%- else -%}
            <div class="ss2-row__img-placeholder"></div>
          {%- endif -%}
        </div>

        <!-- Text — right -->
        <div class="ss2-row__text-pane">

          {%- if block.settings.eyebrow != blank -%}
            <p class="ss2-row__eyebrow">{{ block.settings.eyebrow }}</p>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3 class="ss2-row__heading">{{ block.settings.heading }}</h3>
          {%- endif -%}

          {%- if block.settings.badge != blank -%}
            <span class="ss2-row__badge">{{ block.settings.badge }}</span>
          {%- endif -%}

          {%- if block.settings.meta != blank -%}
            <p class="ss2-row__meta">{{ block.settings.meta }}</p>
          {%- endif -%}

          {%- if block.settings.body != blank -%}
            <div class="ss2-row__body">{{ block.settings.body }}</div>
          {%- endif -%}

          {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
            <a href="{{ block.settings.cta_url }}" class="ss2-row__cta">
              {{ block.settings.cta_label }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          {%- endif -%}

        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

</section>

{% schema %}
{
  "name": "Scroll Story",
  "settings": [
    { "type": "text",     "id": "eyebrow",  "label": "Section eyebrow", "default": "OUR STORY" },
    { "type": "textarea", "id": "heading",  "label": "Section heading (supports <em> italic)", "default": "1 Sesame<br><em>Two very different</em> products" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Story row",
      "settings": [
        { "type": "image_picker", "id": "image",      "label": "Image (left)" },
        { "type": "text",         "id": "eyebrow",    "label": "Eyebrow / step",    "default": "STEP 01" },
        { "type": "textarea",     "id": "heading",    "label": "Heading (supports <em> italic)", "default": "<em>Stone-ground</em> Tahini" },
        { "type": "text",         "id": "badge",      "label": "Oval badge label",  "default": "THE CLASSIC" },
        { "type": "text",         "id": "meta",       "label": "Meta line (uppercase)", "default": "COLD-PRESSED · SMALL BATCH" },
        { "type": "richtext",     "id": "body",       "label": "Body text" },
        { "type": "text",         "id": "cta_label",  "label": "CTA button label" },
        { "type": "url",          "id": "cta_url",    "label": "CTA link" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Scroll Story",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "eyebrow": "STEP 01",
            "heading": "<em>Stone-ground</em> Tahini",
            "badge": "THE CLASSIC",
            "meta": "COLD-PRESSED · SMALL BATCH"
          }
        },
        {
          "type": "row",
          "settings": {
            "eyebrow": "STEP 02",
            "heading": "Pistachio <em>Spread</em>",
            "badge": "THE BOLD ONE",
            "meta": "ROASTED · STONE-GROUND"
          }
        }
      ]
    }
  ]
}
{% endschema %}
