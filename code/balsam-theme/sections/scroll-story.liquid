{% style %}
  /* ── Section — inherits alternating bg from .shopify-section wrapper ── */
  .ss2 {
    background: inherit;
  }

  /* ── Each row ── */
  .ss2-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 0;
    padding-block: var(--space-14);
    padding-inline: max(
      var(--container-gutter-desktop, 40px),
      calc((100vw - var(--container-max, 1200px)) / 2 + var(--container-gutter-desktop, 40px))
    );
  }

  /* Alternating: even rows flip to media-left / text-right */
  .ss2-row:nth-child(even) .ss2-row__text-col { order: 2; }
  .ss2-row:nth-child(even) .ss2-row__media-col { order: 1; }

  /* ── Text column ── */
  .ss2-row__text-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: var(--space-8) var(--space-10);
    gap: var(--space-4);
  }

  .ss2-row__eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ss2-row__heading {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.6rem);
    font-weight: 700;
    color: var(--fg);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    margin: 0;
  }
  .ss2-row__heading em { font-style: italic; }

  .ss2-row__badge {
    display: inline-block;
    border: 1.5px solid var(--fg);
    border-radius: var(--radius-pill);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg);
    padding: 4px 16px;
  }

  .ss2-row__meta {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--fg);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    width: 100%;
    text-align: center;
    margin: 0;
  }

  .ss2-row__body {
    font-size: var(--text-base);
    color: var(--fg-2);
    line-height: 1.75;
    max-width: 380px;
  }
  .ss2-row__body p { margin-bottom: var(--space-3); }
  .ss2-row__body p:last-child { margin-bottom: 0; }
  .ss2-row__body strong { color: var(--fg); font-weight: 700; }

  .ss2-row__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    transition: gap 0.18s;
  }
  .ss2-row__cta:hover { gap: 10px; }

  /* ── Media column ── */
  .ss2-row__media-col {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }

  .ss2-row__media-wrap {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 3 / 4;
    border-radius: 20px;
    overflow: hidden;
    background: var(--border-soft);
    position: relative;
  }

  .ss2-row__img,
  .ss2-row__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Section header ── */
  .ss2-header {
    text-align: center;
    padding-block: var(--space-14) var(--space-4);
    padding-inline: max(
      var(--container-gutter-desktop, 40px),
      calc((100vw - var(--container-max, 1200px)) / 2 + var(--container-gutter-desktop, 40px))
    );
  }
  .ss2-header .eyebrow { margin-bottom: var(--space-2); }
  .ss2-header__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    color: var(--fg);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
  }
  .ss2-header__heading em { font-style: italic; }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .ss2-row {
      grid-template-columns: 1fr;
      padding: var(--space-6) var(--container-gutter-phone, 20px);
      gap: var(--space-5);
    }
    .ss2-row:nth-child(even) .ss2-row__text-col,
    .ss2-row:nth-child(even) .ss2-row__media-col { order: unset; }
    /* On mobile always: text first, media below */
    .ss2-row__text-col  { order: 1; padding: var(--space-2) 0; }
    .ss2-row__media-col { order: 2; padding: 0; }
    .ss2-row__media-wrap { max-width: 100%; }
    .ss2-row__body { max-width: 100%; }
    .ss2-header { padding: var(--space-10) var(--container-gutter-phone, 20px) 0; }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .ss2-row { padding-block: var(--space-10); padding-inline: var(--container-gutter-tablet, 24px); }
    .ss2-row__text-col { padding: var(--space-6) var(--space-6); }
    .ss2-header { padding-block: var(--space-10) 0; padding-inline: var(--container-gutter-tablet, 24px); }
  }
{% endstyle %}

{%- assign is_halawa = false -%}
{%- assign is_honey = false -%}
{%- assign is_oils = false -%}
{%- assign is_pistachio = false -%}
{%- for c in product.collections -%}
  {%- case c.handle -%}
    {%- when 'halawas' -%}{%- assign is_halawa = true -%}
    {%- when 'honey' -%}{%- assign is_honey = true -%}
    {%- when 'oils' -%}{%- assign is_oils = true -%}
    {%- when 'pistachio-spreads', 'pure-butters' -%}{%- assign is_pistachio = true -%}
  {%- endcase -%}
{%- endfor -%}

{%- assign category = 'tahini' -%}
{%- if is_halawa -%}
  {%- assign category = 'halawa' -%}
{%- elsif is_honey -%}
  {%- assign category = 'honey' -%}
{%- elsif is_oils -%}
  {%- assign category = 'oils' -%}
{%- elsif is_pistachio -%}
  {%- assign category = 'pistachio' -%}
{%- endif -%}

{%- case category -%}
  {%- when 'oils' -%}
    {%- assign ss2_heading = 'How Our <em>Oils</em> Are Made' -%}
  {%- when 'honey' -%}
    {%- assign ss2_heading = 'How Our <em>Honey</em> Is Made' -%}
  {%- when 'halawa' -%}
    {%- assign ss2_heading = 'How Our <em>Halawa</em> Is Made' -%}
  {%- when 'pistachio' -%}
    {%- assign ss2_heading = 'How Our <em>Pistachio Spread</em> Is Made' -%}
  {%- else -%}
    {%- assign ss2_heading = 'How Our <em>Tahini</em> Is Made' -%}
{%- endcase -%}

<section class="ss2" id="ss2-{{ section.id }}">

  <div class="ss2-header">
    <p class="eyebrow">OUR PROCESS</p>
    <h2 class="ss2-header__heading">{{ ss2_heading }}</h2>
  </div>

  {%- case category -%}

    {%- when 'oils' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/ingredient-sesame-seeds.jpg?v=1782937673', eyebrow: 'STEP 01', heading: 'Handpicked Seeds & Nuts', badge: 'NO SEED BLENDS', body: '<p>Every oil starts with whole, unrefined seeds and nuts — sesame, black seed, walnut, pistachio, and more.</p><p>No reused presscake — just the real thing, pressed one variety at a time.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Pecan-Oil.jpg?v=1742973312', eyebrow: 'STEP 02', heading: 'Cold-Pressed Below 50°C', badge: 'NO HEAT, NO SOLVENTS', body: '<p>We mechanically press each batch at low temperature, with no heat and no solvents.</p><p>Big-brand oils are often chemically extracted with heat — ours never touches either.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Pecan-Oil.jpg?v=1742973312', eyebrow: 'STEP 03', heading: 'Unrefined & Unfiltered', badge: 'NOTHING STRIPPED OUT', body: '<p>We leave the natural sediment in — that is where the real flavour and nutrients live.</p><p>Refining strips out aroma and nutrition to make oil shelf-stable and "neutral." We keep the character.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Pecan-Oil.jpg?v=1742973312', eyebrow: 'STEP 04', heading: 'Bottled in Small Batches', badge: 'PRESSED TO ORDER', body: '<p>Every bottle is pressed to order and bottled fresh, never left to oxidize on a shelf.</p><p>Freshness fades fast once oil is pressed — small batches mean yours never sits around.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/Pecan-Oil.jpg?v=1742973312', eyebrow: 'OUR STORY', heading: 'This Is <em>Balsam Tahini</em>', body: '<p>We started with tahini because we could not find one that tasted like home. That same standard — real ingredients, traditional methods, no shortcuts — goes into every oil we press.</p>', cta_label: 'Shop Oils', cta_url: '/collections/oils' -%}

    {%- when 'honey' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/ingredient-honey.jpg?v=1782937673', eyebrow: 'STEP 01', heading: 'Raw, Organic Hives', badge: 'CHEMICAL-FREE', body: '<p>Our honey comes from organic apiaries, free from antibiotics and pesticide treatments.</p><p>Most commercial honey comes from hives treated with chemicals we would never put near our own food.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/honey-cashews-cropped.jpg?v=1782960864', eyebrow: 'STEP 02', heading: 'Never Heated, Never Ultra-Filtered', badge: 'STAYS RAW', body: '<p>We keep our honey raw — no pasteurizing, no ultra-filtering.</p><p>Heat-treating and ultra-filtering — standard in most grocery-aisle honey — strips out the pollen and enzymes that make raw honey worth having.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/honey-cashews-cropped.jpg?v=1782960864', eyebrow: 'STEP 03', heading: 'Blended with Real Roasted Nuts', badge: 'REAL NUTS, HAND-FOLDED', body: '<p>Cashews, pistachios, and pine nuts are folded in by hand, batch by batch.</p><p>No artificial nut flavouring, no reconstituted nut paste — just real roasted nuts.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/honey-cashews-cropped.jpg?v=1782960864', eyebrow: 'STEP 04', heading: 'No Added Sugar, Ever', badge: '100% HONEY', body: '<p>What you taste is honey, full stop.</p><p>A lot of cheaper honey is cut with corn syrup or glucose to stretch the jar. Ours never is.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/honey-cashews-cropped.jpg?v=1782960864', eyebrow: 'OUR STORY', heading: 'This Is <em>Balsam Tahini</em>', body: '<p>We built this brand on the idea that real, unprocessed food tastes better. Our honey follows the same rule as our tahini — raw, honest, and never cut with anything that does not belong.</p>', cta_label: 'Shop Honey', cta_url: '/collections/honey' -%}

    {%- when 'halawa' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/halawa-plain-cropped.jpg?v=1782960864', eyebrow: 'STEP 01', heading: 'Real Tahini Base', badge: 'OUR OWN TAHINI', body: '<p>Every batch of halawa starts with our own stone-ground tahini — not a bought-in bulk paste.</p><p>Most halawa makers buy generic tahini by the drum. We use the same tahini we sell in the jar.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/halawa-plain-cropped.jpg?v=1782960864', eyebrow: 'STEP 02', heading: 'Slow-Cooked Sugar & Rosewater Syrup', badge: 'PRECISION-COOKED', body: '<p>The syrup is cooked by hand to a precise temperature before it is worked into the tahini.</p><p>Get the temperature wrong and halawa turns grainy or gummy — precision is what gives it that signature flaky melt.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/halawa-pistachio-cropped.jpg?v=1782960864', eyebrow: 'STEP 03', heading: 'Hand-Folded, Never Machine-Extruded', badge: 'FOLDED BY HAND', body: '<p>We fold each batch by hand in small runs, which is what creates the flaky strands halawa is known for.</p><p>Mass-produced halawa is machine-extruded and dense — hand-folding is slower, but it is the only way to get real flakiness.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/halawa-plain-cropped.jpg?v=1782960864', eyebrow: 'STEP 04', heading: 'Real Nuts & Honey, No Artificial Flavour', badge: 'NO CORN-SYRUP SWIRLS', body: '<p>Our pistachio, hazelnut, and honey varieties are made with the real ingredient folded in.</p><p>Many supermarket halawas use corn-syrup-based flavour swirls instead of the real thing. We do not.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/halawa-plain-cropped.jpg?v=1782960864', eyebrow: 'OUR STORY', heading: 'This Is <em>Balsam Tahini</em>', body: '<p>Halawa is where our tahini becomes dessert. It carries the same promise as everything else we make: real ingredients, traditional methods, nothing artificial.</p>', cta_label: 'Shop Halawa', cta_url: '/collections/halawas' -%}

    {%- when 'pistachio' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/ingredient-pistachios.jpg?v=1782937673', eyebrow: 'STEP 01', heading: 'Real Roasted Pistachios', badge: 'PISTACHIO, FULL STOP', body: '<p>We start with whole, roasted pistachios — not a diluted pistachio paste.</p><p>A lot of "pistachio" spreads are cut with cheaper cashews or almonds. Ours is not.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/pistachio-spread-milk-cropped.jpg?v=1782960864', eyebrow: 'STEP 02', heading: 'Stone-Ground Low & Slow', badge: 'LOW & SLOW', body: '<p>We grind slowly to a smooth, spreadable texture without overheating the nuts.</p><p>Overheating cooks off the natural pistachio oils and flavour — low and slow keeps both intact.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/pistachio-kunafa-cropped.jpg?v=1782960864', eyebrow: 'STEP 03', heading: 'Naturally Green, No Food Colouring', badge: 'NO ARTIFICIAL DYE', body: '<p>That vibrant green comes from real pistachio skins, not a dye.</p><p>Many pistachio products add artificial colouring to look more vibrant on the shelf. We let the pistachio speak for itself.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/pistachio-spread-milk-cropped.jpg?v=1782960864', eyebrow: 'STEP 04', heading: '6 Clean Ingredients, No Palm Oil', badge: 'NO PALM OIL', body: '<p>Just pistachios, a touch of sugar, and natural stabilizers — nothing else.</p><p>No palm oil, no hydrogenated fat — ingredients most mass-market spreads rely on to stay shelf-stable.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/pistachio-spread-milk-cropped.jpg?v=1782960864', eyebrow: 'OUR STORY', heading: 'This Is <em>Balsam Tahini</em>', body: '<p>Pistachio spread is our boldest flavour, but it is built on the same standard as our tahini: real ingredients, stone-ground the slow way, nothing hidden in the jar.</p>', cta_label: 'Shop Pistachio Spread', cta_url: '/collections/pistachio-spreads' -%}

    {%- else -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/ingredient-sesame-seeds.jpg?v=1782937673', eyebrow: 'STEP 01', heading: 'Real Humera Sesame Seeds', badge: 'NO SEED BLENDS', body: '<p>We start with whole Ethiopian Humera sesame seeds — prized for their high oil content and rich, nutty flavour.</p><p>Most mass-market tahini uses cheaper decorticated seed blends. We do not cut corners on the seed.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/tahini-jar-cropped.jpg?v=1782960864', eyebrow: 'STEP 02', heading: 'Slow Stone-Ground, Never Machine-Milled', badge: 'COOL-TEMP MILLED', body: '<p>Our sesame is ground slowly between traditional stone mills at cool temperatures.</p><p>High-speed steel mills overheat the paste, cooking out flavour and turning it bitter — ours never does.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/tahini-jar-cropped.jpg?v=1782960864', eyebrow: 'STEP 03', heading: 'Small Batches, Always Fresh', badge: 'MILLED THIS WEEK', body: '<p>Every batch is milled in small runs, then jarred and shipped within days.</p><p>No sitting in a warehouse for months before it reaches your shelf.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/tahini-jar-cropped.jpg?v=1782960864', eyebrow: 'STEP 04', heading: 'Zero Additives, Zero Shortcuts', badge: '100% SESAME', body: '<p>Just 100% stone-ground sesame — nothing else goes in the jar.</p><p>Many competitors add vegetable oil to stretch the batch and mask bitterness. We never do.</p>' -%}
      {%- render 'scroll-story-row', image: 'https://cdn.shopify.com/s/files/1/0657/3067/4742/files/tahini-jar-cropped.jpg?v=1782960864', eyebrow: 'OUR STORY', heading: 'This Is <em>Balsam Tahini</em>', body: '<p>Tahini was on our table every single meal growing up. When we moved to Canada and could not find one that tasted like home, we partnered with traditional stone mills to make our own. That is the tahini in your hands today.</p>', cta_label: 'Shop Tahini', cta_url: '/collections/tahini' -%}

  {%- endcase -%}

</section>

{% schema %}
{
  "name": "Scroll Story",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "white"
    }
  ],
  "presets": [
    { "name": "Scroll Story" }
  ]
}
{% endschema %}
