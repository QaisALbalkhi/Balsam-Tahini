{% style %}
  /* ── Section — inherits alternating bg from .shopify-section wrapper ── */
  .ss2 {
    background: inherit;
  }

  /* ── Each row ── */
  .ss2-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 0;
    padding-block: var(--space-14);
    padding-inline: max(
      var(--container-gutter-desktop, 40px),
      calc((100vw - var(--container-max, 1200px)) / 2 + var(--container-gutter-desktop, 40px))
    );
  }

  /* Alternating: even rows flip to media-left / text-right */
  .ss2-row:nth-child(even) .ss2-row__text-col { order: 2; }
  .ss2-row:nth-child(even) .ss2-row__media-col { order: 1; }

  /* ── Text column ── */
  .ss2-row__text-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: var(--space-8) var(--space-10);
    gap: var(--space-4);
  }

  .ss2-row__eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ss2-row__heading {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.6rem);
    font-weight: 700;
    color: var(--fg);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    margin: 0;
  }
  .ss2-row__heading em { font-style: italic; }

  .ss2-row__badge {
    display: inline-block;
    border: 1.5px solid var(--fg);
    border-radius: var(--radius-pill);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg);
    padding: 4px 16px;
  }

  .ss2-row__meta {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--fg);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    width: 100%;
    text-align: center;
    margin: 0;
  }

  .ss2-row__body {
    font-size: var(--text-base);
    color: var(--fg-2);
    line-height: 1.75;
    max-width: 380px;
  }
  .ss2-row__body p { margin-bottom: var(--space-3); }
  .ss2-row__body p:last-child { margin-bottom: 0; }
  .ss2-row__body strong { color: var(--fg); font-weight: 700; }

  .ss2-row__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    transition: gap 0.18s;
  }
  .ss2-row__cta:hover { gap: 10px; }

  /* ── Media column ── */
  .ss2-row__media-col {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }

  .ss2-row__media-wrap {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 3 / 4;
    border-radius: 20px;
    overflow: hidden;
    background: var(--border-soft);
    position: relative;
  }

  .ss2-row__img,
  .ss2-row__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Section header ── */
  .ss2-header {
    text-align: center;
    padding-block: var(--space-14) var(--space-4);
    padding-inline: max(
      var(--container-gutter-desktop, 40px),
      calc((100vw - var(--container-max, 1200px)) / 2 + var(--container-gutter-desktop, 40px))
    );
  }
  .ss2-header .eyebrow { margin-bottom: var(--space-2); }
  .ss2-header__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    color: var(--fg);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
  }
  .ss2-header__heading em { font-style: italic; }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .ss2-row {
      grid-template-columns: 1fr;
      padding: var(--space-6) var(--container-gutter-phone, 20px);
      gap: var(--space-5);
    }
    .ss2-row:nth-child(even) .ss2-row__text-col,
    .ss2-row:nth-child(even) .ss2-row__media-col { order: unset; }
    /* On mobile always: text first, media below */
    .ss2-row__text-col  { order: 1; padding: var(--space-2) 0; }
    .ss2-row__media-col { order: 2; padding: 0; }
    .ss2-row__media-wrap { max-width: 100%; }
    .ss2-row__body { max-width: 100%; }
    .ss2-header { padding: var(--space-10) var(--container-gutter-phone, 20px) 0; }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .ss2-row { padding-block: var(--space-10); padding-inline: var(--container-gutter-tablet, 24px); }
    .ss2-row__text-col { padding: var(--space-6) var(--space-6); }
    .ss2-header { padding-block: var(--space-10) 0; padding-inline: var(--container-gutter-tablet, 24px); }
  }
{% endstyle %}

<section class="ss2" id="ss2-{{ section.id }}">

  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="ss2-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ss2-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'row' -%}
      <div class="ss2-row" {{ block.shopify_attributes }}>

        <!-- Text column -->
        <div class="ss2-row__text-col">
          {%- if block.settings.eyebrow != blank -%}
            <p class="ss2-row__eyebrow">{{ block.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="ss2-row__heading">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.badge != blank -%}
            <span class="ss2-row__badge">{{ block.settings.badge }}</span>
          {%- endif -%}
          {%- if block.settings.meta != blank -%}
            <p class="ss2-row__meta">{{ block.settings.meta }}</p>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <div class="ss2-row__body">{{ block.settings.body }}</div>
          {%- endif -%}
          {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
            <a href="{{ block.settings.cta_url }}" class="ss2-row__cta">
              {{ block.settings.cta_label }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          {%- endif -%}
        </div>

        <!-- Media column -->
        <div class="ss2-row__media-col">
          <div class="ss2-row__media-wrap">
            {%- if block.settings.video_url != blank -%}
              <video
                src="{{ block.settings.video_url }}"
                class="ss2-row__video"
                autoplay muted loop playsinline
                preload="metadata"
              ></video>
            {%- elsif block.settings.video != blank -%}
              {{- block.settings.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, class: 'ss2-row__video' -}}
            {%- elsif block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 840 }}"
                srcset="{{ block.settings.image | image_url: width: 420 }} 420w, {{ block.settings.image | image_url: width: 840 }} 840w"
                sizes="(max-width: 767px) 100vw, 40vw"
                alt="{{ block.settings.heading | strip_html | escape }}"
                width="420" height="560"
                loading="lazy"
                class="ss2-row__img"
              >
            {%- else -%}
              <div style="width:100%;height:100%;background:var(--border-soft);"></div>
            {%- endif -%}
          </div>
        </div>

      </div>
    {%- endif -%}
  {%- endfor -%}

</section>

{% schema %}
{
  "name": "Scroll Story",
  "settings": [
    { "type": "text",     "id": "eyebrow", "label": "Section eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Section heading (supports <em> italic)" },
    { "type": "select", "id": "bg", "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Story row",
      "settings": [
        { "type": "image_picker", "id": "image",       "label": "Image (if no video)" },
        { "type": "video",        "id": "video",       "label": "Video (Shopify-hosted)" },
        { "type": "text",         "id": "video_url",   "label": "Video URL (external .mp4, overrides above)" },
        { "type": "text",         "id": "eyebrow",     "label": "Eyebrow / step" },
        { "type": "textarea",     "id": "heading",     "label": "Heading (supports <em> italic)", "default": "<em>Stone-ground</em> Tahini" },
        { "type": "text",         "id": "badge",       "label": "Oval badge label" },
        { "type": "text",         "id": "meta",        "label": "Meta line (uppercase)" },
        { "type": "richtext",     "id": "body",        "label": "Body text" },
        { "type": "text",         "id": "cta_label",   "label": "CTA label" },
        { "type": "url",          "id": "cta_url",     "label": "CTA link" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Scroll Story",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "eyebrow": "STEP 01",
            "heading": "<em>Stone-ground</em> Tahini",
            "badge": "THE CLASSIC",
            "meta": "COLD-PRESSED · SMALL BATCH"
          }
        },
        {
          "type": "row",
          "settings": {
            "eyebrow": "STEP 02",
            "heading": "Pistachio <em>Spread</em>",
            "badge": "THE BOLD ONE",
            "meta": "ROASTED · STONE-GROUND"
          }
        }
      ]
    }
  ]
}
{% endschema %}
