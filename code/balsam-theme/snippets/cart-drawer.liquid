{% comment %}
  Renders the slide-out cart drawer. Rendered once in layout/theme.liquid.
  All dynamic behavior (line items, free shipping bar, recommendations,
  quantity/remove, gift note) is driven client-side by assets/cart-drawer.js
  via the Cart AJAX API + the native /recommendations/products.json endpoint
  — no third-party app required. The Liquid below only provides the initial
  server-rendered state so the drawer isn't empty on first paint / no-JS.
{% endcomment %}

{%- liquid
  assign fs_threshold = settings.cart_free_shipping_threshold | default: 60
  assign fs_threshold_cents = fs_threshold | times: 100
  assign show_recs = settings.cart_show_recommendations
  assign show_gift_note = settings.cart_show_gift_note
-%}

<div
  class="cart-drawer"
  id="cart-drawer"
  aria-hidden="true"
  data-cart-drawer
  data-free-shipping-threshold="{{ fs_threshold_cents }}"
  data-show-recommendations="{{ show_recs }}"
  data-show-gift-note="{{ show_gift_note }}"
>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Your cart">

    <div class="cart-drawer__hdr">
      <h2 class="cart-drawer__title">Your Cart <span class="cart-drawer__count" data-cart-drawer-count>({{ cart.item_count }})</span></h2>
      <button type="button" class="cart-drawer__close" aria-label="Close cart" data-close-cart>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="cart-drawer__fs-bar" data-cart-fs-bar {% if fs_threshold_cents <= 0 %}hidden{% endif %}>
      <div class="cart-drawer__fs-textwrap">
        <p class="cart-drawer__fs-text" data-cart-fs-text>
          Add items to unlock <strong>free shipping</strong>
        </p>
      </div>
      <div class="cart-drawer__fs-track" data-cart-fs-track>
        <div class="cart-drawer__fs-fill" data-cart-fs-fill style="width:0%"></div>
        <div class="cart-drawer__fs-badge" data-cart-fs-badge aria-hidden="true" style="left:0%">
          <svg class="cart-drawer__fs-badge-truck" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="14" height="11" rx="1"/><path d="M15 8h4l4 4v3h-8V8z"/><circle cx="6" cy="18.5" r="2"/><circle cx="18" cy="18.5" r="2"/></svg>
          <svg class="cart-drawer__fs-badge-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 13 10 18 19 7"/></svg>
        </div>
      </div>
    </div>

    <div class="cart-drawer__body" data-cart-drawer-body>
      <div class="cart-drawer__items" data-cart-items>
        {%- comment -%} JS renders items here on load; this SSR block is the no-JS fallback {%- endcomment -%}
        {%- for item in cart.items -%}
          <div class="cart-line" data-cart-line-key="{{ item.key }}">
            <a href="{{ item.url }}" class="cart-line__img-link">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.image.alt | escape }}" width="60" height="60" loading="lazy" class="cart-line__img">
              {%- endif -%}
            </a>
            <div class="cart-line__info">
              <div class="cart-line__top-row">
                <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                <button type="button" class="cart-line__remove" data-cart-remove aria-label="Remove item">
                  <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M4 6h12M8 6V4.5A1.5 1.5 0 0 1 9.5 3h1A1.5 1.5 0 0 1 12 4.5V6m2 0-.6 9.4a1.5 1.5 0 0 1-1.5 1.4H8.1a1.5 1.5 0 0 1-1.5-1.4L6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cart-line__variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              {%- if item.selling_plan_allocation -%}
                <p class="cart-line__plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
              {%- endif -%}
              <div class="cart-line__bottom-row">
                <div class="cart-line__stepper" data-cart-qty-stepper>
                  <button type="button" class="cart-line__qty-btn" data-cart-qty-dec aria-label="Decrease quantity">−</button>
                  <span class="cart-line__qty-val" data-cart-qty-val>{{ item.quantity }}</span>
                  <button type="button" class="cart-line__qty-btn" data-cart-qty-inc aria-label="Increase quantity">+</button>
                </div>
                <div class="cart-line__price">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <s class="cart-line__compare">{{ item.original_line_price | money }}</s>
                  {%- endif -%}
                  <span>{{ item.final_line_price | money }}</span>
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-drawer__empty" data-cart-empty {% if cart.item_count > 0 %}hidden{% endif %}>
        <p>Your cart is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary" data-close-cart>Start Shopping</a>
      </div>
    </div>

    {%- comment -%}
      Recs + gift note live OUTSIDE the scrollable body (as their own
      non-scrolling group, pinned just above the footer) so they stay
      visible while only the line-items list scrolls — matches nomz's
      cart drawer, where "Perfect Match With" never moves even if you
      have a long cart.
    {%- endcomment -%}
    <div class="cart-drawer__pinned" data-cart-drawer-pinned {% if cart.item_count == 0 %}hidden{% endif %}>
      {%- if show_recs -%}
        <div class="cart-drawer__recs" data-cart-recs hidden>
          <p class="cart-drawer__recs-heading">You Might Also Like</p>
          <div class="cart-drawer__recs-wrap">
            <button type="button" class="cart-drawer__recs-nav cart-drawer__recs-nav--prev" data-cart-recs-prev aria-label="Scroll left" hidden>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <div class="cart-drawer__recs-track" data-cart-recs-track></div>
            <button type="button" class="cart-drawer__recs-nav cart-drawer__recs-nav--next" data-cart-recs-next aria-label="Scroll right" hidden>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>
      {%- endif -%}

      {%- if show_gift_note -%}
        <div class="cart-drawer__gift" data-cart-gift>
          <button type="button" class="cart-drawer__gift-toggle" data-cart-gift-toggle aria-expanded="false">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M3 8h14v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8z" stroke="currentColor" stroke-width="1.4"/>
              <path d="M2 5.5A1.5 1.5 0 0 1 3.5 4h13A1.5 1.5 0 0 1 18 5.5V8H2V5.5z" stroke="currentColor" stroke-width="1.4"/>
              <path d="M10 4v14M10 4c-1-2-4-2-4 0s3 2 4 0zM10 4c1-2 4-2 4 0s-3 2-4 0z" stroke="currentColor" stroke-width="1.2"/>
            </svg>
            Sending as a gift? Add a note
          </button>
          <div class="cart-drawer__gift-body" data-cart-gift-body hidden>
            <textarea class="cart-drawer__gift-input" data-cart-gift-input placeholder="Write your gift message…" rows="3">{{ cart.note }}</textarea>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="cart-drawer__footer" data-cart-drawer-footer {% if cart.item_count == 0 %}hidden{% endif %}>
      <div class="cart-drawer__subtotal-row">
        <span>Subtotal</span>
        <span class="cart-drawer__subtotal-prices">
          <s class="cart-drawer__subtotal-compare" data-cart-subtotal-compare hidden></s>
          <span data-cart-subtotal>{{ cart.total_price | money }}</span>
        </span>
      </div>
      <p class="cart-drawer__tax-note">{{ 'cart.taxes_note' | t }}</p>
      <a href="/checkout" class="cart-drawer__checkout" data-cart-checkout>
        <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <rect x="4" y="9" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
          <path d="M6.5 9V6a3.5 3.5 0 0 1 7 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        Checkout Securely
      </a>
      <div class="cart-drawer__mini-trust">
        <span>
          <svg width="12" height="12" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="4" y="9" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M6.5 9V6a3.5 3.5 0 0 1 7 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          Secure Checkout
        </span>
        <span class="cart-drawer__mini-trust-sep" aria-hidden="true">·</span>
        <span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 14l-4-4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 10h9a5 5 0 0 1 5 5v1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Money-Back Guarantee
        </span>
      </div>
    </div>

  </div>
  <div class="cart-drawer__overlay" data-close-cart aria-hidden="true"></div>
</div>

{%- comment -%}
  Quick-view popup for "You Might Also Like" cards — tapping a
  recommended product opens this instead of navigating to its PDP,
  so the customer never loses their place in checkout (Four Sigmatic
  pattern: the recommendation add-to-cart flow never leaves the cart
  context). Sits above the cart drawer (higher z-index), independent
  of it, so it also works from the mobile nav / anywhere BalsamCart
  is driven from.
{%- endcomment -%}
<div class="cart-quickview" id="cart-quickview" aria-hidden="true" data-cart-quickview>
  <div class="cart-quickview__overlay" data-cart-quickview-close></div>
  <div class="cart-quickview__wrap">
    <button type="button" class="cart-quickview__close" data-cart-quickview-close aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="cart-quickview__panel" role="dialog" aria-modal="true" aria-label="Quick view">
      <div class="cart-quickview__body" data-cart-quickview-body></div>
    </div>
  </div>
</div>

<style>
  .cart-drawer {
    position: fixed; inset: 0; z-index: 400;
    pointer-events: none; visibility: hidden;
  }
  .cart-drawer--open { pointer-events: all; visibility: visible; }

  .cart-drawer__overlay {
    position: absolute; inset: 0; z-index: 1;
    background: rgba(0,0,0,0.45);
    opacity: 0; transition: opacity var(--motion-base) var(--ease-standard);
    cursor: pointer;
  }
  .cart-drawer--open .cart-drawer__overlay { opacity: 1; }

  .cart-drawer__panel {
    position: absolute; right: 0; top: 0; bottom: 0; z-index: 2;
    width: min(420px, 92vw);
    background: var(--surface, #fff);
    display: flex; flex-direction: column;
    transform: translateX(100%);
    transition: transform var(--motion-base) var(--ease-standard);
  }
  .cart-drawer--open .cart-drawer__panel { transform: translateX(0); }

  .cart-drawer__hdr {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-5) var(--space-6);
    border-bottom: 1px solid var(--border-soft);
    flex-shrink: 0;
  }
  .cart-drawer__title { font-size: var(--text-lg); font-weight: 700; color: var(--fg); }
  .cart-drawer__count { font-weight: 400; color: var(--muted); }
  .cart-drawer__close {
    background: none; border: none; color: var(--fg-2); cursor: pointer;
    padding: 6px; border-radius: var(--radius-sm); display: flex;
  }
  .cart-drawer__close:hover { background: var(--border-soft); }

  /* Free shipping bar — the goal is to make "you're this close to
     free shipping" impossible to miss, since silent/easy-to-scroll-
     past framing is the suspected cause of erratic add/remove-to-
     hit-the-threshold behavior. Given noticeably more vertical room
     than the old thin strip, the message reads as a pill-shaped
     "popup" with its own background/shadow (not just plain text on
     the cream band), and the truck rides the fill bar itself instead
     of sitting fixed at the track's end. */
  .cart-drawer__fs-bar { padding: var(--space-4) var(--space-6) var(--space-5); background: var(--surface-warm); flex-shrink: 0; }
  .cart-drawer__fs-textwrap { display: flex; justify-content: center; margin-bottom: var(--space-3); }
  .cart-drawer__fs-text {
    font-size: var(--text-sm); font-weight: 600; color: var(--fg-2);
    text-align: center; background: var(--surface);
    border: 1px solid var(--border); border-radius: var(--radius-pill);
    padding: 8px 18px; box-shadow: 0 3px 10px rgba(0,0,0,0.07);
    animation: cartFsPop 0.42s var(--ease-standard);
  }
  .cart-drawer__fs-text strong { color: var(--accent); }
  .cart-drawer__fs-text--met { background: var(--accent); color: var(--accent-on); border-color: var(--accent); }
  .cart-drawer__fs-text--met strong { color: var(--accent-on); }
  @keyframes cartFsPop {
    0%   { transform: scale(0.85); opacity: 0; }
    60%  { transform: scale(1.05); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }

  /* Track is taller and given breathing room top/bottom so the truck
     badge (which overhangs above/below the thin fill line) never
     clips against the bar's edges or the items list below. */
  .cart-drawer__fs-track {
    position: relative;
    height: 8px; margin: 14px 4px 4px;
    border-radius: var(--radius-pill); background: var(--border);
    overflow: visible;
  }
  .cart-drawer__fs-fill {
    height: 100%; background: var(--accent); border-radius: var(--radius-pill);
    transition: width 0.5s var(--ease-standard);
  }

  /* Shipping-goal badge — a truck "you are here" marker riding the
     leading edge of the fill (nomz/Four Sigmatic pattern), animating
     left in step with the fill itself, swapping to a checkmark once
     the threshold is met. */
  .cart-drawer__fs-badge {
    position: absolute; top: 50%; transform: translate(-50%, -50%);
    display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--surface); border: 2px solid var(--accent);
    color: var(--accent); box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    transition: left 0.5s var(--ease-standard), background var(--motion-base) var(--ease-standard), color var(--motion-base) var(--ease-standard);
  }
  .cart-drawer__fs-badge-check { display: none; }
  .cart-drawer__fs-badge--met { background: var(--accent); color: var(--accent-on); }
  .cart-drawer__fs-badge--met .cart-drawer__fs-badge-truck { display: none; }
  .cart-drawer__fs-badge--met .cart-drawer__fs-badge-check { display: block; }

  /* The product list is the primary content. min-height is a small
     safety floor, not a hard guarantee — .cart-drawer__panel has a
     fixed height (top:0/bottom:0, doesn't grow with content), so a
     large floor here would just push the footer/checkout button past
     the bottom edge on short viewports instead of actually showing
     more items. The real fix is keeping the pinned block below lean. */
  .cart-drawer__body { flex: 1; overflow-y: auto; min-height: 100px; padding: var(--space-4) var(--space-6); }

  /* Pinned group (recs + gift note) — sits between the scrollable
     items list and the footer, and never scrolls itself. Kept as
     lean as possible so it doesn't eat into the items list above. */
  .cart-drawer__pinned { flex-shrink: 0; border-top: 1px solid var(--border-soft); padding: var(--space-3) var(--space-6) 0; }
  .cart-drawer__pinned[hidden] { display: none; }

  /* Line items — compact, nomz-density: small image, remove folded
     into a corner icon, qty + price share one row instead of stacking,
     so ~3 lines are visible at once without scrolling. */
  .cart-line { display: grid; grid-template-columns: 60px 1fr; gap: var(--space-3); padding-block: var(--space-3); border-bottom: 1px solid var(--border-soft); }
  .cart-line:first-child { padding-top: 0; }
  .cart-line__img { width: 60px; height: 60px; object-fit: cover; border-radius: var(--radius-sm); border: 1px solid var(--border); display: block; }
  .cart-line__info { min-width: 0; }
  .cart-line__top-row { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2); }
  .cart-line__title { font-size: var(--text-sm); font-weight: 700; color: var(--fg); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .cart-line__title:hover { color: var(--accent); }
  .cart-line__variant, .cart-line__plan { font-size: var(--text-xs); color: var(--muted); margin-top: 1px; }
  .cart-line__plan { color: var(--accent); font-weight: 600; }
  .cart-line__bottom-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); margin-top: var(--space-1); }
  /* Stepper + remove buttons: kept visually compact (so line items
     stay dense) but each gets an invisible expanded hit area to a
     real 44x44 CSS px target — the WCAG 2.5.5 / Apple HIG minimum for
     a comfortable thumb tap, not just the visible button box. Tiny
     unpadded tap targets are a well-documented driver of mis-taps
     (accidental qty changes/removals), which plausibly explains some
     of the erratic add/remove-to-hit-free-shipping behavior. */
  .cart-line__stepper { display: inline-flex; align-items: center; border: 1px solid var(--border); border-radius: var(--radius-sm); }
  .cart-line__qty-btn {
    position: relative; width: 34px; height: 34px;
    background: none; border: none; cursor: pointer; color: var(--fg-2);
    font-size: 18px; line-height: 1; display: flex; align-items: center; justify-content: center;
  }
  .cart-line__qty-btn::before {
    content: ''; position: absolute; top: 50%; left: 50%;
    width: 44px; height: 44px; transform: translate(-50%, -50%);
  }
  .cart-line__qty-btn:hover { background: var(--border-soft); }
  .cart-line__qty-val { width: 26px; text-align: center; font-size: var(--text-sm); font-weight: 700; }
  .cart-line__remove {
    position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; margin-top: 1px;
    background: none; border: none; color: var(--muted); cursor: pointer; border-radius: var(--radius-sm);
  }
  .cart-line__remove::before {
    content: ''; position: absolute; top: 50%; left: 50%;
    width: 44px; height: 44px; transform: translate(-50%, -50%);
  }
  .cart-line__remove svg { width: 16px; height: 16px; }
  .cart-line__remove:hover { color: var(--danger); background: var(--border-soft); }
  .cart-line__price { font-size: var(--text-sm); font-weight: 700; color: var(--fg); text-align: right; white-space: nowrap; display: flex; align-items: baseline; gap: 6px; }
  .cart-line__compare { font-size: var(--text-xs); font-weight: 400; color: var(--muted); text-decoration: line-through; }
  .cart-line--updating { opacity: 0.5; pointer-events: none; }

  .cart-drawer__empty { text-align: center; padding-block: var(--space-12); color: var(--muted); display: flex; flex-direction: column; gap: var(--space-4); align-items: center; }
  .cart-drawer__empty[hidden] { display: none; }

  /* Recommendations — one full-width card at a time, swipeable */
  .cart-drawer__recs { padding-bottom: var(--space-4); }
  .cart-drawer__recs-heading { font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: var(--space-3); }
  .cart-drawer__recs-wrap { position: relative; display: flex; align-items: center; gap: var(--space-2); }
  .cart-drawer__recs-track {
    display: flex; gap: var(--space-3); overflow-x: auto; scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; -ms-overflow-style: none;
  }
  .cart-drawer__recs-track::-webkit-scrollbar { display: none; }
  /* Nav arrows given an invisible expanded hit area too — the visible
     28px circle stays visually light, the actual tap target is 44px. */
  .cart-drawer__recs-nav {
    position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: var(--radius-pill);
    background: var(--surface); border: 1px solid var(--border);
    color: var(--fg-2); cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    transition: color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard);
  }
  .cart-drawer__recs-nav::before {
    content: ''; position: absolute; top: 50%; left: 50%;
    width: 44px; height: 44px; transform: translate(-50%, -50%);
  }
  .cart-drawer__recs-nav:hover { color: var(--accent); border-color: var(--accent); }
  .cart-drawer__recs-nav[hidden] { display: none; }

  /* Full-width horizontal card: bigger image + roomier padding than
     before, and the Add button sized to a real 44px-tall thumb
     target (not just a small pill) — this is the one card most
     likely to get tapped one-handed on mobile mid-checkout. */
  .cart-rec {
    flex: 0 0 100%; scroll-snap-align: start;
    display: flex; align-items: center; gap: var(--space-4);
    padding: var(--space-3); border: 1px solid var(--border); border-radius: var(--radius-md);
    background: var(--surface-warm);
  }
  .cart-rec__img { width: 68px; height: 68px; object-fit: cover; border-radius: var(--radius-sm); border: 1px solid var(--border); flex-shrink: 0; display: block; }
  .cart-rec__img-btn { flex-shrink: 0; padding: 0; background: none; border: none; cursor: pointer; border-radius: var(--radius-sm); }
  .cart-rec__body { flex: 1; min-width: 0; }
  .cart-rec__title {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    width: 100%; padding: 0; margin-bottom: 3px; text-align: left;
    font-family: var(--font-body); font-size: var(--text-base); font-weight: 700; color: var(--fg);
    background: none; border: none; cursor: pointer;
  }
  .cart-rec__title:hover { color: var(--accent); }
