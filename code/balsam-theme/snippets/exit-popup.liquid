{% comment %}
  Welcome popup: 15% off a first order in exchange for an email.

  Rendered once from layout/theme.liquid.

  Capture goes through Shopify's own {% form 'customer' %}, the same path the
  footer newsletter uses, so subscribers land in Shopify's customer list with
  marketing consent and flow into Klaviyo through its existing Shopify sync.
  No Klaviyo API key or list id is needed here. The submission is tagged
  `welcome15` so a Klaviyo flow can trigger on it.

  The discount code (ep_code) must exist in Shopify Admin > Discounts. After a
  signup the popup shows the code and a link that applies it (/discount/CODE).
  The code is in the page source like any popup code; the real limit is the
  "one use per customer" setting on the discount itself.

  Trigger: desktop fires on exit intent (pointer leaves the top of the
  viewport) after a minimum dwell time. Touch devices have no exit intent, so
  they get it after ep_touch_seconds on the page, or after ep_min_seconds from
  the second page view of a session. It is never shown on the cart page, over
  the cart drawer, the menu or the search overlay, and not to customers who
  have already ordered.

  Frequency: a dismissal is remembered for `ep_snooze_days`; subscribing
  suppresses it for good (closing the success panel keeps that). Both live in
  localStorage, which is per-browser.

  Edit the settings directly below.
{% endcomment %}

{%- liquid
  assign ep_enabled = true
  assign ep_code = 'WELCOME15'
  assign ep_percent = '15%'
  assign ep_snooze_days = 14
  assign ep_min_seconds = 8
  assign ep_touch_seconds = 25
  assign ep_image_handle = 'pistachio-spread-smooth-crunchy'

  assign ep_returning = false
  if customer and customer.orders_count > 0
    assign ep_returning = true
  endif
-%}

{%- if ep_enabled and ep_returning == false -%}
{%- assign ep_product = all_products[ep_image_handle] -%}

<div class="ep" id="exit-popup" hidden
     data-exit-popup
     data-snooze-days="{{ ep_snooze_days }}"
     data-min-seconds="{{ ep_min_seconds }}"
     data-touch-seconds="{{ ep_touch_seconds }}"
     data-code="{{ ep_code }}">
  <div class="ep__backdrop" data-ep-close></div>

  <div class="ep__dialog" role="dialog" aria-modal="true" aria-labelledby="ep-title" tabindex="-1">
    <button class="ep__close" type="button" aria-label="Close" data-ep-close>&times;</button>

    <div class="ep__media">
      <span class="ep__flag">{{ ep_percent }} Off</span>
      {%- if ep_product.featured_image -%}
        <img src="{{ ep_product.featured_image | image_url: width: 700 }}"
             alt="" width="700" height="700" loading="lazy" decoding="async">
      {%- endif -%}
    </div>

    <div class="ep__body">
      <p class="ep__eyebrow">Welcome to Balsam</p>
      <h2 class="ep__title" id="ep-title">Stone-ground with care. <em>{{ ep_percent }} off</em> your first order.</h2>
      <p class="ep__sub">Join the Balsam list for {{ ep_percent }} off your first order, plus early access to new spreads, small-batch releases and recipes from our Mississauga kitchen.</p>

      <div class="ep__formwrap" data-ep-formwrap>
        {%- form 'customer', id: 'ep-form', class: 'ep__form', novalidate: 'novalidate' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,exit-popup,welcome15">
          <label class="ep__label" for="ep-email">Email address</label>
          <input class="ep__input" type="email" id="ep-email" name="contact[email]"
                 placeholder="you@example.com" required autocomplete="email" inputmode="email">
          <button class="ep__btn" type="submit" data-ep-submit>Get my {{ ep_percent }} off</button>
        {%- endform -%}
        <p class="ep__error" data-ep-error hidden role="alert">That didn&rsquo;t go through. Please try again.</p>
      </div>

      <div class="ep__done" data-ep-done hidden role="status" aria-live="polite">
        <p class="ep__done-title">You&rsquo;re in.</p>
        <p class="ep__sub">Your {{ ep_percent }} off code:</p>
        <p class="ep__code">{{ ep_code }}</p>
        <a class="ep__btn ep__btn--link" href="/discount/{{ ep_code }}?redirect=/collections/all" data-ep-shop>Start shopping</a>
      </div>

      <p class="ep__fine">One use per customer on one-time purchase items. Can&rsquo;t be combined with other offers, including Buy 1, 2nd 50% Off. We send recipes and offers; unsubscribe any time.</p>
      <button class="ep__decline" type="button" data-ep-close>Maybe later.</button>
    </div>
  </div>
</div>

<style>
  .ep[hidden] { display: none !important; }
  .ep {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .ep__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(13, 24, 19, 0.62);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  .ep__dialog {
    position: relative;
    width: 100%;
    max-width: 720px;
    max-height: calc(100vh - 40px);
    max-height: calc(100dvh - 40px);
    overflow-y: auto;
    background: var(--surface, #FFFFFF);
    border-radius: var(--radius-lg, 16px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    box-shadow: 0 24px 70px rgba(0,0,0,0.42);
    animation: ep-in 0.26s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes ep-in {
    from { opacity: 0; transform: translateY(14px) scale(0.985); }
    to   { opacity: 1; transform: none; }
  }

  .ep__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    color: var(--fg, #22292F);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    z-index: 3;
    box-shadow: 0 1px 4px rgba(0,0,0,0.14);
  }

  .ep__media {
    position: relative;
    background: var(--surface-warm, #F5F0E8);
    min-height: 340px;
    border-radius: var(--radius-lg, 16px) 0 0 var(--radius-lg, 16px);
    overflow: hidden;
  }
  .ep__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ep__flag {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    background: #F2B544;
    color: #3B2A05;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 7px 12px;
    border-radius: 8px;
  }

  .ep__body {
    padding: 36px 34px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .ep__eyebrow {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent, #1B4332);
    margin: 0 0 12px;
  }
  .ep__title {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: 1.75rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--fg, #22292F);
    margin: 0 0 10px;
  }
  .ep__title em { font-style: italic; color: var(--accent, #1B4332); white-space: nowrap; }
  .ep__sub {
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--muted, #666666);
    margin: 0 0 20px;
  }

  .ep__form { display: flex; flex-direction: column; gap: 8px; }
  .ep__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg, #22292F);
  }
  .ep__input {
    width: 100%;
    padding: 14px 16px;
    font-family: var(--font-body, "Open Sans", sans-serif);
    font-size: 1rem;
    color: var(--fg, #22292F);
    background: var(--bg, #FAFAF8);
    border: 1.5px solid var(--border, #E8ECEF);
    border-radius: var(--radius-md, 10px);
    outline: none;
  }
  .ep__input:focus { border-color: var(--accent, #1B4332); background: #fff; }
  .ep__btn {
    width: 100%;
    padding: 15px 20px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    background: var(--accent, #1B4332);
    color: var(--accent-on, #FFFFFF);
    font-family: var(--font-body, "Open Sans", sans-serif);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    transition: background 0.18s ease;
  }
  .ep__btn:hover { background: var(--accent-hover, #2D6A4F); }
  .ep__btn[disabled] { opacity: 0.6; cursor: default; }

  .ep__error { font-size: 0.78rem; color: #B42318; margin: 10px 0 0; }
  .ep__done-title {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: 1.4rem;
    color: var(--accent, #1B4332);
    margin: 0 0 6px;
  }

  .ep__code {
    margin: 0 0 14px;
    padding: 12px 16px;
    text-align: center;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--accent, #1B4332);
    background: var(--surface-warm, #F5F0E8);
    border: 1.5px dashed var(--accent, #1B4332);
    border-radius: var(--radius-md, 10px);
    user-select: all;
  }
  .ep a.ep__btn--link {
    display: block;
    box-sizing: border-box;
    text-align: center;
    text-decoration: none;
    color: var(--accent-on, #FFFFFF);
  }
  .ep a.ep__btn--link:hover { background: var(--accent-hover, #2D6A4F); }
  .ep.is-done .ep__fine,
  .ep.is-done .ep__decline { display: none; }

  .ep__fine { font-size: 0.71rem; color: var(--muted, #666666); margin: 14px 0 0; line-height: 1.5; }
  .ep__decline {
    background: none;
    border: 0;
    padding: 0;
    margin-top: 10px;
    cursor: pointer;
    font-family: var(--font-body, "Open Sans", sans-serif);
    font-size: 0.74rem;
    color: var(--muted, #666666);
    text-decoration: underline;
    align-self: flex-start;
  }

  .ep__sr {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .ep { padding: 14px; }
    .ep__dialog {
      grid-template-columns: 1fr;
      max-width: 420px;
      max-height: calc(100vh - 28px);
      max-height: calc(100dvh - 28px);
    }
    .ep__media { min-height: 120px; border-radius: var(--radius-lg, 16px) var(--radius-lg, 16px) 0 0; }
    .ep__body { padding: 22px 20px 24px; }
    .ep__title { font-size: 1.45rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ep__dialog { animation: none; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('exit-popup');
  if (!root) return;

  var KEY          = 'balsam-exit-popup';
  var VIEWS_KEY    = 'balsam-exit-popup-views';
  var snoozeDays   = parseInt(root.dataset.snoozeDays, 10) || 14;
  var minSeconds   = parseInt(root.dataset.minSeconds, 10) || 8;
  var touchSeconds = parseInt(root.dataset.touchSeconds, 10) || 25;
  var code         = root.dataset.code || '';

  var dialog   = root.querySelector('.ep__dialog');
  var form     = root.querySelector('#ep-form');
  var emailEl  = root.querySelector('#ep-email');
  var submitEl = root.querySelector('[data-ep-submit]');
  var errorEl  = root.querySelector('[data-ep-error]');
  var formWrap = root.querySelector('[data-ep-formwrap]');
  var doneEl   = root.querySelector('[data-ep-done]');
  var shopEl   = root.querySelector('[data-ep-shop]');

  var touch  = window.matchMedia('(hover: none), (pointer: coarse)').matches;
  var opened = false;
  var armed  = false;
  var lastFocus = null;
  var submitLabel = submitEl ? submitEl.textContent : '';

  /* localStorage can throw in private mode, so every access is guarded and
     the popup simply behaves as if nothing was stored. */
  function readState() {
    try { return JSON.parse(localStorage.getItem(KEY) || 'null'); }
    catch (_) { return null; }
  }
  function writeState(state) {
    try { localStorage.setItem(KEY, JSON.stringify({ state: state, ts: Date.now() })); }
    catch (_) {}
  }
  function suppressed() {
    var s = readState();
    if (!s) return false;
    if (s.state === 'subscribed') return true;
    return (Date.now() - s.ts) < snoozeDays * 864e5;
  }

  /* Never interrupt the cart, the cart drawer, the menu or the search overlay. */
  function blocked() {
    if (/^\/cart(\/|$)/.test(window.location.pathname)) return true;
    var ids = ['cart-drawer', 'cart-quickview', 'mobile-nav'];
    for (var i = 0; i < ids.length; i++) {
      var el = document.getElementById(ids[i]);
      if (el && el.getAttribute('aria-hidden') === 'false') return true;
    }
    var search = document.getElementById('srch-overlay');
    if (search && !search.hidden) return true;
    return document.visibilityState === 'hidden';
  }

  function open() {
    if (opened || suppressed()) return;
    opened = true;
    lastFocus = document.activeElement;
    root.hidden = false;
    document.body.style.overflow = 'hidden';
    /* On touch, focus the dialog itself: focusing the field would raise the
       keyboard over the offer before anyone has read it. */
    var target = touch ? dialog : emailEl;
    if (target) { try { target.focus({ preventScroll: true }); } catch (_) { target.focus(); } }
  }

  function tryOpen(retries) {
    if (opened || suppressed()) return;
    if (!blocked()) { open(); return; }
    if (retries > 0) setTimeout(function () { tryOpen(retries - 1); }, 4000);
  }

  function close(state) {
    if (!opened) return;
    opened = false;
    root.hidden = true;
    document.body.style.overflow = '';
    /* Closing the success panel must not undo the "subscribed" flag. */
    var prev = readState();
    writeState(prev && prev.state === 'subscribed' ? 'subscribed' : (state || 'dismissed'));
    if (lastFocus && lastFocus.focus) { try { lastFocus.focus(); } catch (_) {} }
  }

  function showDone() {
    writeState('subscribed');
    formWrap.hidden = true;
    doneEl.hidden = false;
    root.classList.add('is-done');
    /* Apply the code, then bring the visitor back to the page they were on. */
    if (shopEl && code) {
      shopEl.href = '/discount/' + encodeURIComponent(code) + '?redirect=' +
        encodeURIComponent(window.location.pathname + window.location.search);
    }
    /* The field the focus was on just disappeared; hand it to the next useful control. */
    var next = shopEl || dialog;
    try { next.focus({ preventScroll: true }); } catch (_) { next.focus(); }
  }

  root.addEventListener('click', function (e) {
    if (e.target.closest('[data-ep-close]')) { close('dismissed'); }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && opened) close('dismissed');
  });

  /* Keep tab focus inside the dialog while it is open. */
  document.addEventListener('keydown', function (e) {
    if (!opened || e.key !== 'Tab') return;
    var f = dialog.querySelectorAll('button, [href], input, select, textarea');
    f = Array.prototype.filter.call(f, function (el) { return !el.disabled && el.offsetParent !== null; });
    if (!f.length) return;
    var first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!emailEl.value || !emailEl.checkValidity()) { emailEl.focus(); return; }
      errorEl.hidden = true;
      submitEl.disabled = true;
      submitEl.textContent = 'Signing you up...';

      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'text/html' }
      })
      .then(function (r) {
        if (!r.ok) throw new Error('rejected');
        showDone();
      })
      .catch(function () {
        errorEl.hidden = false;
        submitEl.disabled = false;
        submitEl.textContent = submitLabel;
      });
    });
  }

  if (suppressed()) return;

  /* Count page views in this session; the second one gets the popup sooner. */
  var views = 1;
  try {
    views = parseInt(sessionStorage.getItem(VIEWS_KEY) || '0', 10) + 1;
    sessionStorage.setItem(VIEWS_KEY, String(views));
  } catch (_) {}

  if (touch) {
    /* No exit intent on touch: wait out a dwell time instead. */
    var wait = views >= 2 ? minSeconds : Math.max(touchSeconds, minSeconds);
    setTimeout(function () { tryOpen(12); }, wait * 1000);
  } else {
    /* Minimum dwell before anything can fire, so a quick bounce is left alone. */
    setTimeout(function () { armed = true; }, minSeconds * 1000);
    document.addEventListener('mouseout', function (e) {
      if (!armed || opened) return;
      if (e.relatedTarget || e.clientY > 4) return;
      if (blocked()) return;
      open();
    });
  }
})();
</script>
{%- endif -%}
