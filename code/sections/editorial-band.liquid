<section class="editorial-band section section--cream">
  <div class="container">
    <div class="editorial-band__grid{% if section.settings.image_position == 'right' %} editorial-band__grid--reversed{% endif %}">

      {%- if section.settings.image != blank -%}
        <div class="editorial-band__media">
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            srcset="
              {{ section.settings.image | image_url: width: 400 }} 400w,
              {{ section.settings.image | image_url: width: 800 }} 800w
            "
            sizes="(max-width: 767px) 100vw, 50vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="800"
            height="600"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      <div class="editorial-band__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="section-title editorial-band__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="editorial-band__body">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
          <a href="{{ section.settings.cta_url }}" class="btn btn-primary">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial band",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Balsam Tahini?"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Stone-ground in small batches from premium sesame seeds. No preservatives, no additives. Just pure, natural tahini the way it was meant to be.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Editorial band"
    }
  ]
}
{% endschema %}

<style>
  .editorial-band__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .editorial-band__grid--reversed {
    direction: rtl;
  }

  .editorial-band__grid--reversed > * {
    direction: ltr;
  }

  .editorial-band__media img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .editorial-band__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .editorial-band__heading {
    margin-top: var(--space-2);
  }

  .editorial-band__body {
    font-size: var(--text-lg);
    color: var(--fg-2);
    line-height: var(--leading-body);
  }

  .editorial-band__body p + p {
    margin-top: var(--space-4);
  }

  @media (max-width: 767px) {
    .editorial-band__grid,
    .editorial-band__grid--reversed {
      grid-template-columns: 1fr;
      direction: ltr;
      gap: var(--space-8);
    }

    .editorial-band__media img {
      height: 300px;
    }
  }
</style>
