<article class="main-article section">
  <div class="container">

    <!-- Back link -->
    <a href="{{ blog.url }}" class="article-back">
      ← {{ 'blog.back' | t }}
    </a>

    <!-- Hero image -->
    {%- if article.image -%}
      <div class="article-hero">
        <img
          src="{{ article.image | image_url: width: 1200 }}"
          srcset="
            {{ article.image | image_url: width: 768 }} 768w,
            {{ article.image | image_url: width: 1200 }} 1200w
          "
          sizes="(max-width: 1199px) 100vw, 1200px"
          alt="{{ article.image.alt | default: article.title | escape }}"
          width="1200"
          height="500"
          loading="eager"
          class="article-hero__img"
        >
      </div>
    {%- endif -%}

    <!-- Article header -->
    <header class="article-header">
      {%- if article.tags.size > 0 -%}
        <p class="article-header__tags eyebrow">{{ article.tags | join: ' · ' }}</p>
      {%- endif -%}

      <h1 class="product-name article-header__title">{{ article.title }}</h1>

      <div class="article-header__meta">
        {%- if article.author -%}
          <span class="article-header__author">By {{ article.author }}</span>
        {%- endif -%}
        <time class="article-header__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: '%B %d, %Y' }}
        </time>
        {%- if article.read_time -%}
          <span aria-hidden="true">·</span>
          <span>{{ article.read_time }} min read</span>
        {%- endif -%}
      </div>
    </header>

    <!-- Article body -->
    <div class="article-body rte">
      {{ article.content }}
    </div>

    <!-- Tags -->
    {%- if article.tags.size > 0 -%}
      <div class="article-tags">
        {%- for tag in article.tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-tag">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Comments -->
    {%- if blog.comments_enabled? -%}
      <div class="article-comments">
        <h2 class="subheading article-comments__heading">
          {{ article.comments_count }}
          {%- if article.comments_count == 1 -%} Comment{%- else -%} Comments{%- endif -%}
        </h2>

        {%- if article.comments_count > 0 -%}
          <div class="article-comments__list">
            {%- paginate article.comments by 10 -%}
              {%- for comment in article.comments -%}
                <div class="comment">
                  <p class="comment__author">{{ comment.author }}</p>
                  <time class="comment__date" datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                    {{ comment.created_at | date: '%B %d, %Y' }}
                  </time>
                  <div class="comment__body">{{ comment.content }}</div>
                </div>
              {%- endfor -%}
            {%- endpaginate -%}
          </div>
        {%- endif -%}

        <!-- Comment form -->
        {%- form 'new_comment', article, class: 'comment-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="comment-form__success">Your comment has been submitted.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="comment-form__error">{{ form.errors | default_errors }}</p>
          {%- endif -%}

          <h3 class="comment-form__title subheading">Leave a comment</h3>

          <div class="comment-form__fields">
            <label for="comment-author" class="visually-hidden">Name</label>
            <input type="text" id="comment-author" name="comment[author]" placeholder="Your name" class="comment-form__input" required>

            <label for="comment-email" class="visually-hidden">Email</label>
            <input type="email" id="comment-email" name="comment[email]" placeholder="Your email" class="comment-form__input" required>
          </div>

          <label for="comment-body" class="visually-hidden">Comment</label>
          <textarea id="comment-body" name="comment[body]" placeholder="Your comment" class="comment-form__textarea" rows="4" required></textarea>

          <button type="submit" class="btn btn-primary">Post comment</button>
        {%- endform -%}
      </div>
    {%- endif -%}

  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": [],
  "presets": [
    {
      "name": "Article"
    }
  ]
}
{% endschema %}

<style>
  .article-back {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    margin-bottom: var(--space-6);
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .article-back:hover {
    color: var(--accent-hover);
  }

  /* Hero */
  .article-hero {
    margin-bottom: var(--space-8);
  }

  .article-hero__img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  /* Header */
  .article-header {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .article-header__tags {
    color: var(--accent);
  }

  .article-header__title {
    font-size: var(--text-3xl);
  }

  .article-header__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* Body */
  .article-body {
    max-width: 720px;
    font-size: var(--text-lg);
    color: var(--fg-2);
    line-height: var(--leading-body);
  }

  .rte h2, .rte h3 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    margin-block: var(--space-8) var(--space-4);
  }

  .rte h2 { font-size: var(--text-2xl); }
  .rte h3 { font-size: var(--text-xl); }

  .rte p + p {
    margin-top: var(--space-4);
  }

  .rte ul, .rte ol {
    padding-left: var(--space-6);
    margin-block: var(--space-4);
  }

  .rte li + li {
    margin-top: var(--space-2);
  }

  .rte img {
    border-radius: var(--radius-md);
    margin-block: var(--space-6);
  }

  .rte blockquote {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-6);
    margin-block: var(--space-6);
    font-style: italic;
    color: var(--fg-2);
  }

  /* Tags */
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
    max-width: 720px;
  }

  .article-tag {
    background-color: var(--border-soft);
    color: var(--fg-2);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    transition: background-color var(--motion-fast) var(--ease-standard);
  }

  .article-tag:hover {
    background-color: var(--border);
    color: var(--fg);
  }

  /* Comments */
  .article-comments {
    max-width: 720px;
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .article-comments__heading {
    margin-bottom: var(--space-4);
  }

  .comment {
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--border-soft);
  }

  .comment__author {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--fg);
  }

  .comment__date {
    font-size: var(--text-xs);
    color: var(--muted);
    margin-bottom: var(--space-3);
    display: block;
  }

  .comment__body {
    font-size: var(--text-base);
    color: var(--fg-2);
    line-height: var(--leading-body);
  }

  /* Comment form */
  .comment-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .comment-form__success {
    color: var(--success);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .comment-form__error {
    color: var(--danger);
    font-size: var(--text-sm);
  }

  .comment-form__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .comment-form__input,
  .comment-form__textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--fg);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: border-color var(--motion-fast) var(--ease-standard);
    resize: vertical;
  }

  .comment-form__input:focus,
  .comment-form__textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: var(--focus-ring);
  }

  @media (max-width: 767px) {
    .article-hero__img {
      height: 240px;
    }

    .comment-form__fields {
      grid-template-columns: 1fr;
    }
  }
</style>
