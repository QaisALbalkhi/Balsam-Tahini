<section class="contact-page section{% if section.settings.bg == 'cream' %} section--cream{% endif %}">
  <div class="container">

    <div class="contact-page__inner">

      <!-- Left: info column -->
      <div class="contact-page__info">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="contact-page__heading">{{ section.settings.heading | default: 'Get in Touch' }}</h1>
        {%- if section.settings.intro != blank -%}
          <p class="contact-page__intro">{{ section.settings.intro }}</p>
        {%- endif -%}

        <div class="contact-page__details">
          {%- if section.settings.email != blank -%}
            <div class="contact-detail">
              <span class="contact-detail__label">Email</span>
              <a href="mailto:{{ section.settings.email }}" class="contact-detail__value contact-detail__value--link">{{ section.settings.email }}</a>
            </div>
          {%- endif -%}
          {%- if section.settings.response_time != blank -%}
            <div class="contact-detail">
              <span class="contact-detail__label">Response time</span>
              <span class="contact-detail__value">{{ section.settings.response_time }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.location != blank -%}
            <div class="contact-detail">
              <span class="contact-detail__label">Based in</span>
              <span class="contact-detail__value">{{ section.settings.location }}</span>
            </div>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="contact-page__links">
            {%- for block in section.blocks -%}
              {%- if block.settings.label != blank and block.settings.url != blank -%}
                <a href="{{ block.settings.url }}" class="contact-link" {{ block.shopify_attributes }}>
                  <span class="contact-link__label">{{ block.settings.label }}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Right: form -->
      <div class="contact-page__form-wrap">
        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <div class="contact-form__success">
              <div class="contact-form__success-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="11" stroke="var(--accent)" stroke-width="1.5"/>
                  <path d="M7.5 12l3 3 5.5-5.5" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <h2 class="contact-form__success-heading">Message sent!</h2>
              <p>Thanks for reaching out. We'll get back to you within 1–2 business days.</p>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <div class="contact-form__errors">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
            <div class="contact-form__fields">
              <div class="contact-form__row contact-form__row--half">
                <div class="contact-form__field">
                  <label class="contact-form__label" for="ContactFormName">Name <span aria-hidden="true">*</span></label>
                  <input
                    type="text"
                    id="ContactFormName"
                    name="contact[name]"
                    autocomplete="name"
                    class="contact-form__input"
                    value="{{ form.name }}"
                    required
                  >
                </div>
                <div class="contact-form__field">
                  <label class="contact-form__label" for="ContactFormEmail">Email <span aria-hidden="true">*</span></label>
                  <input
                    type="email"
                    id="ContactFormEmail"
                    name="contact[email]"
                    autocomplete="email"
                    class="contact-form__input"
                    value="{{ form.email }}"
                    required
                  >
                </div>
              </div>
              <div class="contact-form__field">
                <label class="contact-form__label" for="ContactFormSubject">Subject</label>
                <input
                  type="text"
                  id="ContactFormSubject"
                  name="contact[subject]"
                  class="contact-form__input"
                  value="{{ form.subject }}"
                >
              </div>
              <div class="contact-form__field">
                <label class="contact-form__label" for="ContactFormMessage">Message <span aria-hidden="true">*</span></label>
                <textarea
                  id="ContactFormMessage"
                  name="contact[body]"
                  class="contact-form__textarea"
                  rows="6"
                  required
                >{{ form.body }}</textarea>
              </div>
              <button type="submit" class="btn btn-primary contact-form__submit">Send message</button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>

    </div>
  </div>
</section>

<style>
  .contact-page__inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
    align-items: start;
  }
  .contact-page__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-2);
  }
  .contact-page__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 700;
    color: var(--fg);
    letter-spacing: var(--tracking-display);
    line-height: 1.15;
  }
  .contact-page__intro {
    font-size: 1.05rem;
    color: var(--fg-2);
    line-height: 1.7;
  }
  .contact-page__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }
  .contact-detail {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .contact-detail__label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .contact-detail__value {
    font-size: 1rem;
    color: var(--fg);
    font-weight: 500;
  }
  .contact-detail__value--link {
    color: var(--accent);
    text-decoration: none;
  }
  .contact-detail__value--link:hover { text-decoration: underline; }

  .contact-page__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .contact-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: color var(--motion-fast) var(--ease-standard);
  }
  .contact-link:hover { color: var(--accent); }

  /* Form */
  .contact-page__form-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-10);
  }
  .contact-form__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .contact-form__row--half {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .contact-form__label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg);
  }
  .contact-form__label span { color: var(--accent); }
  .contact-form__input,
  .contact-form__textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    transition: border-color var(--motion-fast) var(--ease-standard);
    appearance: none;
  }
  .contact-form__input:focus,
  .contact-form__textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb, 90,120,90), 0.12);
  }
  .contact-form__textarea { resize: vertical; min-height: 140px; }
  .contact-form__submit { width: 100%; margin-top: var(--space-2); }
  .contact-form__errors {
    background: #fff5f5;
    border: 1px solid #fca5a5;
    border-radius: var(--radius-md);
    padding: var(--space-4);
    font-size: 0.9rem;
    color: #dc2626;
    margin-bottom: var(--space-4);
  }
  .contact-form__success {
    text-align: center;
    padding: var(--space-12) var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }
  .contact-form__success-icon {
    width: 56px;
    height: 56px;
    background: var(--surface-warm);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .contact-form__success-heading {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--fg);
  }
  .contact-form__success p {
    font-size: 1rem;
    color: var(--fg-2);
    line-height: 1.6;
  }

  @media (max-width: 959px) {
    .contact-page__inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
    .contact-page__form-wrap { padding: var(--space-7); }
  }
  @media (max-width: 639px) {
    .contact-form__row--half { grid-template-columns: 1fr; }
    .contact-page__form-wrap { padding: var(--space-6); }
  }
</style>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "REACH OUT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in Touch" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Have a question about our tahini, your order, or a wholesale inquiry? We'd love to hear from you." },
    { "type": "text", "id": "email", "label": "Contact email", "default": "hello@balsamtahini.ca" },
    { "type": "text", "id": "response_time", "label": "Response time", "default": "Within 1–2 business days" },
    { "type": "text", "id": "location", "label": "Location", "default": "Mississauga, Ontario, Canada" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{"value":"canvas","label":"White"},{"value":"cream","label":"Cream"}], "default": "canvas" }
  ],
  "blocks": [
    {
      "type": "quick_link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "View FAQs" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Page",
      "settings": {
        "eyebrow": "REACH OUT",
        "heading": "Get in Touch",
        "intro": "Have a question about our tahini, your order, or a wholesale inquiry? We'd love to hear from you.",
        "email": "hello@balsamtahini.ca",
        "response_time": "Within 1–2 business days",
        "location": "Mississauga, Ontario, Canada",
        "bg": "canvas"
      },
      "blocks": [
        { "type": "quick_link", "settings": { "label": "View frequently asked questions" } },
        { "type": "quick_link", "settings": { "label": "Wholesale enquiries" } },
        { "type": "quick_link", "settings": { "label": "Track your order" } }
      ]
    }
  ]
}
{% endschema %}
