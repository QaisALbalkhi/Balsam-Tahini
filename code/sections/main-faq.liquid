        { "type": "question", "settings": { "category": "Returns & Freshness", "question": "What is your return policy?", "answer": "<p>If you're not completely satisfied, we'll replace your order or issue a full refund — no questions asked. We stand behind the quality of every jar.</p>" } },
        { "type": "question", "settings": { "question": "How should I store my tahini?", "answer": "<p>Store in a cool, dry place away from direct sunlight. Once opened, you can refrigerate it to extend freshness, though it may thicken slightly when cold — bring it to room temperature and stir before use.</p>" } }
      ]
    }
  ]
}
{% endschema %}
