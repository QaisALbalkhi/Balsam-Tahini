<section class="faq-page section{% if section.settings.bg == 'cream' %} section--cream{% endif %}">
  <div class="container">

    <div class="faq-page__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="faq-page__heading">{{ section.settings.heading | default: 'Frequently Asked Questions' }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="faq-page__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="faq-page__list">
        {%- assign current_cat = '' -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.category != blank and block.settings.category != current_cat -%}
            {%- assign current_cat = block.settings.category -%}
            <h2 class="faq-page__category">{{ current_cat }}</h2>
          {%- endif -%}
          <div class="faq-item" {{ block.shopify_attributes }}>
            <button
              class="faq-item__trigger"
              aria-expanded="false"
              aria-controls="faq-panel-{{ block.id }}"
            >
              <span class="faq-item__q">{{ block.settings.question }}</span>
              <span class="faq-item__chevron" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>
            <div class="faq-item__panel rte" id="faq-panel-{{ block.id }}" hidden>
              {{ block.settings.answer }}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .faq-page__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .faq-page__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--fg);
    letter-spacing: var(--tracking-display);
    line-height: 1.15;
  }
  .faq-page__sub {
    font-size: 1.05rem;
    color: var(--fg-2);
    line-height: 1.6;
  }
  .faq-page__list {
    max-width: 760px;
    margin: 0 auto;
  }
  .faq-page__category {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--fg);
    margin: var(--space-10) 0 0;
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--accent);
    letter-spacing: 0.04em;
  }
  .faq-page__category:first-child { margin-top: 0; }
  .faq-item {
    border-bottom: 1px solid var(--border);
  }
  .faq-item__trigger {
    width: 100%;
    background: none;
    border: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    cursor: pointer;
    text-align: left;
  }
  .faq-item__q {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.4;
    flex: 1;
    transition: color var(--motion-fast) var(--ease-standard);
  }
  .faq-item__trigger:hover .faq-item__q { color: var(--accent); }
  .faq-item__chevron {
    color: var(--accent);
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }
  .faq-item__trigger[aria-expanded="true"] .faq-item__chevron {
    transform: rotate(180deg);
  }
  .faq-item__panel {
    padding: 0 0 var(--space-5);
    font-size: 1rem;
    color: var(--fg-2);
    line-height: 1.75;
  }
  .faq-item__panel p { margin-bottom: var(--space-3); }
  .faq-item__panel p:last-child { margin-bottom: 0; }
  .faq-item__panel a { color: var(--accent); text-decoration: underline; }
  .faq-item__panel ul { padding-left: var(--space-5); }
  .faq-item__panel li { margin-bottom: var(--space-1); }
</style>

<script>
(function () {
  document.querySelectorAll('.faq-item__trigger').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      var panel = document.getElementById(btn.getAttribute('aria-controls'));
      if (!panel) return;
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      panel.hidden = expanded;
    });
  });
})();
</script>

{% schema %}
{
  "name": "FAQ Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HELP CENTER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Everything you need to know about Balsam Tahini." },
    { "type": "select", "id": "bg", "label": "Background", "options": [{"value":"canvas","label":"White"},{"value":"cream","label":"Cream"}], "default": "canvas" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "category", "label": "Category header (leave blank to continue previous category)" },
        { "type": "text", "id": "question", "label": "Question", "default": "What makes Balsam Tahini different?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Balsam Tahini is stone-ground in small batches from premium sesame seeds — no additives, no preservatives, just pure sesame.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Page",
      "settings": { "eyebrow": "HELP CENTER", "heading": "Frequently Asked Questions", "subheading": "Everything you need to know about Balsam Tahini.", "bg": "canvas" },
      "blocks": [
        { "type": "question", "settings": { "category": "About Our Product", "question": "What makes Balsam Tahini different?", "answer": "<p>Balsam Tahini is stone-ground in small batches from premium sesame seeds. No added oils, no preservatives, no stabilizers. Just pure sesame — the way tahini was meant to be made.</p>" } },
        { "type": "question", "settings": { "question": "What are the ingredients?", "answer": "<p>Our tahini contains one ingredient: premium sesame seeds (100%). That's it.</p>" } },
        { "type": "question", "settings": { "question": "Is Balsam Tahini vegan and gluten-free?", "answer": "<p>Yes — 100% plant-based, vegan, and naturally gluten-free.</p>" } },
        { "type": "question", "settings": { "question": "Is it kosher and halal certified?", "answer": "<p>Yes, Balsam Tahini is both kosher and halal certified. You'll find the certification badges on our product pages.</p>" } },
        { "type": "question", "settings": { "question": "Why does the oil separate?", "answer": "<p>Because we use zero stabilizers or additives, the natural sesame oil separates to the top — this is a sign of purity, not a defect. Simply stir it back in before use.</p>" } },
        { "type": "question", "settings": { "category": "Orders & Shipping", "question": "How long does shipping take?", "answer": "<p>Orders are packed and shipped within 1–2 business days from our Mississauga, Ontario facility. Standard shipping typically takes 3–7 business days across Canada.</p>" } },
        { "type": "question", "settings": { "question": "Do you offer free shipping?", "answer": "<p>Yes — free standard shipping on all orders over $40 within Canada.</p>" } },
