{%- assign blog_handle = section.settings.blog | default: 'recipes' -%}
{%- assign recipes_blog = blogs[blog_handle] -%}
{%- assign article_limit = section.settings.articles_count | default: 6 -%}

<section class="recipes-carousel section{% if section.settings.bg == 'cream' %} section--cream{% endif %}">
  <div class="container">

    <div class="recipes-carousel__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <div class="recipes-carousel__title-row">
        <h2 class="section-title">{{ section.settings.heading | default: 'Featured Recipes' }}</h2>
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/blogs/recipes' }}" class="recipes-carousel__view-all">
            {{ section.settings.cta_label }} →
          </a>
        {%- endif -%}
      </div>
    </div>

  </div>

  <!-- Scroll track — full bleed so cards peek at edges -->
  <div class="recipes-carousel__track-wrap">
    <div class="recipes-carousel__track" id="rc-track-{{ section.id }}" role="list">

      {%- if recipes_blog != blank and recipes_blog.articles.size > 0 -%}
        {%- for article in recipes_blog.articles limit: article_limit -%}
          <a href="{{ article.url }}" class="rc-card" role="listitem">
            <div class="rc-card__img-wrap">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 560 }}"
                  srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 560 }} 560w"
                  sizes="(max-width: 639px) 80vw, 320px"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  width="560" height="374"
                  loading="lazy"
                  class="rc-card__img"
                >
              {%- else -%}
                <div class="rc-card__img-placeholder"></div>
              {%- endif -%}
              {%- if section.settings.show_tags and article.tags.size > 0 -%}
                <span class="rc-card__tag">{{ article.tags | first }}</span>
              {%- endif -%}
            </div>
            <div class="rc-card__body">
              <h3 class="rc-card__title">{{ article.title }}</h3>
              {%- if article.excerpt != blank -%}
                <p class="rc-card__excerpt">{{ article.excerpt | strip_html | truncatewords: 14 }}</p>
              {%- endif -%}
              <span class="rc-card__cta">Read recipe →</span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="rc-card rc-card--placeholder" role="listitem">
            <div class="rc-card__img-wrap"><div class="rc-card__img-placeholder"></div></div>
            <div class="rc-card__body">
              <h3 class="rc-card__title">Recipe {{ i }}</h3>
              <p class="rc-card__excerpt">A delicious tahini recipe coming soon.</p>
              <span class="rc-card__cta">Read recipe →</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}

    </div>

    <!-- Nav arrows -->
    <button class="rc-nav rc-nav--prev" id="rc-prev-{{ section.id }}" aria-label="Previous recipes" hidden>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button class="rc-nav rc-nav--next" id="rc-next-{{ section.id }}" aria-label="Next recipes">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

</section>

<style>
  .recipes-carousel__header {
    text-align: center;
    margin-bottom: var(--space-10, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }
  .recipes-carousel__title-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
    flex-wrap: wrap;
    justify-content: center;
  }
  .recipes-carousel__view-all {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--motion-fast) var(--ease-standard);
  }
  .recipes-carousel__view-all:hover { color: var(--accent-hover); }

  /* Track — horizontally scrollable */
  .recipes-carousel__track-wrap {
    position: relative;
  }
  .recipes-carousel__track {
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    /* Left aligns with container edge on all viewport widths */
    padding-inline-start: max(var(--container-gutter-desktop, 40px), calc((100vw - var(--container-max, 1200px)) / 2 + var(--container-gutter-desktop, 40px)));
    padding-inline-end: var(--container-gutter-desktop, 40px);
    padding-bottom: var(--space-4);
    cursor: grab;
  }
  .recipes-carousel__track::-webkit-scrollbar { display: none; }
  .recipes-carousel__track:active { cursor: grabbing; }

  /* Card */
  .rc-card {
    display: flex;
    flex-direction: column;
    flex: 0 0 300px;
    scroll-snap-align: start;
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--border);
    transition: box-shadow var(--motion-base) var(--ease-standard),
                transform var(--motion-base) var(--ease-standard);
  }
  .rc-card:hover {
    box-shadow: var(--elev-raised);
    transform: translateY(-4px);
  }
  .rc-card__img-wrap {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--surface-warm);
    flex-shrink: 0;
  }
  .rc-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--motion-base) var(--ease-standard);
  }
  .rc-card:hover .rc-card__img { transform: scale(1.05); }
  .rc-card__img-placeholder {
    width: 100%;
    height: 100%;
    background: var(--surface-warm);
  }
  .rc-card__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--accent);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }
  .rc-card__body {
    padding: var(--space-5) var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }
  .rc-card__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--fg);
    line-height: 1.3;
  }
  .rc-card:hover .rc-card__title { color: var(--accent); }
  .rc-card__excerpt {
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.55;
    flex: 1;
  }
  .rc-card__cta {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent);
    margin-top: var(--space-2);
  }

  /* Nav arrows */
  .rc-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--fg-2);
    box-shadow: 0 2px 8px rgba(0,0,0,0.10);
    transition: background var(--motion-fast) var(--ease-standard),
                color var(--motion-fast) var(--ease-standard),
                box-shadow var(--motion-fast) var(--ease-standard);
    z-index: 2;
  }
  .rc-nav:hover { background: var(--accent); color: #fff; border-color: var(--accent); box-shadow: var(--elev-raised); }
  .rc-nav[hidden] { display: none; }
  .rc-nav--prev { left: 8px; }
  .rc-nav--next { right: 8px; }

  @media (max-width: 1023px) {
    .recipes-carousel__track {
      padding-inline-start: var(--container-gutter-tablet, 24px);
      padding-inline-end: var(--container-gutter-tablet, 24px);
    }
    .rc-card { flex: 0 0 280px; }
  }
  @media (max-width: 639px) {
    .recipes-carousel__track {
      padding-inline-start: var(--container-gutter-phone, 16px);
      padding-inline-end: var(--container-gutter-phone, 16px);
      gap: var(--space-4);
    }
    .rc-card { flex: 0 0 260px; }
    .rc-nav { display: none; }
  }
</style>

<script>
(function () {
  var track = document.getElementById('rc-track-{{ section.id }}');
  var prevBtn = document.getElementById('rc-prev-{{ section.id }}');
  var nextBtn = document.getElementById('rc-next-{{ section.id }}');
  if (!track || !prevBtn || !nextBtn) return;

  var SCROLL_AMOUNT = 320;

  function updateArrows() {
    prevBtn.hidden = track.scrollLeft <= 8;
    nextBtn.hidden = track.scrollLeft >= track.scrollWidth - track.clientWidth - 8;
  }

  nextBtn.addEventListener('click', function () {
    track.scrollBy({ left: SCROLL_AMOUNT, behavior: 'smooth' });
  });
  prevBtn.addEventListener('click', function () {
    track.scrollBy({ left: -SCROLL_AMOUNT, behavior: 'smooth' });
  });
  track.addEventListener('scroll', updateArrows, { passive: true });
  updateArrows();

  /* Drag-to-scroll */
  var isDragging = false, startX, scrollStart;
  track.addEventListener('mousedown', function (e) {
    isDragging = true;
    startX = e.pageX;
    scrollStart = track.scrollLeft;
  });
  window.addEventListener('mousemove', function (e) {
    if (!isDragging) return;
    track.scrollLeft = scrollStart - (e.pageX - startX);
  });
  window.addEventListener('mouseup', function () { isDragging = false; });
})();
</script>

{% schema %}
{
  "name": "Recipes carousel",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Recipes blog"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "FROM OUR KITCHEN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Recipes"
    },
    {
      "type": "range",
      "id": "articles_count",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 6,
      "label": "Number of recipes"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show article tags",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "View all button label",
      "default": "View all recipes"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "View all button URL"
    },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "canvas", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "cream"
    }
  ],
  "presets": [
    {
      "name": "Recipes carousel"
    }
  ]
}
{% endschema %}
