{%- assign blog_handle = section.settings.blog | default: 'recipes' -%}
{%- assign recipes_blog = blogs[blog_handle] -%}
{%- assign article_limit = section.settings.articles_count | default: 3 -%}

<section class="recipes-section section{% if section.settings.bg == 'cream' %} section--cream{% endif %}">
  <div class="container">

    <div class="recipes-section__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.heading | default: 'Featured Recipes' }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="recipes-section__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if recipes_blog != blank and recipes_blog.articles.size > 0 -%}
      <div class="recipes-grid">
        {%- for article in recipes_blog.articles limit: article_limit -%}
          <a href="{{ article.url }}" class="recipe-card">
            <div class="recipe-card__img-wrap">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 600 }}"
                  srcset="
                    {{ article.image | image_url: width: 400 }} 400w,
                    {{ article.image | image_url: width: 600 }} 600w
                  "
                  sizes="(max-width: 767px) 100vw, 33vw"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  width="600" height="400"
                  loading="lazy"
                  class="recipe-card__img"
                >
              {%- else -%}
                <div class="recipe-card__img-placeholder">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 5v5l3 3"/>
                  </svg>
                </div>
              {%- endif -%}

              {%- if section.settings.show_tags and article.tags.size > 0 -%}
                <span class="recipe-card__tag">{{ article.tags | first }}</span>
              {%- endif -%}
            </div>

            <div class="recipe-card__body">
              <h3 class="recipe-card__title">{{ article.title }}</h3>
              {%- if article.excerpt != blank -%}
                <p class="recipe-card__excerpt">{{ article.excerpt | strip_html | truncatewords: 16 }}</p>
              {%- endif -%}
              <span class="recipe-card__cta">Read recipe →</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <!-- Placeholder cards when blog not configured -->
      <div class="recipes-grid">
        {%- for i in (1..3) -%}
          <div class="recipe-card recipe-card--placeholder">
            <div class="recipe-card__img-wrap">
              <div class="recipe-card__img-placeholder"></div>
            </div>
            <div class="recipe-card__body">
              <h3 class="recipe-card__title">Recipe {{ i }}</h3>
              <p class="recipe-card__excerpt">A delicious tahini recipe coming soon.</p>
              <span class="recipe-card__cta">Read recipe →</span>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="recipes-section__footer">
        <a href="{{ section.settings.cta_url | default: '/blogs/recipes' }}" class="btn btn-ghost">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .recipes-section__header {
    text-align: center;
    margin-bottom: var(--space-10, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3, 12px);
  }
  .recipes-section__sub {
    font-size: var(--text-lg, 1.125rem);
    color: var(--fg-2, #6B7280);
    max-width: 540px;
  }

  /* Grid */
  .recipes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6, 24px);
  }
  @media (max-width: 1199px) {
    .recipes-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 767px) {
    .recipes-grid { grid-template-columns: 1fr; gap: var(--space-5, 20px); }
  }

  /* Card */
  .recipe-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    transition: box-shadow 0.22s ease, transform 0.22s ease;
  }
  .recipe-card:hover {
    box-shadow: 0 10px 32px rgba(0,0,0,0.13);
    transform: translateY(-4px);
  }

  .recipe-card__img-wrap {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #F3F4F6;
  }
  .recipe-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .recipe-card:hover .recipe-card__img { transform: scale(1.05); }

  .recipe-card__img-placeholder {
    width: 100%;
    height: 100%;
    background: #F3F4F6;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .recipe-card__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--accent, #1B4332);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }

  .recipe-card__body {
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .recipe-card__title {
    font-family: var(--font-display, serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: #22292F;
    line-height: 1.3;
  }
  .recipe-card:hover .recipe-card__title { color: var(--accent, #1B4332); }

  .recipe-card__excerpt {
    font-size: 0.88rem;
    color: #6B7280;
    line-height: 1.5;
  }
  .recipe-card__cta {
    margin-top: auto;
    padding-top: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent, #1B4332);
    text-decoration: none;
  }

  /* Footer CTA */
  .recipes-section__footer {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10, 40px);
  }
</style>

{% schema %}
{
  "name": "Featured Recipes",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Recipes blog"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "FROM OUR KITCHEN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Recipes"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "articles_count",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Number of recipes",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show article tags",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "View all button label",
      "default": "View all recipes"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "View all button URL"
    },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "canvas", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "cream"
    }
  ],
  "presets": [
    {
      "name": "Featured Recipes"
    }
  ]
}
{% endschema %}
