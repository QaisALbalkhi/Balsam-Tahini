<section class="why-balsam section{% if section.settings.bg == 'cream' %} section--cream{% endif %}">
  <div class="container">
    <div class="why-balsam__layout">

      <!-- Left: image / media column -->
      <div class="why-balsam__media">
        {%- if section.settings.image != blank -%}
          <div class="why-balsam__img-wrap">
            <img
              src="{{ section.settings.image | image_url: width: 900 }}"
              srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 900 }} 900w"
              sizes="(max-width: 1023px) 100vw, 50vw"
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              width="900" height="1100"
              loading="lazy"
              class="why-balsam__img"
            >
          </div>
        {%- else -%}
          <div class="why-balsam__img-wrap why-balsam__img-wrap--placeholder">
            <div class="why-balsam__placeholder-inner">
              <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
                <rect x="8" y="8" width="48" height="48" rx="8" stroke="#C8D5CE" stroke-width="2"/>
                <circle cx="24" cy="26" r="6" stroke="#C8D5CE" stroke-width="2"/>
                <path d="M8 46l14-14 10 10 8-8 16 18" stroke="#C8D5CE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        {%- endif -%}
        {%- if section.settings.caption != blank -%}
          <p class="why-balsam__caption">{{ section.settings.caption }}</p>
        {%- endif -%}
      </div>

      <!-- Right: text + accordion -->
      <div class="why-balsam__content">

        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="why-balsam__heading">{{ section.settings.heading | default: 'Why Balsam Tahini?' }}</h2>
        {%- if section.settings.intro != blank -%}
          <p class="why-balsam__intro">{{ section.settings.intro }}</p>
        {%- endif -%}

        <div class="why-balsam__accordion" id="wb-accordion-{{ section.id }}">
          {%- for block in section.blocks -%}
            <div class="wb-item{% if forloop.first %} wb-item--open{% endif %}" {{ block.shopify_attributes }}>
              <button class="wb-item__trigger" type="button"
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="wb-panel-{{ block.id }}">
                <span class="wb-item__label">
                  <span class="wb-item__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  {{ block.settings.title | default: 'Step' }}
                </span>
                <span class="wb-item__icon" aria-hidden="true">
                  <svg class="wb-icon-plus" width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                  <svg class="wb-icon-minus" width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </span>
              </button>
              <div class="wb-item__panel" id="wb-panel-{{ block.id }}"
                {% unless forloop.first %}hidden{% endunless %}>
                <div class="wb-item__body">
                  {%- if block.settings.content != blank -%}
                    {{ block.settings.content }}
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
          <div class="why-balsam__cta-wrap">
            <a href="{{ section.settings.cta_url }}" class="btn btn-primary">
              {{ section.settings.cta_label }}
            </a>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

<style>
  .why-balsam__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12, 48px);
    align-items: start;
  }

  /* Media column */
  .why-balsam__img-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
  }
  .why-balsam__img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .why-balsam__img-wrap--placeholder {
    aspect-ratio: 4 / 5;
    background: var(--surface-warm);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .why-balsam__placeholder-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .why-balsam__caption {
    font-size: var(--text-xs);
    color: var(--muted);
    margin-top: var(--space-3);
    text-align: center;
    font-style: italic;
  }

  /* Content column */
  .why-balsam__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-4);
  }
  .why-balsam__heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    color: var(--fg);
  }
  .why-balsam__intro {
    font-size: var(--text-base);
    color: var(--muted);
    line-height: var(--leading-body);
    margin-top: calc(-1 * var(--space-3));
  }

  /* Accordion */
  .why-balsam__accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }
  .wb-item {
    border-bottom: 1px solid var(--border);
  }
  .wb-item__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: color var(--motion-fast) var(--ease-standard);
    color: var(--fg);
  }
  .wb-item__trigger:hover { color: var(--accent); }
  .wb-item--open .wb-item__trigger { color: var(--accent); }

  .wb-item__label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .wb-item__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.06em;
    flex-shrink: 0;
    opacity: 0.8;
  }
  .wb-item--open .wb-item__num { opacity: 1; }

  .wb-item__icon {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--border-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--motion-fast) var(--ease-standard),
                color var(--motion-fast) var(--ease-standard);
    color: var(--fg-2);
  }
  .wb-item__trigger:hover .wb-item__icon,
  .wb-item--open .wb-item__icon {
    background: var(--accent);
    color: #fff;
  }

  .wb-icon-plus, .wb-icon-minus { position: absolute; transition: opacity var(--motion-fast); }
  .wb-item__icon { position: relative; }
  .wb-item--open .wb-icon-plus { opacity: 0; }
  .wb-item:not(.wb-item--open) .wb-icon-minus { opacity: 0; }

  .wb-item__panel {
    overflow: hidden;
  }
  .wb-item__panel[hidden] { display: none; }
  .wb-item__body {
    padding-bottom: var(--space-5);
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.7;
  }
  .wb-item__body p { margin: 0 0 var(--space-2); }
  .wb-item__body p:last-child { margin-bottom: 0; }

  /* CTA */
  .why-balsam__cta-wrap { margin-top: var(--space-4); }

  /* Responsive */
  @media (max-width: 1023px) {
    .why-balsam__layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .why-balsam__img-wrap { max-height: 420px; overflow: hidden; }
    .why-balsam__img { height: 100%; width: 100%; object-fit: cover; }
    .why-balsam__img-wrap--placeholder { aspect-ratio: 16/9; }
    .why-balsam__content { padding-top: 0; }
  }
</style>

<script>
(function () {
  var accordion = document.getElementById('wb-accordion-{{ section.id }}');
  if (!accordion) return;

  accordion.querySelectorAll('.wb-item__trigger').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var item = btn.closest('.wb-item');
      var panel = document.getElementById(btn.getAttribute('aria-controls'));
      var isOpen = item.classList.contains('wb-item--open');

      /* Close all */
      accordion.querySelectorAll('.wb-item').forEach(function (el) {
        el.classList.remove('wb-item--open');
        el.querySelector('.wb-item__trigger').setAttribute('aria-expanded', 'false');
        el.querySelector('.wb-item__panel').hidden = true;
      });

      /* Open clicked if it was closed */
      if (!isOpen) {
        item.classList.add('wb-item--open');
        btn.setAttribute('aria-expanded', 'true');
        panel.hidden = false;
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "Why Balsam",
  "max_blocks": 8,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Balsam Tahini?"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "canvas", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Accordion item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Sesame Seeds"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>We source only the finest sesame seeds, selecting for purity, flavour, and oil content. Every batch is inspected before it ever reaches our stone mills.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Balsam",
      "blocks": [
        {
          "type": "accordion_item",
          "settings": {
            "title": "Premium Sesame Seeds",
            "content": "<p>We source only the finest sesame seeds, carefully selected for their purity, rich flavour, and high oil content. Every batch is hand-inspected before grinding.</p>"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "Traditional Stone-Grinding",
            "content": "<p>Our tahini is slowly stone-ground the traditional way — cool temperatures preserve natural oils and nutrients, delivering a depth of flavour that machine processing can't match.</p>"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "Small Batch Production",
            "content": "<p>We produce in small batches to guarantee freshness and consistency. Every jar receives our full attention — quality over volume, every single time.</p>"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "Zero Additives, Ever",
            "content": "<p>Just pure sesame seeds. No added oils, no preservatives, no stabilizers. What you see on the label is exactly what's in the jar — nothing more, nothing less.</p>"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "Shipped Fresh to Your Door",
            "content": "<p>Every order is packed and shipped within days of production from our Mississauga facility. You receive tahini at its freshest — never sitting in a warehouse for months.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
