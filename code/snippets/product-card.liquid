{% comment %}
  Renders a product card.
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

{%- assign second_image = product.images[1] -%}

<article class="product-card" aria-label="{{ product.title | escape }}">

  <!-- ── Image ──────────────────────────────────────────── -->
  <a href="{{ product.url }}" class="product-card__image-link" tabindex="-1" aria-hidden="true">
    <div class="product-card__image-wrap">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          srcset="
            {{ product.featured_image | image_url: width: 300 }} 300w,
            {{ product.featured_image | image_url: width: 600 }} 600w
          "
          sizes="(max-width: 767px) 50vw, 25vw"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="600" height="600"
          loading="lazy"
          class="product-card__img"
        >
        {%- if second_image -%}
          <img
            src="{{ second_image | image_url: width: 600 }}"
            alt="{{ second_image.alt | default: product.title | escape }}"
            width="600" height="600"
            loading="lazy"
            class="product-card__img product-card__img--hover"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
      {%- endif -%}

      <!-- Wishlist -->
      <button
        class="product-card__wishlist"
        type="button"
        aria-label="Add to wishlist"
        aria-pressed="false"
        data-product-id="{{ product.id }}"
        data-product-handle="{{ product.handle }}"
        data-product-title="{{ product.title | escape }}"
        data-product-price="{{ product.price_min }}"
        data-product-image="{{ product.featured_image | image_url: width: 400 }}"
        data-product-url="{{ product.url }}"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
            stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </a>

  <!-- ── Body ───────────────────────────────────────────── -->
  <div class="product-card__body">

    <a href="{{ product.url }}" class="product-card__name">{{ product.title }}</a>

    {%- if product.tags contains 'bestseller' or product.tags contains 'best-seller' or product.tags contains 'Best Seller' -%}
      <span class="pc-badge pc-badge--bestseller">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        BEST SELLER
      </span>
    {%- elsif product.compare_at_price > product.price -%}
      {%- assign savings_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round -%}
      <span class="pc-badge pc-badge--sale">Save {{ savings_pct }}%</span>
    {%- endif -%}

    {%- if product.metafields.reviews.rating_count -%}
      <div class="product-card__rating" aria-label="{{ product.metafields.reviews.rating_value }} out of 5 stars">
        <span class="pc-stars" aria-hidden="true">★★★★★</span>
        <span class="pc-rating-val">{{ product.metafields.reviews.rating_value }}</span>
        <span class="pc-rating-count">({{ product.metafields.reviews.rating_count }} reviews)</span>
      </div>
    {%- endif -%}

    {%- if product.description != blank -%}
      <p class="product-card__desc">{{ product.description | strip_html | truncatewords: 14 }}</p>
    {%- endif -%}

    <!-- Quick-add — pinned to bottom via margin-top: auto -->
    <div class="pc-add">
      <script type="application/json" class="pc-variants-json">[{%- for v in product.variants -%}{"id":{{ v.id }},"title":"{{ v.title | escape }}","price":{{ v.price }},"compare_at_price":{{ v.compare_at_price | default: 'null' }},"available":{{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>

      <button
        class="pc-add-btn{% if product.variants.size == 1 %} pc-add-btn--single{% endif %}"
        type="button"
        aria-expanded="false"
        data-default-price="{{ product.price_min | money }}"
      >
        <span class="pc-add-btn__inner">
          <span class="pc-add-btn__verb">ADD</span>
          <span class="pc-add-btn__sep" aria-hidden="true"> — </span>
          <span class="pc-add-btn__price">{{ product.price_min | money }}</span>
        </span>
        {%- if product.variants.size > 1 -%}
          <span class="pc-add-btn__chevron" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </span>
        {%- endif -%}
      </button>

      <div class="pc-variant-panel" hidden></div>
    </div>

  </div>
</article>

<style>
  /* ── Card shell ─────────────────────────────────────── */
  .product-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.07);
    transition: box-shadow 0.22s ease, transform 0.22s ease;
  }
  .product-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,0.13);
    transform: translateY(-3px);
  }

  /* ── Image ──────────────────────────────────────────── */
  .product-card__image-link { display: block; }
  .product-card__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #F5F5F3;
  }
  .product-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.42s ease;
  }
  .product-card__img--hover { opacity: 0; }
  .product-card__image-wrap:hover .product-card__img--hover { opacity: 1; }
  .product-card__placeholder { width: 100%; height: 100%; }

  /* ── Wishlist ───────────────────────────────────────── */
  .product-card__wishlist {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1.5px solid rgba(0,0,0,0.10);
    border-radius: 50%;
    color: #9CA3AF;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0,0,0,0.10);
    transition: color 0.22s ease, border-color 0.22s ease,
                background 0.22s ease, transform 0.22s ease;
  }
  .product-card__wishlist svg path {
    transition: fill 0.22s ease, stroke 0.22s ease;
  }
  .product-card__wishlist:hover {
    color: #1B4332;
    border-color: rgba(27,67,50,0.35);
    transform: scale(1.1);
  }
  .product-card__wishlist--active {
    color: #1B4332;
    border-color: #1B4332;
    background: rgba(27,67,50,0.07);
  }
  .product-card__wishlist--active svg path {
    fill: #1B4332;
    stroke: #1B4332;
  }

  /* Pop + bloom ring */
  @keyframes wl-pop {
    0%   { transform: scale(1); }
    30%  { transform: scale(1.32); }
    65%  { transform: scale(0.88); }
    100% { transform: scale(1); }
  }
  @keyframes wl-bloom {
    from { box-shadow: 0 0 0 0   rgba(27,67,50,0.40), 0 1px 4px rgba(0,0,0,0.10); }
    to   { box-shadow: 0 0 0 12px rgba(27,67,50,0),   0 1px 4px rgba(0,0,0,0.10); }
  }
  .product-card__wishlist.wl-animating {
    animation:
      wl-pop   0.42s cubic-bezier(0.36, 0.07, 0.19, 0.97) forwards,
      wl-bloom 0.5s ease-out forwards;
  }

  /* ── Body — flex column, ADD always at bottom ───────── */
  .product-card__body {
    padding: 16px 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;           /* stretch to fill card height */
  }

  /* Name */
  .product-card__name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #22292F;
    line-height: 1.3;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .product-card__name:hover { color: #1B4332; }

  /* Badges */
  .pc-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 13px;
    border-radius: 999px;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    align-self: flex-start;
  }
  .pc-badge--bestseller { background: #1B2B3A; color: #ffffff; }
  .pc-badge--sale       { background: #F59E0B; color: #ffffff; }

  /* Rating */
  .product-card__rating { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }
  .pc-stars        { color: #F59E0B; font-size: 0.95rem; letter-spacing: 1px; }
  .pc-rating-val   { font-size: 0.88rem; font-weight: 700; color: #374151; }
  .pc-rating-count { font-size: 0.82rem; color: #6B7280; }

  /* Description */
  .product-card__desc {
    font-size: 0.875rem;
    color: #6B7280;
    line-height: 1.5;
    margin: 0;
  }

  /* ── ADD wrapper — pushes button to card bottom ─────── */
  .pc-add { margin-top: auto; padding-top: 12px; }

  /* ── ADD button ─────────────────────────────────────── */
  .pc-add-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 20px;
    border: 2px solid #1B4332;
    border-radius: 999px;
    background: transparent;
    color: #1B4332;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .pc-add-btn:hover { background: #1B4332; color: #ffffff; }

  /* Single-variant: no chevron, so centre the text */
  .pc-add-btn--single { justify-content: center; }
  .pc-add-btn--single .pc-add-btn__inner { justify-content: center; }

  /* Inner text row */
  .pc-add-btn__inner {
    display: flex;
    align-items: center;
    gap: 0;
  }
  .pc-add-btn__verb  { white-space: nowrap; }
  .pc-add-btn__sep   { opacity: 0.7; }
  .pc-add-btn__price { white-space: nowrap; }

  /* Chevron */
  .pc-add-btn__chevron {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .pc-add-btn[aria-expanded="true"] .pc-add-btn__chevron { transform: rotate(180deg); }

  /* ATC state — two-line layout so long prices never overflow */
  .pc-add-btn--atc {
    background: #1B4332;
    color: #ffffff;
    justify-content: center;
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .pc-add-btn--atc .pc-add-btn__inner {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
  }
  .pc-add-btn--atc .pc-add-btn__sep   { display: none; }
  .pc-add-btn--atc .pc-add-btn__verb  { font-size: 0.68rem; letter-spacing: 0.12em; }
  .pc-add-btn--atc .pc-add-btn__price { font-size: 1rem; font-weight: 900; letter-spacing: 0; }
  .pc-add-btn--atc .pc-add-btn__chevron { display: none; }

  /* During Adding… / ✓ Added! — hide " — $X.XX" */
  .pc-add-btn--busy .pc-add-btn__sep,
  .pc-add-btn--busy .pc-add-btn__price,
  .pc-add-btn--added .pc-add-btn__sep,
  .pc-add-btn--added .pc-add-btn__price { display: none; }

  .pc-add-btn--added {
    background: #166534;
    color: #ffffff;
    border-color: #166534;
    pointer-events: none;
    justify-content: center;
  }
  .pc-add-btn--added .pc-add-btn__inner { justify-content: center; }
  .pc-add-btn--added .pc-add-btn__chevron { display: none; }

  /* ── Variant panel ──────────────────────────────────── */
  .pc-variant-panel {
    margin-top: 8px;
    border: 1.5px solid #E5E7EB;
    border-radius: 10px;
    overflow: hidden;
  }
  .pc-var-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 16px;
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #F3F4F6;
    cursor: pointer;
    transition: background 0.15s ease;
    text-align: left;
  }
  .pc-var-btn:last-child { border-bottom: none; }
  .pc-var-btn:hover:not(:disabled) { background: #F0F5F2; }
  .pc-var-btn:disabled { opacity: 0.40; cursor: not-allowed; }
  .pc-var-title     { font-size: 0.875rem; font-weight: 600; color: #374151; }
  .pc-var-price     { font-size: 0.875rem; font-weight: 700; color: #1B4332; }
  .pc-var-price-was { font-size: 0.78rem; color: #9CA3AF; text-decoration: line-through; margin-right: 4px; }
  .pc-var-oos {
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9CA3AF;
    background: #F3F4F6;
    padding: 3px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .pc-var-btn:disabled { opacity: 1; cursor: not-allowed; }
  .pc-var-btn:disabled .pc-var-title { color: #9CA3AF; }
</style>

<script>
(function () {
  if (window.__balsamCardInit) return;
  window.__balsamCardInit = true;

  function fmt(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\.00$/, '');
  }

  /* ── Wishlist (localStorage — stores {id: {id,handle,title,price,image,url}}) ── */
  var WL_KEY = 'balsam-wishlist';
  function wlGet() {
    try {
      var raw = JSON.parse(localStorage.getItem(WL_KEY) || 'null');
      if (!raw) return {};
      /* migrate old array format */
      if (Array.isArray(raw)) {
        var obj = {};
        raw.forEach(function (id) { obj[String(id)] = { id: String(id) }; });
        return obj;
      }
      return raw;
    } catch (_) { return {}; }
  }
  function wlSet(obj) { try { localStorage.setItem(WL_KEY, JSON.stringify(obj)); } catch (_) {} }
  function wlHas(id) { return !!wlGet()[String(id)]; }
  function wlToggle(btn) {
    var id = String(btn.dataset.productId);
    var obj = wlGet();
    var added;
    if (obj[id]) {
      delete obj[id];
      added = false;
    } else {
      obj[id] = {
        id:     id,
        handle: btn.dataset.productHandle || '',
        title:  btn.dataset.productTitle  || '',
        price:  parseInt(btn.dataset.productPrice, 10) || 0,
        image:  btn.dataset.productImage  || '',
        url:    btn.dataset.productUrl    || ''
      };
      added = true;
    }
    wlSet(obj);
    document.dispatchEvent(new CustomEvent('balsam:wishlist-updated'));
    return added;
  }
  function wlApplyBtn(btn) {
    var active = wlHas(btn.dataset.productId);
    btn.classList.toggle('product-card__wishlist--active', active);
    btn.setAttribute('aria-pressed', String(active));
    btn.setAttribute('aria-label', active ? 'Remove from wishlist' : 'Add to wishlist');
  }
  function wlInitAll() {
    document.querySelectorAll('.product-card__wishlist[data-product-id]').forEach(wlApplyBtn);
  }
  wlInitAll();
  document.addEventListener('balsam:grid-updated', wlInitAll);

  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.product-card__wishlist');
    if (!btn || !btn.dataset.productId) return;
    var added = wlToggle(btn);
    btn.classList.toggle('product-card__wishlist--active', added);
    btn.setAttribute('aria-pressed', String(added));
    btn.setAttribute('aria-label', added ? 'Remove from wishlist' : 'Add to wishlist');
    btn.classList.remove('wl-animating');
    void btn.offsetWidth;
    btn.classList.add('wl-animating');
    btn.addEventListener('animationend', function h() {
      btn.classList.remove('wl-animating');
      btn.removeEventListener('animationend', h);
    });
  });

  /* ── ADD button click ── */
  document.addEventListener('click', function (e) {
    var addBtn = e.target.closest('.pc-add-btn');
    if (!addBtn) return;
    e.stopPropagation();

    var pcAdd = addBtn.closest('.pc-add');
    var panel = pcAdd.querySelector('.pc-variant-panel');
    var variants;
    try { variants = JSON.parse(pcAdd.querySelector('.pc-variants-json').textContent); }
    catch (_) { return; }

    /* ATC state → submit */
    if (addBtn.dataset.state === 'atc') {
      addToCart(addBtn, addBtn.dataset.variantId);
      return;
    }

    /* Single variant → add directly */
    if (variants.length === 1) {
      addToCart(addBtn, String(variants[0].id));
      return;
    }

    /* Multi-variant → toggle panel */
    var expanded = addBtn.getAttribute('aria-expanded') === 'true';
    if (expanded) {
      panel.hidden = true;
      addBtn.setAttribute('aria-expanded', 'false');
    } else {
      panel.innerHTML = variants.map(function (v) {
        var right;
        if (v.available) {
          var cmp = (v.compare_at_price && v.compare_at_price > v.price)
            ? '<span class="pc-var-price-was">' + fmt(v.compare_at_price) + '</span>' : '';
          right = cmp + '<span class="pc-var-price">' + fmt(v.price) + '</span>';
        } else {
          right = '<span class="pc-var-oos">Out of stock</span>';
        }
        return '<button class="pc-var-btn" data-variant-id="' + v.id +
          '" data-price="' + v.price + '"' + (v.available ? '' : ' disabled') + '>' +
          '<span class="pc-var-title">' + v.title + '</span>' +
          '<span>' + right + '</span>' +
          '</button>';
      }).join('');
      panel.hidden = false;
      addBtn.setAttribute('aria-expanded', 'true');
    }
  });

  /* ── Variant row click → update button price, enter ATC state ── */
  document.addEventListener('click', function (e) {
    var vBtn = e.target.closest('.pc-var-btn');
    if (!vBtn) return;
    e.stopPropagation();

    var pcAdd  = vBtn.closest('.pc-add');
    var addBtn = pcAdd.querySelector('.pc-add-btn');
    var panel  = pcAdd.querySelector('.pc-variant-panel');
    var price  = parseInt(vBtn.dataset.price, 10);

    panel.hidden = true;
    addBtn.setAttribute('aria-expanded', 'false');
    addBtn.dataset.variantId = vBtn.dataset.variantId;
    addBtn.dataset.state     = 'atc';

    addBtn.querySelector('.pc-add-btn__verb').textContent  = 'ADD TO CART';
    addBtn.querySelector('.pc-add-btn__price').textContent = fmt(price);
    addBtn.classList.add('pc-add-btn--atc');
  });

  /* ── Click outside closes open panels ── */
  document.addEventListener('click', function (e) {
    if (e.target.closest('.pc-add')) return;
    document.querySelectorAll('.pc-variant-panel:not([hidden])').forEach(function (p) {
      p.hidden = true;
      var b = p.closest('.pc-add').querySelector('.pc-add-btn');
      if (b) b.setAttribute('aria-expanded', 'false');
    });
  });

  /* ── Cart API ── */
  function addToCart(btn, variantId) {
    var verb  = btn.querySelector('.pc-add-btn__verb');
    btn.classList.add('pc-add-btn--atc', 'pc-add-btn--busy');
    btn.disabled = true;
    verb.textContent = 'Adding…';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: parseInt(variantId, 10), quantity: 1 })
    })
    .then(function (r) {
      if (!r.ok) return r.json().then(function (d) { throw new Error(d.description || 'Error'); });
      return r.json();
    })
    .then(function () {
      btn.classList.remove('pc-add-btn--busy', 'pc-add-btn--atc');
      btn.classList.add('pc-add-btn--added');
      verb.textContent = '✓ Added!';
      refreshCartCount();
      setTimeout(reset.bind(null, btn), 2200);
    })
    .catch(function () {
      btn.classList.remove('pc-add-btn--busy', 'pc-add-btn--atc');
      btn.disabled = false;
      verb.textContent = 'Try again';
      setTimeout(reset.bind(null, btn), 2500);
    });
  }

  function reset(btn) {
    btn.disabled = false;
    btn.classList.remove('pc-add-btn--added', 'pc-add-btn--atc', 'pc-add-btn--busy');
    btn.dataset.state     = '';
    btn.dataset.variantId = '';
    btn.querySelector('.pc-add-btn__verb').textContent  = 'ADD';
    btn.querySelector('.pc-add-btn__price').textContent = btn.dataset.defaultPrice;
    btn.setAttribute('aria-expanded', 'false');
  }

  function refreshCartCount() {
    fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (c) {
        document.querySelectorAll('[data-cart-count]').forEach(function (el) {
          el.textContent = c.item_count;
        });
      });
  }
})();
</script>
